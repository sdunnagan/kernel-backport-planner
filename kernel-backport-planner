def package_results(prefix_arg: str) -> tuple[Path, Path]:
    """Package completed dual reports and the planner's closed internal log.

    Refuse to overwrite existing output directories or archives. Legacy
    post-run packaging is also supported for already completed tee logs.
    """
    raw = Path(prefix_arg).expanduser().absolute()
    prefix = raw.with_suffix("") if raw.suffix in {".c", ".json", ".log"} else raw
    destination = prefix
    archive = prefix.with_suffix(".zip")
    for path in (destination, archive):
        if os.path.lexists(path):
            raise ValueError(f"package destination already exists: {path}")
    sources = [prefix.with_suffix(ext) for ext in (".c", ".json", ".log")]
    sources += [path for ext in (".perf.json", ".perf.jsonl")
                if (path := prefix.with_suffix(ext)).is_file()]
    for source in sources:
        if not source.is_file():
            raise ValueError(f"required completed output is missing: {source}")
    try:
        payload = json.loads(prefix.with_suffix(".json").read_text())
    except (OSError, ValueError) as exc:
        raise ValueError(f"cannot read plan JSON for packaging: {exc}") from exc
    advisor = payload.get("advisor")
    if isinstance(advisor, dict):
        for field in ("cache_path", "error_log_path", "trace_path"):
            value = advisor.get(field)
            if not isinstance(value, str) or not value:
                continue
            candidate = Path(value).expanduser()
            if candidate.is_file() and candidate not in sources:
                sources.append(candidate)
    # Avoid silently flattening distinct paths with identical file names.
    names = [source.name for source in sources]
    if len(names) != len(set(names)):
        raise ValueError("packaging source filenames collide; inspect advisor paths")
    if not destination.parent.is_dir():
        raise ValueError(f"package parent directory does not exist: {destination.parent}")
    with tempfile.TemporaryDirectory(prefix=".planner-package-",
                                     dir=destination.parent) as temp:
        staging = Path(temp) / destination.name
        staging.mkdir()
        for source in sources:
            shutil.copy2(source, staging / source.name)
        temp_zip = Path(temp) / archive.name
        with zipfile.ZipFile(temp_zip, "w", zipfile.ZIP_DEFLATED) as output:
            for child in sorted(staging.iterdir()):
                output.write(child, arcname=f"{destination.name}/{child.name}")
        # Atomic no-overwrite publication; packaging should never damage
        # existing run artifacts, even if another process races this command.
        if os.path.lexists(destination) or os.path.lexists(archive):
            raise ValueError("package destination appeared during packaging")
        os.rename(staging, destination)
        try:
            os.link(temp_zip, archive)
        except OSError:
            shutil.rmtree(destination)
            raise
    return destination, archive


class TeeOutput:
    """Write Python progress to the terminal and the planner-owned log."""

    def __init__(self, terminal, log):
        self.terminal = terminal
        self.log = log

    def write(self, data: str) -> int:
        self.terminal.write(data)
        self.log.write(data)
        return len(data)

    def flush(self) -> None:
        self.terminal.flush()
        self.log.flush()

    def isatty(self) -> bool:
        return self.terminal.isatty()


def auto_package_prefix(args: argparse.Namespace) -> Path | None:
    """Choose the package name for standard dual-output text/JSON runs.

    All other previously supported output formats remain unchanged. Using
    different text/JSON basenames is almost always a typo, and would make
    the packaged reports ambiguous, so reject that combination early.
    """
    if (not args.auto_package or not args.output or not args.json_output
            or args.format != "text"):
        return None
    text_path = Path(args.output).expanduser().absolute()
    json_path = Path(args.json_output).expanduser().absolute()
    if text_path.suffix != ".c" or json_path.suffix != ".json":
        return None
    if text_path.with_suffix("") != json_path.with_suffix(""):
        raise ValueError(
            "automatic packaging requires matching text/JSON basenames; "
            "use --no-auto-package for independent output paths"
        )
    return text_path.with_suffix("")


def ensure_package_destinations_available(prefix: Path) -> None:
    """Fail before a costly planner run if its package would be overwritten."""
    for path in (prefix, prefix.with_suffix(".zip"), prefix.with_suffix(".log"),
                 prefix.with_suffix(".c"), prefix.with_suffix(".json"),
                 prefix.with_suffix(".perf.json"), prefix.with_suffix(".perf.jsonl")):
        if os.path.lexists(path):
            raise ValueError(f"automatic package output already exists: {path}")
    if not prefix.parent.is_dir():
        raise ValueError(f"output directory does not exist: {prefix.parent}")


def run_exact_trace_replay(args: argparse.Namespace) -> int:
    """Replay captured advisor payloads byte-for-byte at the prompt/schema level.

    No Git calls and no packet reconstruction. Model execution need not be
    bit-deterministic, and this does not perform planner graph validation.
    """
    source = Path(args.advisor_replay_trace).expanduser()
    destination = Path(args.benchmark_output).expanduser()
    if os.path.lexists(destination):
        print(f"replay output already exists: {destination}", file=sys.stderr)
        return 1
    try:
        records = [json.loads(line) for line in source.read_text().splitlines()
                   if line.strip()]
        if not records or any(r.get("trace_format") !=
                              "exact-advisor-request-v1" for r in records):
            raise ValueError("empty or unsupported advisor trace")
        selected = []
        for record in records:
            sha = record["sha"]
            if args.advisor_commit and not any(
                    sha.startswith(value.lower()) for value in args.advisor_commit):
                continue
            for field in ("system_prompt", "packet", "response_schema"):
                if field not in record:
                    raise ValueError("trace entry is missing " + field)
            selected.append(record)
        if args.advisor_commit:
            for name in args.advisor_commit:
                if len({r["sha"] for r in selected
                        if r["sha"].startswith(name.lower())}) != 1:
                    raise ValueError("unknown or ambiguous commit " + name)
        if args.advisor_limit:
            selected = selected[:args.advisor_limit]
        if not selected:
            raise ValueError("no matching advisor requests")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(f"invalid exact advisor trace: {exc}", file=sys.stderr)
        return 1
    client = OllamaAdvisor(args.advisor_model, args.advisor_base_url,
                           args.advisor_timeout, args.advisor_temperature,
                           args.advisor_keep_alive, args.debug)
    errors = 0
    with destination.open("x", encoding="utf-8", buffering=1) as output:
        for record in selected:
            start = time.perf_counter()
            entry = {"sha": record["sha"], "attempt": record.get("attempt"),
                     "replay_type": "exact-saved-prompt-packet-schema",
                     "source_prompt_version": record.get("prompt_version"),
                     "original_response": record.get("response"),
                     "model": args.advisor_model}
            try:
                result = client.advise(record["system_prompt"],
                                       record["packet"], record["response_schema"])
                entry.update(status="ok", response=result,
                             decision=result.get("decision"),
                             matches_original=result == record.get("response"),
                             ollama=getattr(client, "last_telemetry", None))
            except (AdvisorError, OSError, ValueError) as exc:
                errors += 1
                entry.update(status="error", error=str(exc))
            entry["elapsed_seconds"] = round(time.perf_counter() - start, 3)
            output.write(json.dumps(entry, sort_keys=True) + "\n")
    print(f"Exact replay saved: {destination}; requests={len(selected)}, "
          f"errors={errors}. Does not validate the complete dependency graph.")
    return 2 if errors else 0


def run_advisor_benchmark(args: argparse.Namespace) -> int:
    """Run small model checks from a saved plan, without planner collection.

    Reconstructed packets include the saved provenance plus a fresh local Git
    excerpt for each SHA. They are NOT exact replay of the original prompts;
    this tests transport/JSON/speed and flags decisions worth reviewing.
    """
    plan_path = Path(args.advisor_benchmark_plan).expanduser().resolve()
    destination = Path(args.benchmark_output).expanduser().absolute()
    if os.path.lexists(destination):
        print(f"benchmark output already exists: {destination}", file=sys.stderr)
        return 1
    try:
        plan = json.loads(plan_path.read_text())
        commits = plan["commits"]
        ordered = [sha for sha in plan["order"] if sha in commits]
        if not isinstance(commits, dict) or not ordered:
            raise ValueError("missing commit records or order")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(f"cannot load benchmark plan: {exc}", file=sys.stderr)
        return 1
    reference_commits = {}
    if args.benchmark_reference_plan:
        try:
            reference = json.loads(Path(args.benchmark_reference_plan).expanduser().read_text())
            if (reference.get("downstream") != plan.get("downstream") or
                    reference.get("target") != plan.get("target")):
                raise ValueError("benchmark reference baseline/target differs")
            reference_commits = reference["commits"]
        except (OSError, ValueError, KeyError, TypeError) as exc:
            print(f"cannot load benchmark reference plan: {exc}", file=sys.stderr)
            return 1
    if args.advisor_commit:
        selected = []
        for name in args.advisor_commit:
            matches = [sha for sha in ordered if sha.startswith(name.lower())]
            if len(matches) != 1:
                print(f"benchmark commit {name}: expected one match, got {len(matches)}",
                      file=sys.stderr)
                return 1
            if matches[0] not in selected:
                selected.append(matches[0])
    else:
        # With a reference plan, prioritize disagreement cases without a
        # multi-hour repository collection; otherwise use the old smoke test.
        disagreements = [sha for sha in ordered if sha in reference_commits and
            commits[sha].get("advisor_decision") !=
            reference_commits[sha].get("advisor_decision")]
        interesting = [sha for sha in ordered if
                       commits[sha].get("advisor_prerequisites") or
                       commits[sha].get("advisor_decision") != "TAKE"]
        selected = list(dict.fromkeys([*disagreements, *interesting, *ordered]))
    selected = selected[:args.advisor_limit or 10]
    git = Git(Path(args.repo).resolve(), args.debug)
    client = OllamaAdvisor(args.advisor_model, args.advisor_base_url,
                           args.advisor_timeout, args.advisor_temperature,
                           args.advisor_keep_alive, args.debug)
    # Same advisor policy prompt, but reduced context; never claim equivalence.
    prompt = Planner.advisor_system_prompt(None)
    errors = 0
    with destination.open("x", encoding="utf-8", buffering=1) as output:
        for i, sha in enumerate(selected, 1):
            record = commits[sha]
            before = time.perf_counter()
            entry = {"sha": sha, "subject": record.get("subject"),
                     "baseline_decision": record.get("advisor_decision"),
                     "reference_decision": (
                         reference_commits[sha].get("advisor_decision")
                         if sha in reference_commits else None),
                     "benchmark_packet": "reconstructed-from-JSON-and-local-Git",
                     "model": args.advisor_model}
            try:
                message = git.run(["show", "-s", "--format=%B", sha])
                patch = git.run(["show", "--format=", "--no-ext-diff", sha])
                evidence = record.get("advisor_prerequisite_evidence") or []
                inbound = record.get("advisor_recommended_by") or []
                if not isinstance(evidence, list) or not isinstance(inbound, list):
                    raise ValueError("invalid evidence collection in saved plan")
                packet = {
                    "planning_context": {
                        "base": plan.get("base"), "target": plan.get("target"),
                        "downstream": plan.get("downstream"),
                        "focus_paths": plan.get("paths", []),
                        "product": {"product": "rhel10"},
                        "policy": "Follow planner evidence and use REVIEW when unclear",
                    },
                    "commit": {
                        "sha": sha, "subject": record.get("subject"),
                        "message": message[:args.advisor_max_message_chars],
                        "patch_excerpt": patch[:args.advisor_max_diff_chars],
                        "changed_files": record.get("files", []),
                        "direct": record.get("direct", False),
                        "dependency_kind": record.get("dependency_kind"),
                        "evidence": record.get("evidence", []),
                        "replay": record.get("replay"),
                        "conflict_files": record.get("conflict_files", []),
                        "eligible_prerequisite_evidence": evidence,
                        "same_series_consumed_objects": evidence,
                        "actual_inbound_take_prerequisites": inbound,
                        "actual_inbound_take_prerequisite_count": len(inbound),
                        "default_policy_bias": (
                            "TAKE_UNLESS_CONCRETE_EXCLUSION" if record.get("direct")
                            else "NEUTRAL"),
                    },
                }
                schema = advisor_response_schema(evidence, inbound)
                # Leave a little room for one bounded policy-correction prompt.
                cap = (max(1, args.advisor_max_request_chars - 600)
                       if args.advisor_max_request_chars else 0)
                packet, budget = budget_advisor_packet(
                    packet, prompt, schema, cap)
                entry["request_chars"] = budget["final_chars"]
                entry["optional_excerpts_omitted"] = budget["omitted"]
                result = client.advise(prompt, packet, schema)
                entry["policy_recheck"] = False
                if policy_only_review_objection(result):
                    entry["policy_recheck"] = True
                    result = client.advise(policy_retry_prompt(prompt), packet, schema)
                    if policy_only_review_objection(result):
                        raise AdvisorError(
                            "model still recommends REVIEW solely for absent product "
                            "support after corrective retry", kind="policy-review",
                            retryable=False)
                used = (client.last_telemetry or {}).get("prompt_eval_count")
                if (args.advisor_context_tokens and isinstance(used, int) and
                        used >= args.advisor_context_tokens - args.advisor_output_reserve):
                    raise AdvisorError("Ollama prompt token count near context limit; "
                                       "possible truncation", kind="context-limit",
                                       retryable=False)
                decision = result.get("decision")
                ids = result.get("prerequisite_evidence_ids")
                assessments = result.get("inbound_prerequisite_assessments")
                risks = result.get("risks")
                if (decision not in ("TAKE", "SKIP", "REVIEW") or
                    not isinstance(result.get("rationale"), str) or
                    not result["rationale"].strip() or
                    not isinstance(ids, list) or not isinstance(assessments, list) or
                    not isinstance(risks, list) or not all(isinstance(x, str) for x in risks)):
                    raise AdvisorError("invalid benchmark structured fields",
                                       kind="invalid-response", retryable=False)
                allowed_ids = {e["evidence_id"] for e in evidence}
                if len(ids) != len(set(ids)) or not set(ids) <= allowed_ids:
                    raise AdvisorError("invalid prerequisite evidence IDs",
                                       kind="invalid-prerequisite", retryable=False)
                binding_ids = {e["evidence_id"] for e in evidence
                               if e.get("kind") in ("compatible-binding",
                                                    "dt-property-binding")}
                binding_assessments = result.get("binding_evidence_assessments", [])
                if not isinstance(binding_assessments, list):
                    raise AdvisorError("invalid binding assessments",
                                       kind="invalid-response", retryable=False)
                disposition_by_id = {}
                for assessment in binding_assessments:
                    if (not isinstance(assessment, dict)
                            or assessment.get("evidence_id") not in binding_ids
                            or assessment["evidence_id"] in disposition_by_id
                            or assessment.get("disposition") not in ("REQUIRED", "NOT_REQUIRED")
                            or not isinstance(assessment.get("reason"), str)
                            or not assessment["reason"].strip()):
                        raise AdvisorError("invalid binding evidence assessment",
                                           kind="binding-unassessed", retryable=False)
                    disposition_by_id[assessment["evidence_id"]] = assessment["disposition"]
                if decision == "TAKE":
                    if (set(disposition_by_id) != binding_ids
                            or any((i in ids) != (v == "REQUIRED")
                                   for i, v in disposition_by_id.items())):
                        raise AdvisorError("unassessed or contradictory binding evidence",
                                           kind="binding-unassessed", retryable=False)
                entry["binding_evidence_assessments"] = binding_assessments
                inbound_ids = {e["evidence_id"] for e in inbound}
                returned_ids = [x.get("evidence_id") for x in assessments
                                if isinstance(x, dict)]
                if (len(returned_ids) != len(assessments) or
                    len(returned_ids) != len(set(returned_ids)) or
                    set(returned_ids) != inbound_ids or
                    any(x.get("disposition") not in ("REQUIRED", "NOT_REQUIRED")
                        or not isinstance(x.get("reason"), str) or
                        not x["reason"].strip() for x in assessments) or
                    (decision == "SKIP" and any(x["disposition"] == "REQUIRED"
                                                 for x in assessments))):
                    raise AdvisorError("invalid inbound prerequisite assessments",
                                       kind="invalid-response", retryable=False)
                selected_peers = {e["peer_sha"] for e in evidence
                                  if e["evidence_id"] in ids}
                reference_peers = {e["sha"] for e in
                                   record.get("advisor_prerequisites", [])}
                entry.update(status="ok", decision=decision,
                             agrees_with_baseline=decision == entry["baseline_decision"],
                             agrees_with_reference=(
                                 decision == entry["reference_decision"]
                                 if entry["reference_decision"] is not None else None),
                             selected_prerequisite_peers=sorted(selected_peers),
                             reference_prerequisite_peers=sorted(reference_peers),
                             prerequisite_peers_agree=selected_peers == reference_peers,
                             rationale=result["rationale"], risks=risks,
                             ollama=getattr(client, "last_telemetry", None))
            except (GitError, AdvisorError, OSError, ValueError, KeyError) as exc:
                errors += 1
                entry.update(status="error", error=str(exc))
            entry["elapsed_seconds"] = round(time.perf_counter() - before, 3)
            output.write(json.dumps(entry, sort_keys=True) + "\n")
            output.flush()
            os.fsync(output.fileno())
            print(f"  benchmark {i}/{len(selected)}: {sha[:12]} "
                  f"{entry['status']} {entry.get('decision', '')} "
                  f"{entry['elapsed_seconds']:.1f}s")
    print(f"Benchmark saved: {destination}; errors={errors}; "
          "reconstructed evidence is NOT a full planner validation")
    return 2 if errors else 0



def run_planner(args: argparse.Namespace) -> int:
    if getattr(args, "advisor_fallback_model", None):
        verify_advisor_fallback_model(args.advisor_base_url,
                                      args.advisor_fallback_model)
    # The append-only event file is useful even if power fails before reports.
    source = Path(args.output).expanduser() if args.output else None
    event_path = (source.with_suffix(".perf.jsonl") if source else None)
    summary_path = (source.with_suffix(".perf.json") if source else None)
    performance = PerformanceRecorder(event_path)
    try:
        with performance.phase("initialize"):
            planner = Planner(args)
        planner.performance = performance
        if isinstance(getattr(planner, "git", None), Git):
            planner.git.performance = performance
        with performance.phase("collect"):
            planner.collect()
        with performance.phase("advisor"):
            planner.run_advisor()
        with performance.phase("check_command"):
            check_result = planner.run_check_command()
        with performance.phase("render_primary"):
            report = (planner.report_json(check_result) if args.format == "json"
                      else planner.report_text(check_result))
        with performance.phase("write_reports"):
            if args.output:
                Path(args.output).write_text(report)
            else:
                sys.stdout.write(report)
            if args.json_output:
                # Both artifacts share one collected plan and advisor run.
                json_report = report if args.format == "json" else planner.report_json(check_result)
                Path(args.json_output).write_text(json_report)
        # A report with unresolved conflicts is useful; preserve existing rc.
        rc = 0
        if any(n.replay == "conflict" for n in planner.nodes.values()
               if n.match.status == "missing"):
            rc = 2
        elif check_result is not None and check_result[0] != 0:
            rc = 3
        summary = performance.finish(summary_path)
        print("Performance: total={:.1f}s collect={:.1f}s advisor={:.1f}s "
              "model_requests={} model_wait={:.1f}s git_calls={}".format(
                  summary["elapsed_seconds"],
                  summary["phases"].get("collect", {}).get("seconds", 0),
                  summary["phases"].get("advisor", {}).get("seconds", 0),
                  summary["advisor"]["requests"],
                  summary["advisor"]["request_seconds"],
                  sum(v["count"] for v in summary["git_commands"].values())),
              file=sys.stderr)
        return rc
    finally:
        performance.abort()


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Build a dependency-aware kernel subsystem backport plan"
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    p.add_argument("--package-results", metavar="PREFIX",
                   help="package previously completed PREFIX.c/.json/.log "
                        "(legacy post-run mode)")
    p.add_argument("--no-auto-package", dest="auto_package", action="store_false",
                   help="disable automatic log, results directory, and ZIP for "
                        "matching --output .c and --json-output .json")
    p.set_defaults(auto_package=True)
    p.add_argument("--repo", default=".", help="git repository containing upstream/downstream refs")
    p.add_argument("--base", help="upstream base commit/tag, e.g. v6.19")
    p.add_argument("--target", help="upstream target commit/tag, e.g. v7.0")
    p.add_argument("--downstream-ref", help="downstream ref, e.g. cs10/main; overrides --downstream/--downstream-branch")
    p.add_argument("--downstream", help="downstream remote name, e.g. cs10")
    p.add_argument("--downstream-branch", default="main", help="downstream branch (default: main)")
    p.add_argument("--upstream", help="upstream remote name; used only with --update")
    p.add_argument("--upstream-branch", default="master", help="accepted for find-backports CLI familiarity")
    p.add_argument("--update", action="store_true", help="update named upstream/downstream remotes before analysis")
    p.add_argument("--skip-update", action="store_true", help="compatibility no-op; updates are opt-in")
    p.add_argument("--chronological", action="store_true", help="compatibility no-op; plans are always oldest-first topological")
    p.add_argument("--list-excluded", action="store_true", help="compatibility no-op; present commits are always reported")
    p.add_argument("--path", action="append", help="focus path/pathspec (repeatable)")
    p.add_argument("--file-list", help="file containing focus paths/pathspecs")
    p.add_argument("--include-local", action="store_true",
                   help="also treat downstream-ref..HEAD as already applied; replay starts at HEAD")
    p.add_argument("--no-patch-id", dest="patch_id", action="store_false",
                   help="disable patch-id equivalence matching")
    p.set_defaults(patch_id=True)
    p.add_argument("--no-fixes-closure", dest="fixes_closure", action="store_false")
    p.set_defaults(fixes_closure=True)
    p.add_argument("--no-context-deps", dest="context_deps", action="store_false")
    p.set_defaults(context_deps=True)
    p.add_argument("--no-symbol-deps", dest="symbol_deps", action="store_false")
    p.set_defaults(symbol_deps=True)
    p.add_argument("--context-lines", type=int, default=3,
                   help="nearby parent lines to blame around each hunk (default: 3)")
    p.add_argument("--context-score", type=int, default=5,
                   help="minimum static nearby-context score to record an informational candidate (default: 5)")
    p.add_argument("--max-symbols", type=int, default=40)
    p.add_argument("--max-dependency-rounds", type=int, default=4)
    p.add_argument("--simulate", action=argparse.BooleanOptionalAction, default=True,
                   help="dry-run cherry-picks in a temporary worktree (default: true)")
    p.add_argument("--max-replay-rounds", type=int, default=3)
    p.add_argument(
        "--show-dependency-candidates", action="store_true",
        help="include context-only dependency candidates in a separate informational section",
    )
    p.add_argument("--max-conflict-deps", type=int, default=6,
                   help="max provenance candidates inspected per conflicting commit per round")
    p.add_argument("--merge-risk", action=argparse.BooleanOptionalAction, default=True,
                   help="flag later merge resolutions touching candidate files")
    p.add_argument("--max-merge-risks", type=int, default=5)
    p.add_argument("--check-command",
                   help="optional shell command to run after a clean replay, e.g. 'make -j8'")
    p.add_argument(
        "--advisor-model",
        help="optional Ollama model for AI-assisted TAKE/SKIP/REVIEW recommendations",
    )
    p.add_argument(
        "--advisor-fallback-model",
        help="optional second Ollama model; batch recheck all REVIEW and "
             "unresolved dependency decisions after the primary model",
    )
    p.add_argument(
        "--advisor-fallback-limit", type=int, default=0,
        help="maximum escalation cases (0=all, default: 0)",
    )
    p.add_argument(
        "--advisor-fallback-timeout", type=float, default=900.0,
        help="Gemma request timeout, including CPU offload (default: 900s)",
    )
    p.add_argument(
        "--advisor-fallback-max-request-chars", type=int, default=120000,
        help="complete secondary-model request cap (default: 120000)",
    )
    p.add_argument(
        "--advisor-fallback-context-tokens", type=int, default=131072,
        help="expected fallback model context size (default: 131072)",
    )
    p.add_argument(
        "--advisor-base-url",
        default=os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434"),
        help="Ollama base URL (default: OLLAMA_HOST or http://127.0.0.1:11434)",
