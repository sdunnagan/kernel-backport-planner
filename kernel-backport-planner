def normalize_http_base_url(value: str) -> str:
    value = value.strip().rstrip("/")
    if not value:
        return "http://127.0.0.1:11434"
    if "://" not in value:
        value = "http://" + value
    return value


# These patterns diagnose a narrow failure observed with small local
# advisors. A model repeatedly treated missing product *endorsement* as a
# blocker, contrary to the explicit upstream-convergence policy. This check
# never changes a decision to TAKE; it only requests a policy-aware retry.
_PRODUCT_SUPPORT_OBJECTION = re.compile(
    r"(?:official(?:ly)?\s+supported|supported\s+product\s+platform|"
    r"product\s+(?:support|target|relevance)|"
    r"(?:necessary|beneficial|relevant)\s+for\s+(?:the\s+)?(?:specific\s+)?"
    r"(?:product|supported\s+architectures?|RHEL|CS10)|"
    r"lack\s+of\s+(?:proof|evidence)\s+(?:of|for)\s+(?:product|platform)\s+support)",
    re.IGNORECASE,
)
_ABSENCE_OF_PRODUCT_EVIDENCE = re.compile(
    r"(?:no|not|without|lack(?:s|ing)?|insufficient|absen(?:t|ce)|"
    r"does\s+not\s+(?:provide|show|demonstrate|establish)|"
    r"cannot\s+(?:verify|establish|confirm)|unclear|uncertain|"
    r"fails\s+to\s+(?:show|establish|demonstrate))",
    re.IGNORECASE,
)
# If a response names an actual technical blocker, do not classify it as a
# policy-only objection. Some wording may still warrant human inspection.
_CONCRETE_TECHNICAL_OBJECTION = re.compile(
    r"(?:unresolved\s+(?:symbol|include|header|reference|dependency|binding)|"
    r"(?:missing|undefined)\s+(?:symbol|header|include|function|provider)|"
    r"(?:incompatible|incorrect)\s+(?:API|ABI|interface|binding|type|layout)|"
    r"(?:compile|build|link|runtime)\s+(?:failure|error)|"
    r"(?:specific|demonstrated)\s+(?:semantic|integration|security|regression)\s+(?:risk|conflict)|"
    r"breaks\s+(?:the\s+)?(?:build|ABI|API)|"
    r"conflicts?\s+with\s+(?:the\s+)?(?:existing|downstream)\s+(?:implementation|API))",
    re.IGNORECASE,
)


def policy_only_review_objection(result: dict) -> bool:
    """Spot unsupported-product-review loops; never silently select TAKE.

    Requires an absence-of-evidence claim about product support/relevance
    without a specific technical blocker. Fail conservatively on mixed cases.
    """
    if result.get("decision") != "REVIEW":
        return False
    rationale = result.get("rationale", "")
    if not isinstance(rationale, str):
        return False
    material = " ".join([rationale] + [r for r in result.get("risks", [])
                                     if isinstance(r, str)])
    return (bool(_PRODUCT_SUPPORT_OBJECTION.search(material))
            and bool(_ABSENCE_OF_PRODUCT_EVIDENCE.search(material))
            and not bool(_CONCRETE_TECHNICAL_OBJECTION.search(material)))


def policy_retry_prompt(prompt: str) -> str:
    """Give one bounded policy correction without touching candidate evidence."""
    return (prompt + "\n\nPOLICY RECHECK: Your previous REVIEW was based on "
            "missing affirmative product/hardware support or product benefit. "
            "Our upstream-convergence policy explicitly rejects that as a "
            "reason for REVIEW. Re-evaluate the SAME evidence. Choose TAKE "
            "unless there is a specific, evidence-backed technical/semantic "
            "uncertainty or concrete exclusion; if there is, name it "
            "precisely. Do not invent hardware support or technical hazards. "
            "Return the same JSON schema.\n")


def binding_retry_prompt(prompt: str, evidence_feedback: str = "") -> str:
    """Request missing binding dispositions without fabricating dependencies."""
    return (prompt + "\n\nBINDING EVIDENCE RECHECK: For a TAKE decision, "
            "assess EVERY compatible-binding and dt-property-binding evidence_id "
            "as REQUIRED or NOT_REQUIRED with a concrete reason. Include REQUIRED "
            "IDs in prerequisite_evidence_ids. If NOT_REQUIRED, explain why the "
            "binding is dispensable for this patch; lack of official board support "
            "is not an answer. Do not change Git evidence or invent dependencies.\n"
            + ("SOURCE FACT RECHECK: " + evidence_feedback + "\n"
               if evidence_feedback else ""))


# This is intentionally a narrowly scoped language check, not semantic YAML
# validation. The planner can disprove exact downstream-compatible presence,
# but it cannot prove that every broader pattern in another binding is invalid.
_EXISTING_SCHEMA_CLAIM = re.compile(
    r"(?:\b(?:existing|downstream|current|pre[- ]existing|already)\b.{0,120}"
    r"\b(?:schema|binding)\b.{0,80}\b(?:covers?|supports?|defines?|"
    r"contains?|accepts?|handles?|matches?)\b|"
    r"\b(?:covers?|supports?|defines?|contains?|accepts?|handles?|matches?)\b"
    r".{0,80}\b(?:existing|downstream|current|pre[- ]existing|already)\b"
    r".{0,100}\b(?:schema|binding)\b|"
    r"\b(?:covered|supported|defined|present)\s+by\s+(?:the\s+)?"
    r"(?:existing|downstream|current|pre[- ]existing)?\s*(?:binding|schema)\b)",
    re.IGNORECASE,
)
_DTS_IS_SCHEMA_CLAIM = re.compile(
    r"\b(?:dts|dtsi|device\s+tree|board\s+file)\b.{0,130}"
    r"\b(?:already|itself|includes?|contains?|declares?|defines?)\b.{0,130}"
    r"\bcompatible\b|\bcompatible\b.{0,110}"
    r"\b(?:already|itself)\b.{0,70}\b(?:dts|dtsi|device\s+tree)\b",
    re.IGNORECASE,
)


def binding_claim_feedback(reason: str, compatible: str, schema_text: str | None,
                           binding_path: str, exact_compatibles: set[str]) -> str | None:
    """Flag source-unsupported NOT_REQUIRED claims, never manufacture TAKE.

    Absence of the exact compatible in one downstream schema is not proof that
    no other schema or wildcard pattern can match it. Require evidence of the
    *alternative* schema rather than accepting unsupported 'already covered'.
    """
    if _DTS_IS_SCHEMA_CLAIM.search(reason):
        return ("DTS compatible declarations are not binding-schema coverage; "
                "identify the actual downstream YAML schema or an independent "
                "technical reason the binding patch can be omitted")
    if _EXISTING_SCHEMA_CLAIM.search(reason):
        if schema_text is None:
            status = "the referenced downstream binding path is absent"
        elif compatible not in exact_compatibles:
            status = "the exact compatible is absent from the referenced downstream YAML schema"
        else:
            return None
        return (f"{status}: {binding_path} ({compatible}). A broader pattern "
                "or a different schema may cover it, but that claim needs its "
                "path and matching rule; "
                "do not infer coverage from the SoC family or DTS declaration")
    return None


def dt_include_retry_prompt(prompt: str, facts: list[dict]) -> str:
    """Show exact missing source-file evidence without forcing a decision."""
    return (prompt + "\nHARD DT INCLUDE RECHECK: Git verified the following "
            "missing source files required by already-TAKE consumers: "
            + serialize_advisor_packet(facts) + "\nA DT source #include "
            "is different from an optional YAML binding. Do not dismiss "
            "these providers because hardware lacks official support or "
            "because a schema might be optional. TAKE unless a concrete "
            "technical obstacle makes this particular provider unsafe; "
            "otherwise use REVIEW and name that obstacle.\n")


def parse_advisor_structured_content(content: str) -> dict:
    """Parse one structured advisor object with conservative wrapper tolerance.

    Ollama's constrained-output path can occasionally prefix an otherwise valid
    JSON object with a YAML document separator, or wrap it in a normal JSON code
    fence.  Accept only those narrow wrappers; do not extract JSON from arbitrary
    prose or search for a brace-delimited substring.
    """
    text = content.strip()

    # Tolerate exactly one YAML document-start marker when it occupies its own
    # leading line.  This is not general YAML parsing.
    yaml_match = re.match(r"\A---[ \t]*(?:\r?\n)", text)
    if yaml_match:
        text = text[yaml_match.end():].strip()

    # Tolerate a complete fenced JSON object (or an unlabeled fence) and nothing
    # outside the fence.  Deliberately reject explanatory prose around the fence.
    fence_match = re.fullmatch(
        r"```(?:json)?[ \t]*\r?\n(?P<body>.*?)\r?\n```[ \t]*",
        text,
        flags=re.IGNORECASE | re.DOTALL,
    )
    if fence_match:
        text = fence_match.group("body").strip()

    result = json.loads(text)
    if not isinstance(result, dict):
        raise json.JSONDecodeError("advisor structured response is not a JSON object", text, 0)
    return result


class OllamaAdvisor:
    def __init__(
        self,
        model: str,
        base_url: str,
        timeout: float,
        temperature: float,
        keep_alive: str,
        debug: bool = False,
    ):
        self.model = model
        self.base_url = normalize_http_base_url(base_url)
        self.timeout = timeout
        self.temperature = temperature
        self.keep_alive = keep_alive
        self.debug = debug
        self.last_telemetry: dict | None = None

    def unload(self) -> None:
        """Ask Ollama to release VRAM/RAM before loading another model.

        No model content is sent; Ollama still enforces its loaded-model cap.
        """
        request = urllib.request.Request(
            self.base_url + "/api/chat",
            data=json.dumps({"model": self.model, "messages": [],
                             "keep_alive": 0, "stream": False}).encode(),
            headers={"Content-Type": "application/json"}, method="POST")
        with urllib.request.urlopen(request, timeout=min(self.timeout, 60)) as response:
            response.read()

    def warmup(self, context_tokens: int) -> None:
        """Preload model and allocate the intended context before the batch.

        An empty /api/generate prompt loads the runner without producing an
        inference answer. Errors are reported, never mistaken for a decision.
        """
        payload = {
            "model": self.model, "prompt": "", "stream": False,
            "keep_alive": self.keep_alive,
            "options": {"num_ctx": context_tokens},
        }
        request = urllib.request.Request(
            self.base_url + "/api/generate",
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}, method="POST",
        )
        try:
            with urllib.request.urlopen(request,
                                        timeout=self.timeout) as response:
                response.read()
        except urllib.error.HTTPError as exc:
            detail = exc.read(4096).decode("utf-8", errors="replace").strip()
            raise AdvisorError(
                f"Fallback warmup HTTP {exc.code}: {detail or exc.reason}",
                kind="http", retryable=exc.code == 429 or exc.code >= 500,
            ) from exc
        except (TimeoutError, socket.timeout, urllib.error.URLError) as exc:
            raise AdvisorError(
                f"Ollama fallback warmup unavailable: {exc}",
                kind="transport", retryable=True,
            ) from exc

    def advise(self, system_prompt: str, packet: dict, response_schema: dict | None = None) -> dict:
        self.last_telemetry = None
        payload = {
            "model": self.model,
            "stream": False,
            "format": response_schema or ADVISOR_RESPONSE_SCHEMA,
            "keep_alive": self.keep_alive,
            "options": {"temperature": self.temperature},
            "messages": [
                {"role": "system", "content": system_prompt},
                {
                    "role": "user",
                    "content": (
                        "Evaluate this kernel backport candidate. Return only the "
                        "structured response required by the schema.\n\n"
                        + serialize_advisor_packet(packet)
                    ),
                },
            ],
        }
        data = json.dumps(payload).encode("utf-8")
        request = urllib.request.Request(
            self.base_url + "/api/chat",
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        if self.debug:
            print(
                f"advisor POST {self.base_url}/api/chat model={self.model} "
                f"packet_sha={packet.get('commit', {}).get('sha', '?')}",
                file=sys.stderr,
            )
        response_text: str | None = None
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                response_text = response.read().decode("utf-8")
                outer = json.loads(response_text)
                if isinstance(outer, dict):
                    self.last_telemetry = {
                        key: outer[key]
                        for key in ("total_duration", "load_duration",
                                    "prompt_eval_duration", "eval_duration",
                                    "prompt_eval_count", "eval_count")
                        if isinstance(outer.get(key), int)
                        and not isinstance(outer[key], bool)
                    }
        except urllib.error.HTTPError as exc:
            detail = exc.read(4096).decode("utf-8", errors="replace").strip()
            raise AdvisorError(
                f"Ollama HTTP error {exc.code}: {detail or exc.reason}",
                kind="http",
                retryable=exc.code == 429 or exc.code >= 500,
            ) from exc
        except (TimeoutError, socket.timeout) as exc:
            raise AdvisorError(
                f"Ollama request timed out: {exc}", kind="timeout", retryable=True
            ) from exc
        except urllib.error.URLError as exc:
            reason = getattr(exc, "reason", None)
            kind = "timeout" if isinstance(reason, (TimeoutError, socket.timeout)) else "transport"
            raise AdvisorError(
                f"Ollama request failed: {exc}", kind=kind, retryable=True
            ) from exc
        except json.JSONDecodeError as exc:
            raise AdvisorError(
                "Ollama returned invalid outer JSON",
                kind="invalid-response",
                retryable=True,
                raw_response=response_text,
            ) from exc

        content = None
        try:
            content = outer["message"]["content"]
            if not isinstance(content, str):
                raise TypeError("Ollama message content is not a string")
            result = parse_advisor_structured_content(content)
        except (KeyError, TypeError, json.JSONDecodeError) as exc:
            diagnostic = content if isinstance(content, str) else response_text
            raise AdvisorError(
                "Ollama returned an invalid structured response",
                kind="invalid-response",
                retryable=True,
                raw_response=diagnostic,
            ) from exc
        return result



def verify_advisor_fallback_model(base_url: str, model: str) -> None:
    """Fail before expensive collection if the secondary model is not local.

    Ollama /api/tags lists installed models and does not load model weights.
    """
    url = normalize_http_base_url(base_url) + "/api/tags"
    try:
        with urllib.request.urlopen(url, timeout=15) as response:
            tags = json.load(response)
    except (OSError, ValueError, urllib.error.URLError) as exc:
        raise SystemExit("cannot verify Ollama fallback model " + model +
                         " at " + url + ": " + str(exc)) from exc
    available = {item.get("name") for item in tags.get("models", [])
                 if isinstance(item, dict)}
    if model not in available:
        raise SystemExit("Ollama fallback model " + model +
                         " is not installed; check 'ollama list' on gondor")


def serialize_advisor_packet(packet: dict) -> str:
    """Stable, compact JSON for Ollama. Avoid whitespace-heavy prompt inflation."""
    return json.dumps(packet, sort_keys=True, ensure_ascii=True,
                      separators=(",", ":"))


def advisor_request_size(system_prompt: str, packet: dict, schema: dict) -> int:
    """Conservative character count for the Ollama request's content/schema.

    This is NOT a tokenizer. A limit protects common long packets, but cannot
    guarantee a 32K model context will fit. Callers must check actual tokens.
    """
    return (len(system_prompt) + len(serialize_advisor_packet(packet))
            + len(json.dumps(schema, sort_keys=True, ensure_ascii=True)) + 512)


def budget_advisor_packet(packet: dict, prompt: str, schema: dict,
                          limit: int) -> tuple[dict, dict]:
    """Remove only optional context excerpts; keep all prerequisite evidence.

    Never remove identifiers, binding/namespace evidence, commit changed paths,
    the selected commit patch, or inbound TAKE recommendations. If those exceed
    the budget, raise instead of risking a decision on incomplete evidence.
    """
    before = advisor_request_size(prompt, packet, schema)
    meta = {"initial_chars": before, "final_chars": before,
            "limit_chars": limit, "omitted": []}
    if not limit or before <= limit:
        return packet, meta
    output = json.loads(json.dumps(packet))
    commit = output["commit"]
    # This legacy field duplicates eligible_prerequisite_evidence verbatim.
    # Keep its full authoritative counterpart; omit the redundant copy only
    # when doing so helps fit an otherwise oversized request.
    if ("same_series_consumed_objects" in commit and
            commit["same_series_consumed_objects"] ==
            commit.get("eligible_prerequisite_evidence")):
        del commit["same_series_consumed_objects"]
        meta["omitted"].append("duplicate-consumed-object-evidence")
    # Redundant identity/provenance indexes have authoritative counterparts
    # in the per-evidence records and same-series context. Remove them only
    # under budget pressure; never trim evidence IDs or selected patch bytes.
    if (advisor_request_size(prompt, output, schema) > limit
            and "eligible_prerequisite_peer_shas" in commit):
        del commit["eligible_prerequisite_peer_shas"]
        meta["omitted"].append("redundant-prerequisite-peer-index")
    if (advisor_request_size(prompt, output, schema) > limit
            and "all_missing_earlier_peer_shas" in commit):
        del commit["all_missing_earlier_peer_shas"]
        meta["omitted"].append("optional-earlier-peer-index")
    # The binding coverage summary duplicates full authoritative evidence
    # records. It can be omitted, but the actual evidence IDs cannot.
    if (advisor_request_size(prompt, output, schema) > limit
            and "binding_coverage_candidates" in commit):
        del commit["binding_coverage_candidates"]
        meta["omitted"].append("optional-binding-coverage-summary")
    # These are provenance/context excerpts, not eligible prerequisite evidence.
    excerpts = []
    for peer in commit.get("same_series", []):
        if isinstance(peer, dict) and peer.get("patch_excerpt"):
            excerpts.append((peer, "patch_excerpt", "series-peer-diff"))
    for peer in (commit.get("deterministic_consumer_context", {})
                 .get("consumers", [])):
        if isinstance(peer, dict) and peer.get("patch_excerpt"):
            excerpts.append((peer, "patch_excerpt", "consumer-context-diff"))
    if commit.get("message"):
        excerpts.append((commit, "message", "commit-message"))
    for record, key, name in excerpts:
        if advisor_request_size(prompt, output, schema) <= limit:
            break
        record[key] = "[OPTIONAL EXCERPT OMITTED FOR CONTEXT BUDGET]"
        meta["omitted"].append(name)
    # The consumer graph below is optional discovery provenance, NOT an
    # actual_inbound_take_prerequisites recommendation. Its nested records can
    # be enormous even after all optional patch excerpts have been removed.
    # Keep the authoritative inbound recommendations and eligible evidence;
    # remove only this independent, provenance-only context when necessary.
    if advisor_request_size(prompt, output, schema) > limit:
        context = commit.get("deterministic_consumer_context")
        if isinstance(context, dict) and context.get("consumers"):
            count = len(context["consumers"])
            context["consumers"] = []
            context["note"] = (
                "Optional discovery provenance was omitted for request budget; "
                "only actual_inbound_take_prerequisites lists actionable inbound "
                "advisor recommendations."
            )
            meta["omitted"].append(f"optional-consumer-provenance:{count}")
    # Large same-series summaries can repeat the authoritative evidence IDs,
    # SHAs and changed paths in eligible_prerequisite_evidence. Retain the
    # latter in full and only drop optional summary metadata, not source data.
    if advisor_request_size(prompt, output, schema) > limit:
        peers = commit.get("same_series")
        if isinstance(peers, list):
            for peer in peers:
                if advisor_request_size(prompt, output, schema) <= limit:
                    break
                if isinstance(peer, dict) and "scope" in peer:
                    del peer["scope"]  # changed_files remain in the same record
                    meta["omitted"].append("optional-series-peer-scope")
    after = advisor_request_size(prompt, output, schema)
    meta["final_chars"] = after
    if after > limit:
        raise AdvisorError(
            f"required advisor evidence exceeds character budget ({after} > {limit}); "
            "manual REVIEW required (no model request was sent)",
            kind="evidence-budget", retryable=False,
        )
    # The full evidence still fits. A notice is useful but it is OPTIONAL:
    # do not turn an otherwise valid packet into a REVIEW merely because
    # adding the notice would push it across the configured ceiling.
    notice = ("Some optional source excerpts were omitted to fit the request. "
              "If the remaining evidence is insufficient, answer REVIEW.")
    output["evidence_budget_notice"] = notice
    final = advisor_request_size(prompt, output, schema)
    if final > limit:
        del output["evidence_budget_notice"]
        meta["notice_embedded"] = False
        meta["final_chars"] = after
    else:
        meta["notice_embedded"] = True
        meta["final_chars"] = final
    return output, meta


class Planner:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.repo = Path(args.repo).resolve()
        self.git = Git(self.repo, args.debug)
        self.downstream_ref = args.downstream_ref or (
            f"{args.downstream}/{args.downstream_branch}" if args.downstream else None
        )
        if not self.downstream_ref:
            raise SystemExit("provide --downstream-ref or --downstream <remote>")
        if args.update:
            remotes = [x for x in (args.upstream, args.downstream) if x]
            for remote in dict.fromkeys(remotes):
                self.info(f"Updating remote {remote}...")
                self.git.run(["remote", "update", remote])
        self.base = self.git.rev_parse(args.base)
        self.target = self.git.rev_parse(args.target)
        self.downstream = self.git.rev_parse(self.downstream_ref)
        if args.include_local and not self.git.is_ancestor(self.downstream, self.git.rev_parse("HEAD")):
            raise SystemExit(
                f"--include-local requires HEAD to descend from {self.downstream_ref}; "
                "use --downstream-ref for the actual base of the working branch"
            )
        self.replay_start = self.git.rev_parse("HEAD" if args.include_local else self.downstream_ref)
        self.replay_start_source = "HEAD, --include-local" if args.include_local else self.downstream_ref
        self.replay_rounds_run = 0
        self.replay_final_verification = False
        self.paths = self._load_paths(args)
        self.nodes: dict[str, CommitNode] = {}
        self.downstream_index = DownstreamIndex()
        self._patch_id_cache: dict[str, str | None] = {}
        self._body_cache: dict[str, str] = {}
        self._subject_cache: dict[str, str] = {}
        self._changed_files_cache: dict[str, list[str]] = {}
        self._tree_file_text_cache: dict[tuple[str, str], str | None] = {}
        self._dt_include_closure_cache: dict[tuple[str, str], set[str]] = {}
        # Evidence-backed compatible providers beyond a commit's patch series.
        # These are only candidate leads until an advisor selects REQUIRED.
        self.dt_binding_candidate_links: dict[str, list[dict[str, str]]] = {}
        self._dt_binding_provider_index_cache: (
            dict[str, list[tuple[str, str]]] | None
        ) = None
        self._dt_binding_audit_scanned: set[str] = set()
        self.dt_binding_coverage_overflow: dict[str, int] = {}
        self._match_cache: dict[str, Match] = {}
        self._fixes_children: dict[str, set[str]] | None = None
        self._dependency_expanded: set[str] = set()
        self._pre_base_cache: dict[str, bool] = {}
        self.series_groups: dict[str, list[tuple[int, str]]] = {}
        self.advisor_model = args.advisor_model
        self.advisor_primary_model = args.advisor_model
        self.advisor_fallback_model = getattr(args, "advisor_fallback_model", None)
        self.advisor_fallback_evaluated = 0
        self.advisor_fallback_accepted = 0
        self.advisor_fallback_failures = 0
        self.advisor_fallback_changed = 0
        self.advisor_fallback_take = 0
        self.advisor_fallback_unprocessed = 0
        self.advisor_fallback_deferred_retries = 0
        self.advisor_fallback_recovered = 0
        self.advisor_fallback_warmup_error = None
        self._advisor_stage = "primary"
        self.advisor_cache_path: Path | None = None
        self.advisor_cache: dict[str, dict] = {}
        self.advisor_calls = 0
        self.advisor_cache_hits = 0
        self.advisor_retries_used = 0
        self.advisor_policy_rechecks = 0
        self.advisor_failures = 0
        self.advisor_failure_kinds: collections.Counter[str] = collections.Counter()
        self.advisor_reconsiderations = 0
        self.advisor_consistency_issues: list[dict[str, str]] = []
        self.advisor_error_log_path: Path | None = None
        self.advisor_error_log_entries = 0
        self.advisor_trace_path: Path | None = None
        if self.advisor_model:
            if args.advisor_error_log:
                self.advisor_error_log_path = Path(args.advisor_error_log).expanduser().resolve()
            elif args.output:
                self.advisor_error_log_path = Path(args.output + ".advisor-errors.jsonl").expanduser().resolve()
            else:
                self.advisor_error_log_path = self.repo / ".kernel-backport-planner-advisor-errors.jsonl"
            try:
                self.advisor_error_log_path.unlink(missing_ok=True)
            except OSError:
                self.info(f"Could not clear advisor error log: {self.advisor_error_log_path}")
            trace_arg = getattr(args, "advisor_trace", None)
            if trace_arg:
                self.advisor_trace_path = Path(trace_arg).expanduser().resolve()
                if os.path.lexists(self.advisor_trace_path):
                    raise SystemExit("advisor trace already exists: " +
                                     str(self.advisor_trace_path))
                self.advisor_trace_path.parent.mkdir(parents=True, exist_ok=True)
                self.advisor_trace_path.touch(exist_ok=False)
            if args.advisor_cache:
                self.advisor_cache_path = Path(args.advisor_cache).expanduser().resolve()
            elif args.output:
                self.advisor_cache_path = Path(args.output + ".advisor-cache.json").expanduser().resolve()
            else:
                self.advisor_cache_path = self.repo / ".kernel-backport-planner-advisor-cache.json"
            if not args.no_advisor_cache and self.advisor_cache_path.exists():
                try:
                    raw_cache = json.loads(self.advisor_cache_path.read_text())
                    if isinstance(raw_cache, dict):
                        self.advisor_cache = raw_cache
                except (OSError, json.JSONDecodeError):
                    self.info(f"Ignoring unreadable advisor cache: {self.advisor_cache_path}")

    def _phase(self, name: str):
        performance = getattr(self, "performance", None)
        return performance.phase(name) if performance else contextlib.nullcontext()

    def _load_paths(self, args: argparse.Namespace) -> list[str]:
        paths: list[str] = []
        paths.extend(args.path or [])
        if args.file_list:
            for raw in Path(args.file_list).read_text().splitlines():
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                paths.append(line)
        # Preserve order while deduplicating.
        return list(dict.fromkeys(paths))

    def info(self, msg: str) -> None:
        if not self.args.quiet:
            print(msg, file=sys.stderr)

    def subject(self, sha: str) -> str:
        if sha not in self._subject_cache:
            self._subject_cache[sha] = self.git.subject(sha)
        return self._subject_cache[sha]

    def body(self, sha: str) -> str:
        if sha not in self._body_cache:
            self._body_cache[sha] = self.git.body(sha)
        return self._body_cache[sha]

    def changed_files(self, sha: str) -> list[str]:
        if sha not in self._changed_files_cache:
            self._changed_files_cache[sha] = self.git.changed_files(sha)
        return self._changed_files_cache[sha]

    @staticmethod
    def _truncate_text(text: str, limit: int) -> str:
        if limit <= 0 or len(text) <= limit:
            return text
        marker = f"\n... [truncated {len(text) - limit} characters]"
        keep = max(0, limit - len(marker))
        return text[:keep] + marker

    @staticmethod
    def _one_line(text: str) -> str:
        return re.sub(r"\s+", " ", text).strip()

    def patch_excerpt(self, sha: str, limit: int) -> str:
        cache = getattr(self, "_advisor_patch_text_cache", None)
        if cache is None:
            cache = {}
            self._advisor_patch_text_cache = cache
        patch = cache.get(sha)
        if patch is None:
            patch = self.git.run([
                "show", "--format=", "--no-ext-diff", "--find-renames", "--find-copies", sha
            ])
            cache[sha] = patch
        return self._truncate_text(patch, limit)

    def advisor_product_context(self) -> dict:
        mode = getattr(self.args, "advisor_product", "auto")
        is_cs10 = (
            mode == "rhel10"
            or (
                mode == "auto"
                and (
                    str(getattr(self.args, "downstream", "") or "").lower() == "cs10"
                    or "cs10" in str(self.downstream_ref).lower()
                    or "centos-stream-10" in str(self.repo).lower()
                )
            )
        )
        if not is_cs10:
            return {
                "product": "generic downstream Linux kernel",
                "supported_architectures": None,
                "policy_note": (
                    "No product-specific architecture allowlist is configured. "
                    "Use repository evidence and focus paths rather than assuming product support."
                ),
            }
        return {
            "product": "Red Hat Enterprise Linux 10 / CentOS Stream 10",
            "supported_architectures": [
                {"kernel_arch_dir": arch, "product_architecture": desc}
                for arch, desc in RHEL10_SUPPORTED_ARCHITECTURES.items()
            ],
            "supported_kernel_arch_dirs": sorted(RHEL10_SUPPORTED_ARCHITECTURES),
            "policy_note": (
                "RHEL 10 product architectures are x86_64, aarch64, ppc64le, and s390x. "
                "Architecture-only commits for other arch/* trees should normally be SKIP unless "
                "the supplied diff/graph evidence demonstrates a concrete prerequisite for code "
                "that the product actually builds. A cross-architecture symbol-name or hunk-"
                "provenance match alone is not sufficient."
            ),
        }

    @staticmethod
    def _path_architecture_dirs(path: str) -> set[str]:
        """Return architecture ownership encoded by a source path.

        Most architecture ownership is explicit under arch/<name>/, but optimized
        library code also lives in architecture-named subtrees such as
        lib/crypto/arm/ and lib/crypto/arm64/. Keep this intentionally narrow: a
        platform/vendor directory elsewhere in drivers/ is not an architecture.
        """
        parts = [part for part in path.split("/") if part]
        if len(parts) >= 2 and parts[0] == "arch" and parts[1]:
            return {parts[1]}
        candidates: list[str] = []
        if len(parts) >= 3 and parts[0] == "lib" and parts[1] == "crypto":
            candidates.append(parts[2])
        if len(parts) >= 2 and parts[0] == "crypto":
            candidates.append(parts[1])
        if len(parts) >= 2 and parts[0] == "lib":
            candidates.append(parts[1])
        return {name for name in candidates if name in KNOWN_KERNEL_ARCHITECTURES}

    @classmethod
    def _architecture_dirs(cls, files: Sequence[str]) -> list[str]:
        result: set[str] = set()
        for path in files:
            result.update(cls._path_architecture_dirs(path))
        return sorted(result)

    def _advisor_path_product_relevant(self, path: str) -> bool:
        """Whether architecture ownership of *path* is relevant to the product.

        Common paths have no architecture owner and remain eligible. In generic
        downstream mode no product architecture allowlist is applied.
        """
        owners = self._path_architecture_dirs(path)
        if not owners:
            return True
        supported = set(
            self.advisor_product_context().get("supported_kernel_arch_dirs") or []
        )
        return not supported or not owners.isdisjoint(supported)

    def _advisor_evidence_paths_compatible(
        self, selected_path: str, provider_path: str
    ) -> bool:
        """Return True when a lexical relationship is product/path plausible."""
        if not self._advisor_path_product_relevant(selected_path):
            return False
        if not self._advisor_path_product_relevant(provider_path):
            return False
        selected_owners = self._path_architecture_dirs(selected_path)
        provider_owners = self._path_architecture_dirs(provider_path)
        if selected_owners and provider_owners and selected_owners.isdisjoint(provider_owners):
            return False
        return True

    def advisor_scope_context(self, files: Sequence[str]) -> dict:
        files = list(files)
        ownership_by_file = [self._path_architecture_dirs(path) for path in files]
        arch_dirs = sorted({arch for owners in ownership_by_file for arch in owners})
        product = self.advisor_product_context()
        supported = set(product.get("supported_kernel_arch_dirs") or [])
        focus = [p.rstrip("/") for p in self.paths]
        touches_focus = any(
            path == prefix or path.startswith(prefix + "/")
            for path in files for prefix in focus
        )
        # Use the same architecture-ownership classifier everywhere. Architecture-
        # local code can live outside arch/<name>/ (for example lib/crypto/arm/),
        # and a commit that also changes common code must not be classified as
        # unsupported-architecture-only merely because one file is architecture-
        # owned.
        all_files_arch_local = bool(files) and all(bool(owners) for owners in ownership_by_file)
        unsupported_only = bool(
            supported
            and arch_dirs
            and all_files_arch_local
            and set(arch_dirs).isdisjoint(supported)
        )
        if not supported:
            architecture_scope = "unrestricted"
        elif not arch_dirs:
            architecture_scope = "common"
        elif unsupported_only:
            architecture_scope = "unsupported-only"
        elif set(arch_dirs) & supported:
            architecture_scope = "supported-or-mixed"
        else:
            # At least one common, unowned file prevented unsupported_only.
            architecture_scope = "common-plus-unsupported"
        return {
            "architecture_dirs": arch_dirs,
            "architecture_scope": architecture_scope,
            "touches_focus_paths": touches_focus,
            "touches_supported_architecture": (
                bool(set(arch_dirs) & supported) if supported and arch_dirs else None
            ),
            "unsupported_architecture_only": unsupported_only,
        }

    @staticmethod
    def _deleted_files_from_patch(patch: str) -> set[str]:
        """Return paths deleted by a unified Git patch excerpt."""
        deleted: set[str] = set()
        current_path: str | None = None
        for line in patch.splitlines():
            match = DIFF_FILE_RE.match(line)
            if match:
                current_path = match.group(2)
                continue
            if current_path and (line.startswith("deleted file mode ") or line == "+++ /dev/null"):
                deleted.add(current_path)
        return deleted

    def advisor_obsolescence_context(self, sha: str, files: Sequence[str]) -> dict:
        """Describe immediate TAKE consumers that delete this candidate's files.

        This is intentionally narrow. Deletion by a later provenance consumer is a
        concrete final-state signal; ordinary modification is not. Only already-TAKE
        immediate consumers participate so deeper graph ancestry cannot manufacture
        an obsolescence conclusion.
        """
        candidate_files = set(files)
        consumers: list[dict] = []
        deleted_union: set[str] = set()
        node = self.nodes.get(sha)
        if node is None or not candidate_files:
            return {
                "all_changed_files_deleted_by_take_consumers": False,
                "take_consumers": [],
            }
        for consumer_sha in sorted(node.required_by):
            consumer = self.nodes.get(consumer_sha)
            if consumer is None or consumer.advisor_decision != "TAKE":
                continue
            patch = self.patch_excerpt(
                consumer_sha, self.args.advisor_max_related_diff_chars
            )
            deleted = self._deleted_files_from_patch(patch)
            overlap = sorted(candidate_files & deleted)
            if not overlap:
                continue
            deleted_union.update(overlap)
            consumers.append({
                "sha": consumer_sha,
                "subject": self.subject(consumer_sha),
                "deleted_candidate_files": overlap,
            })
        return {
            "all_changed_files_deleted_by_take_consumers": bool(candidate_files)
            and candidate_files <= deleted_union,
            "take_consumers": consumers,
        }

    def advisor_series_context(self, sha: str) -> list[dict]:
        node = self.nodes[sha]
        groups: list[dict] = []
        peer_diffs_used = 0
        for label in sorted(node.series_ids):
            members = self.series_groups.get(label, [])
            selected_patch = next((p for p, member_sha in members if member_sha == sha), None)
            peers: list[dict] = []
            for patch_no, member_sha in members:
                m = self.match(member_sha)
                relation = "same"
                if selected_patch is not None:
                    if patch_no < selected_patch:
                        relation = "earlier"
                    elif patch_no > selected_patch:
                        relation = "later"
                peer_files = self.changed_files(member_sha)
                peer = {
                    "patch": patch_no,
                    "sha": member_sha,
                    "subject": self.subject(member_sha),
                    "relation": relation,
                    "selected_by_planner": (
                        member_sha in self.nodes
                        and self.is_actionable_node(self.nodes[member_sha])
                    ),
                    "downstream_status": m.status,
                    "changed_files": peer_files,
                    "scope": self.advisor_scope_context(peer_files),
                }
                if (
                    member_sha != sha
                    and relation == "earlier"
                    and m.status == "missing"
                    and peer_diffs_used < self.args.advisor_max_peer_diffs
                ):
                    peer["patch_excerpt"] = self.patch_excerpt(
                        member_sha, self.args.advisor_max_peer_diff_chars
                    )
                    peer_diffs_used += 1
                peers.append(peer)
            groups.append({
                "series": label,
                "selected_patch": selected_patch,
                "members": peers,
            })
        return groups

    def advisor_allowed_prerequisite_peers(self, sha: str) -> list[str]:
        allowed: list[str] = []
        for label in sorted(self.nodes[sha].series_ids):
            members = self.series_groups.get(label, [])
            selected_patch = next((p for p, member_sha in members if member_sha == sha), None)
            if selected_patch is None:
                continue
            allowed.extend(
                member_sha
                for patch_no, member_sha in members
                if patch_no < selected_patch and self.match(member_sha).status == "missing"
            )
        links = getattr(self, "dt_binding_candidate_links", {}).get(sha, [])
        allowed.extend(record["peer_sha"] for record in links)
        return list(dict.fromkeys(allowed))

    def _dt_binding_provider_index(self) -> dict[str, list[tuple[str, str]]]:
        """Index exact compatible additions to upstream binding YAML once.

        This is a candidate index, NOT proof that a binding patch is needed.
        Restricting to added lines in the selected base..target interval avoids
        treating ancient unchanged bindings as new prerequisite commits.
        """
        cached = getattr(self, "_dt_binding_provider_index_cache", None)
        if cached is not None:
            return cached
        self.info("Indexing upstream binding compatible additions...")
        raw = self.git.run([
            "log", "--no-merges", "--no-ext-diff", "--unified=0",
            "--format=%x1e%H", f"{self.base}..{self.target}", "--",
            "Documentation/devicetree/bindings/",
        ])
        index: dict[str, list[tuple[str, str]]] = collections.defaultdict(list)
        for record in raw.split("\x1e"):
            header, _, patch = record.partition("\n")
            sha = header.strip()
            if not re.fullmatch(r"[0-9a-f]{40}", sha):
                continue
            for path, added in self._added_patch_text_by_file(patch).items():
                if not (path.startswith("Documentation/devicetree/bindings/")
                        and path.endswith((".yaml", ".yml"))):
                    continue
                compatibles = self._yaml_binding_compatible_candidates(added)
                for compatible in compatibles:
                    entry = (sha, path)
                    if entry not in index[compatible]:
                        index[compatible].append(entry)
        self._dt_binding_provider_index_cache = dict(index)
        self.info(f"  indexed {len(index)} distinct binding compatibles")
        return self._dt_binding_provider_index_cache

    def _audit_dt_binding_candidates(self, sha: str) -> None:
        """Expose exact cross-series binding providers without forcing TAKE.

        A matching YAML compatible is evidence worth evaluating, not a hard DT
        build prerequisite. Existing downstream schemas and unverified ancestry
        are excluded. Advisor binding dispositions audit the remaining leads.
        """
        scanned = getattr(self, "_dt_binding_audit_scanned", None)
        if scanned is None or sha in scanned:
            return
        scanned.add(sha)
        node = self.nodes[sha]
        if node.match.status != "missing":
            return
        paths = [path for path in node.files if self._is_dt_source_path(path)
                 and self._advisor_path_product_relevant(path)]
        if not paths:
            return
        patch = self.git.run([
            "show", "--pretty=format:", "--no-ext-diff", "--unified=0",
            sha, "--", *paths,
        ])
        compatibles: set[str] = set()
        for path, added in self._added_patch_text_by_file(patch).items():
            if path in paths:
                compatibles.update(self._dt_compatible_strings(added))
        if not compatibles:
            return
        index = self._dt_binding_provider_index()
        links: list[dict[str, str]] = []
        for compat in sorted(compatibles):
            for peer_sha, binding_path in index.get(compat, []):
                if peer_sha == sha or not self.upstream_before(peer_sha, sha):
                    continue
                # A downstream schema already advertising the compatible
                # makes a new upstream provider optional/redundant here.
                downstream_schema = self._tree_file_text(
                    self.replay_start, binding_path)
                if (downstream_schema is not None
                        and compat in self._yaml_binding_compatible_candidates(
                            downstream_schema)):
                    continue
                peer = self.ensure_node(
                    peer_sha, reason=f"dt-binding-candidate:{compat}",
                    required_by=sha,
                )
                if peer.match.status == "present":
                    continue
                links.append({
                    "peer_sha": peer.sha, "compatible": compat,
                    "binding_path": binding_path,
                    "status": "evidence-only",
                })
        if links:
            if len(links) > 64:
                self.dt_binding_coverage_overflow[sha] = len(links)
                self.info(f"    binding coverage limit: {sha[:12]} has "
                          f"{len(links)} candidates; manual review required")
            self.dt_binding_candidate_links[sha] = links
            self.info(f"    binding coverage: {sha[:12]} has "
                      f"{len(links)} upstream provider candidate(s)")

    @staticmethod
    def _added_patch_text(patch: str) -> str:
        """Return only added patch lines, excluding diff metadata."""
        return "\n".join(
            line[1:]
            for line in patch.splitlines()
            if line.startswith("+") and not line.startswith("+++")
        )

    @staticmethod
    def _added_patch_text_by_file(patch: str) -> dict[str, str]:
        """Return added lines grouped by destination path in a unified diff."""
        grouped: dict[str, list[str]] = collections.defaultdict(list)
        current: str | None = None
        for line in patch.splitlines():
            match = DIFF_FILE_RE.match(line)
            if match:
                current = match.group(2)
                continue
            if current and line.startswith("+") and not line.startswith("+++"):
                grouped[current].append(line[1:])
        return {path: "\n".join(lines) for path, lines in grouped.items()}

    @staticmethod
    def _dts_label_references(text: str) -> set[str]:
        return set(re.findall(r"&([A-Za-z_][A-Za-z0-9_]*)\b", text))

    @staticmethod
    def _dts_label_definitions(text: str) -> set[str]:
        # Device-tree labels begin with e.g. ``uart18:``. The opening brace
        # may be on the same line or later in a truncated diff excerpt.
        return set(
            re.findall(
                r"(?m)^\s*([A-Za-z_][A-Za-z0-9_]*)\s*:",
                text,
            )
        )

    @staticmethod
    def _macro_uses(text: str) -> set[str]:
        return set(MACRO_RE.findall(text))

    @staticmethod
    def _macro_definitions(text: str) -> set[str]:
        return set(
            re.findall(r"(?m)^\s*#\s*define\s+([A-Z][A-Z0-9_]{3,})\b", text)
        )

    @staticmethod
    def _function_calls(text: str) -> set[str]:
        return {name for name in FUNC_CALL_RE.findall(text) if name not in C_KEYWORDS}

    @staticmethod
    def _function_definitions(text: str) -> set[str]:
        # Conservative approximation for newly-added C function definitions.
        # Allow the opening brace to appear on a following added line.
        result = set()
        pattern = re.compile(
            r"(?m)^[ \t]*(?:[A-Za-z_][A-Za-z0-9_]*[ \t*]+)+"
            r"([A-Za-z_][A-Za-z0-9_]*)[ \t]*\([^;{}]*\)[ \t\n]*\{"
        )
        for match in pattern.finditer(text):
            name = match.group(1)
            if name not in C_KEYWORDS:
                result.add(name)
        return result

    @staticmethod
    def _function_declarations(text: str) -> set[str]:
        # Header-style declarations/prototypes, including common annotations such
        # as __init between the return type and function name.
        result = set()
        pattern = re.compile(
            r"(?m)^[ \t]*(?:extern[ \t]+)?"
            r"(?:[A-Za-z_][A-Za-z0-9_]*[ \t*]+)+"
            r"([A-Za-z_][A-Za-z0-9_]*)[ \t]*\([^;{}]*\)[ \t\n]*;"
        )
        for match in pattern.finditer(text):
            name = match.group(1)
            if name not in C_KEYWORDS:
                result.add(name)
        return result

    @staticmethod
    def _include_paths(text: str) -> set[str]:
        return set(re.findall(r'(?m)^\s*#\s*include\s*[<"]([^>"]+)[>"]', text))

    @staticmethod
    def _include_candidate_paths(current_path: str, include: str) -> list[str]:
        """Return plausible kernel-tree paths for one preprocessor include.

        This is deliberately small rather than a general C preprocessor search
        implementation. Device Tree sources primarily need relative DTS/DTSI
        includes plus the kernel's include/ prefix used for dt-bindings headers.
        """
        include = include.strip()
        if not include:
            return []

        candidates: list[str] = []
        if include.startswith("dt-bindings/"):
            candidates.append(f"include/{include}")
        elif include.startswith("include/"):
            candidates.append(include)

        current_dir = posixpath.dirname(current_path)
        if current_dir:
            candidates.append(posixpath.normpath(posixpath.join(current_dir, include)))

        dts_match = re.match(r"^(arch/[^/]+/boot/dts)(?:/|$)", current_path)
        if dts_match:
            candidates.append(posixpath.normpath(posixpath.join(dts_match.group(1), include)))

        if not include.startswith(("dt-bindings/", "include/")):
            candidates.append(posixpath.normpath(posixpath.join("include", include)))

        return [
            path for path in dict.fromkeys(candidates)
            if path and path != "." and not path.startswith("../")
        ]

    def _tree_file_text(self, treeish: str, path: str) -> str | None:
        cache = getattr(self, "_tree_file_text_cache", None)
        if cache is None:
            cache = {}
            self._tree_file_text_cache = cache
        key = (treeish, path)
        if key in cache:
            return cache[key]
        if not self.git.ok(["cat-file", "-e", f"{treeish}:{path}"]):
            cache[key] = None
            return None
        text = self.git.run(["show", f"{treeish}:{path}"], check=False)
        cache[key] = text
        return text

    def dt_binding_include_closure(self, sha: str, start_path: str) -> set[str]:
        """Return reachable include/dt-bindings headers for one selected file.

        Follow a bounded graph consisting of Device Tree sources and dt-bindings
        headers. This is sufficient to establish the namespace through which a
        DTS/DTSI consumer sees clock/reset/etc. ID macros without recursively
        walking the kernel's entire C header graph.
        """
        cache = getattr(self, "_dt_include_closure_cache", None)
        if cache is None:
            cache = {}
            self._dt_include_closure_cache = cache
        key = (sha, start_path)
        if key in cache:
            return set(cache[key])

        reachable: set[str] = set()
        queue: collections.deque[str] = collections.deque([start_path])
        visited: set[str] = set()
        while queue and len(visited) < DT_INCLUDE_CLOSURE_MAX_FILES:
            path = queue.popleft()
            if path in visited:
                continue
            visited.add(path)
            if path.startswith("include/dt-bindings/"):
                reachable.add(path)

            text = self._tree_file_text(sha, path)
            if text is None:
                continue
            for include in sorted(self._include_paths(text)):
                resolved = None
                for candidate in self._include_candidate_paths(path, include):
                    if self._tree_file_text(sha, candidate) is not None:
                        resolved = candidate
                        break
                if resolved is None:
                    continue
                if resolved.startswith("include/dt-bindings/"):
                    reachable.add(resolved)
                if (
                    self._is_dt_source_path(resolved)
                    or resolved.startswith("include/dt-bindings/")
                ) and resolved not in visited:
                    queue.append(resolved)

        cache[key] = set(reachable)
        return reachable

    def _dt_binding_provider_reachable(
        self,
        sha: str,
        provider_path: str,
        use_paths: set[str] | None,
    ) -> bool:
        """Return whether a DT-binding provider is in a consumer include closure."""
        if not provider_path.startswith("include/dt-bindings/"):
            return True
        if use_paths is None:
            # Preserve the public helper's legacy behavior for callers that do not
            # provide per-symbol use paths. The planner itself always supplies them.
            return True
        if not use_paths:
            return False
        return any(
            provider_path in self.dt_binding_include_closure(sha, use_path)
            for use_path in use_paths
        )

    def _dt_binding_namespace_proof(
        self,
        sha: str,
        symbol: str,
        provider_path: str,
        use_paths: set[str] | None,
    ) -> dict[str, object] | None:
        """Return deterministic namespace proof for a DT-binding symbol provider.

        A provider under include/dt-bindings/ is namespace-verified only when the
        exact header is reachable from at least one changed file that added the
        symbol use.  Callers that omit per-symbol use paths retain legacy lookup
        behavior but do not manufacture a namespace proof.
        """
        if not provider_path.startswith("include/dt-bindings/") or use_paths is None:
            return None
        verified_use_paths = sorted(
            use_path
            for use_path in use_paths
            if provider_path in self.dt_binding_include_closure(sha, use_path)
        )
        if not verified_use_paths:
            return None
        return {
            "symbol": symbol,
            "provider_path": provider_path,
            "consumer_use_paths": verified_use_paths,
            "verification": "dt-include-closure",
        }

    @staticmethod
    def _include_aliases_for_path(path: str) -> set[str]:
        aliases = {path}
        if path.startswith("include/"):
            aliases.add(path[len("include/"):])
        marker = "/include/"
        if marker in path:
            aliases.add(path.split(marker, 1)[1])
        return aliases

    @staticmethod
    def _new_files_in_patch(patch: str) -> set[str]:
        result: set[str] = set()
        current: str | None = None
        for line in patch.splitlines():
            match = DIFF_FILE_RE.match(line)
            if match:
                current = match.group(2)
                continue
            if current and (line.startswith("new file mode ") or line == "--- /dev/null"):
                result.add(current)
        return result

    @staticmethod
    def _is_dt_source_path(path: str) -> bool:
        """Return True for source files that participate in the compiled DT graph."""
        return path.endswith((".dts", ".dtsi", ".dtso"))

    @staticmethod
    def _dt_compatible_strings(text: str) -> set[str]:
        """Return the most-specific compatible from each added DTS assignment.

        Device-tree compatible lists are ordered from most specific to fallback.
        Same-series binding evidence should follow the first value rather than
        treating a generic SoC fallback as proof that an unrelated binding patch
        is a prerequisite for a board or peripheral node.
        """
        result: set[str] = set()
        pattern = re.compile(
            r'\bcompatible\s*=\s*"([A-Za-z0-9][A-Za-z0-9,._+\-/]+)"'
        )
        for line in text.splitlines():
            match = pattern.search(line)
            if match:
                result.add(match.group(1))
        return result

    @staticmethod
    def _yaml_binding_compatible_candidates(text: str) -> set[str]:
        """Return specific compatibles introduced through binding-schema YAML.

        Arbitrary textual mentions such as descriptions and DTS snippets under
        ``examples:`` (``compatible = "..."``) are ignored.  For newly-added
        ``items:`` tuples, only the first item is treated as the specific device
        compatible; later tuple elements are fallback compatibles and are not
        provider evidence.

        This is intentionally a conservative lexical parser rather than a general
        YAML-schema evaluator.
        """
        result: set[str] = set()
        value_re = r"[A-Za-z0-9][A-Za-z0-9,._+\-/]+"
        const_re = re.compile(
            rf"^(?:-\s*)?const:\s*['\"]?({value_re})['\"]?\s*(?:#.*)?$"
        )
        scalar_re = re.compile(
            rf"^-\s*['\"]?({value_re})['\"]?\s*(?:#.*)?$"
        )
        inline_enum_re = re.compile(r"^(?:-\s*)?enum:\s*\[(.*?)\]\s*(?:#.*)?$")

        # Stack of newly-added ``items:`` sequence blocks.  Each frame tracks
        # the indentation of its immediate sequence items and which tuple item is
        # active.  Candidates beneath item 0 are specific; candidates beneath
        # later items are fallbacks.
        item_frames: list[dict[str, int | None]] = []
        for line in text.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            indent = len(line) - len(line.lstrip(" \t"))

            while item_frames and indent <= int(item_frames[-1]["indent"]):
                item_frames.pop()

            if stripped.startswith("-"):
                for frame in item_frames:
                    child_indent = frame["child_indent"]
                    if child_indent is None and indent > int(frame["indent"]):
                        frame["child_indent"] = indent
                        frame["index"] = 0
                    elif child_indent is not None and indent == child_indent:
                        frame["index"] = int(frame["index"] or 0) + 1

            specific = all(
                frame["index"] in (None, 0) for frame in item_frames
            )
            if specific:
                match = const_re.match(stripped) or scalar_re.match(stripped)
                if match:
                    value = match.group(1)
                    if "," in value:
                        result.add(value)
                else:
                    match = inline_enum_re.match(stripped)
                    if match:
                        for value in re.findall(
                            rf"['\"]({value_re})['\"]", match.group(1)
                        ):
                            if "," in value:
                                result.add(value)

            if re.match(r"^(?:-\s*)?items:\s*(?:#.*)?$", stripped):
                item_frames.append({
                    "indent": indent, "child_indent": None, "index": None
                })
        return result

    @staticmethod
    def _dt_property_uses(text: str) -> set[str]:
        ignored = {
            "compatible", "status", "reg", "ranges", "model", "phandle",
            "#address-cells", "#size-cells",
        }
        result: set[str] = set()
        for line in text.splitlines():
            match = re.match(
                r"^\s*([A-Za-z#][A-Za-z0-9,._+#-]*)\s*(?:=|;)", line
            )
            if match and match.group(1) not in ignored:
                result.add(match.group(1))
        return result

    @staticmethod
    def _yaml_property_definitions(text: str) -> set[str]:
        return set(
            re.findall(
                r"(?m)^\s{2,}([A-Za-z#][A-Za-z0-9,._+#-]*)\s*:\s*(?:$|[#|>{])",
                text,
            )
        )

    @staticmethod
    def _type_uses(text: str) -> set[tuple[str, str]]:
        return set(re.findall(r"\b(struct|enum)\s+([A-Za-z_][A-Za-z0-9_]*)\b", text))

    @staticmethod
    def _type_definitions(text: str) -> set[tuple[str, str]]:
        return set(
            re.findall(
                r"(?m)^\s*(struct|enum)\s+([A-Za-z_][A-Za-z0-9_]*)\b[^;\n]*\{",
                text,
            )
        )

    @staticmethod
    def _advisor_evidence_id(
        consumer_sha: str, peer_sha: str, kind: str, obj: str,
        selected_use: str, peer_provides: str,
    ) -> str:
        raw = "\0".join(
            (consumer_sha, peer_sha, kind, obj, selected_use, peer_provides)
        ).encode("utf-8")
        return "ev-" + hashlib.sha256(raw).hexdigest()[:16]

    def advisor_same_series_consumed_objects(self, sha: str) -> list[dict[str, str]]:
        """Find concrete lexical use/provision relationships with earlier peers.

        These records are deterministic advisor evidence only. They neither select
        nor promote a peer. Version 0.4.6 retains source paths on both sides of a
        relationship and suppresses architecture-local evidence when the selected
        use or provider belongs only to an unsupported product architecture. This
        also recognizes selected architecture-owned library subtrees such as
        lib/crypto/arm/ and lib/crypto/arm64/ rather than relying only on arch/*.
        Version 0.4.7 confines DTS-label providers/consumers to real DT source files
        and makes compatible evidence use specific DTS values plus binding-schema
        YAML additions rather than arbitrary binding example/documentation text.
        """
        allowed = self.advisor_allowed_prerequisite_peers(sha)
        if not allowed:
            return []

        selected_patch = self.patch_excerpt(sha, self.args.advisor_max_diff_chars)
        selected_added = self._added_patch_text(selected_patch)
        selected_files = self.nodes[sha].files or self.changed_files(sha)
        selected_added_by_file = self._added_patch_text_by_file(selected_patch)
        if not selected_added_by_file:
            if len(selected_files) == 1:
                selected_added_by_file = {selected_files[0]: selected_added}
            else:
                selected_added_by_file = {"": selected_added}

        selected_refs_by_path = {
            path: self._dts_label_references(text)
            for path, text in selected_added_by_file.items()
            if self._is_dt_source_path(path)
        }
        selected_macros_by_path = {
            path: self._macro_uses(text) - self._macro_definitions(text)
            for path, text in selected_added_by_file.items()
        }
        selected_defs_by_path = {
            path: self._function_definitions(text)
            for path, text in selected_added_by_file.items()
        }
        selected_calls_by_path = {
            path: self._function_calls(text) - selected_defs_by_path[path]
            for path, text in selected_added_by_file.items()
        }
        selected_includes_by_path = {
            path: self._include_paths(text)
            for path, text in selected_added_by_file.items()
        }
        selected_type_defs_by_path = {
            path: self._type_definitions(text)
            for path, text in selected_added_by_file.items()
        }
        selected_types_by_path = {
            path: self._type_uses(text) - selected_type_defs_by_path[path]
            for path, text in selected_added_by_file.items()
        }

        # Only product-relevant selected paths contribute DT binding evidence.
        selected_compatibles: set[str] = set()
        selected_dt_properties: set[str] = set()
        for selected_path, selected_text in selected_added_by_file.items():
            if (
                not self._advisor_path_product_relevant(selected_path)
                or not self._is_dt_source_path(selected_path)
            ):
                continue
            selected_compatibles.update(self._dt_compatible_strings(selected_text))
            selected_dt_properties.update(self._dt_property_uses(selected_text))

        # Build a same-series view of DT binding schemas before judging individual
        # peers. Binding series commonly add a compatible in one patch and extend
        # the same YAML schema with a property in the next. Exact binding-path
        # identity keeps this much narrower than matching generic property names.
        binding_compatible_sources: dict[str, dict[str, str]] = collections.defaultdict(dict)
        for series_peer_sha in allowed:
            series_peer_patch = self.patch_excerpt(
                series_peer_sha, self.args.advisor_max_peer_diff_chars
            )
            series_peer_binding_texts = self._added_patch_text_by_file(series_peer_patch)
            if not series_peer_binding_texts:
                binding_files = [
                    path for path in self.changed_files(series_peer_sha)
                    if path.startswith("Documentation/devicetree/bindings/")
                ]
                if len(binding_files) == 1:
                    series_peer_binding_texts = {
                        binding_files[0]: self._added_patch_text(series_peer_patch)
                    }
            for binding_path, binding_text in series_peer_binding_texts.items():
                if not binding_path.startswith("Documentation/devicetree/bindings/"):
                    continue
                binding_compatibles = self._yaml_binding_compatible_candidates(binding_text)
                for compat in sorted(selected_compatibles & binding_compatibles):
                    binding_compatible_sources[binding_path].setdefault(
                        compat, series_peer_sha
                    )

        evidence: list[dict[str, str]] = []
        seen: set[tuple[str, str, str]] = set()

        def add(
            peer_sha: str, kind: str, obj: str, selected_use: str,
            peer_provides: str, *, selected_path: str = "", provider_path: str = "",
        ) -> None:
            key = (peer_sha, kind, obj)
            if key in seen or len(evidence) >= 64:
                return
            seen.add(key)
            selected_arch = ",".join(sorted(self._path_architecture_dirs(selected_path)))
            provider_arch = ",".join(sorted(self._path_architecture_dirs(provider_path)))
            evidence.append({
                "evidence_id": self._advisor_evidence_id(
                    sha, peer_sha, kind, obj, selected_use, peer_provides
                ),
                "peer_sha": peer_sha,
                "peer_subject": self.subject(peer_sha),
                "kind": kind,
                "object": obj,
                "selected_use": selected_use,
                "peer_provides": peer_provides,
                "selected_path": selected_path,
                "provider_path": provider_path,
                "selected_architecture": selected_arch,
                "provider_architecture": provider_arch,
            })

        # Full-diff provider indexing can find cross-series bindings whose
        # excerpts are too short to expose their compatible lines. Retain
        # that independently verified evidence before the 64-record cap.
        coverage = getattr(self, "dt_binding_candidate_links", {}).get(sha, [])
        for record in coverage:
            compat = record["compatible"]
            selected_path = next((path for path, text in
                selected_added_by_file.items()
                if self._is_dt_source_path(path) and
                compat in self._dt_compatible_strings(text)), "")
            add(record["peer_sha"], "compatible-binding", compat,
                f'compatible = "{compat}"',
                f"binding schema adds compatible {compat}",
                selected_path=selected_path,
                provider_path=record["binding_path"])

        for peer_sha in allowed:
            peer_patch = self.patch_excerpt(peer_sha, self.args.advisor_max_peer_diff_chars)
            peer_added = self._added_patch_text(peer_patch)
            peer_added_by_file = self._added_patch_text_by_file(peer_patch)
            peer_files = self.changed_files(peer_sha)
            if not peer_added_by_file:
                if len(peer_files) == 1:
                    peer_added_by_file = {peer_files[0]: peer_added}
                else:
                    peer_added_by_file = {"": peer_added}

            peer_label_defs_by_path = {
                path: self._dts_label_definitions(text)
                for path, text in peer_added_by_file.items()
                if self._is_dt_source_path(path)
            }
            peer_macro_defs_by_path = {
                path: self._macro_definitions(text)
                for path, text in peer_added_by_file.items()
            }
            peer_function_defs_by_path = {
                path: self._function_definitions(text)
                for path, text in peer_added_by_file.items()
            }
            peer_function_decls_by_path = {
                path: self._function_declarations(text)
                for path, text in peer_added_by_file.items()
            }
            peer_type_defs_by_path = {
                path: self._type_definitions(text)
                for path, text in peer_added_by_file.items()
            }

            for selected_path, refs in selected_refs_by_path.items():
                if not self._advisor_path_product_relevant(selected_path):
                    continue
                for provider_path, definitions in peer_label_defs_by_path.items():
                    if not self._advisor_evidence_paths_compatible(selected_path, provider_path):
                        continue
                    for label in sorted(refs & definitions):
                        add(
                            peer_sha, "dts-label", label, f"&{label}",
                            f"{label}:",
                            selected_path=selected_path, provider_path=provider_path,
                        )

            for selected_path, macros in selected_macros_by_path.items():
                if not self._advisor_path_product_relevant(selected_path):
                    continue
                for provider_path, definitions in peer_macro_defs_by_path.items():
                    if not self._advisor_evidence_paths_compatible(selected_path, provider_path):
                        continue
                    for macro in sorted(macros & definitions):
                        add(
                            peer_sha, "macro", macro, macro,
                            f"#define {macro}",
                            selected_path=selected_path, provider_path=provider_path,
                        )

            # Function evidence is evaluated per selected-use path. A common
            # declaration can support a supported architecture implementation, but an
            # architecture-local implementation from an unsupported tree cannot.
            for selected_path in sorted(selected_added_by_file):
                if not self._advisor_path_product_relevant(selected_path):
                    continue
                calls = selected_calls_by_path.get(selected_path, set())
                defs = selected_defs_by_path.get(selected_path, set())
                for func in sorted(calls):
                    declaration_paths = sorted(
                        path for path, names in peer_function_decls_by_path.items()
                        if func in names
                        and self._advisor_evidence_paths_compatible(selected_path, path)
                    )
                    if declaration_paths:
                        path = declaration_paths[0]
                        add(
                            peer_sha, "function-declaration", func,
                            f"call to {func}(...)",
                            f"declaration of {func}(...) in {path}",
                            selected_path=selected_path, provider_path=path,
                        )
                        continue
                    definition_paths = sorted(
                        path for path, names in peer_function_defs_by_path.items()
                        if func in names
                        and self._advisor_evidence_paths_compatible(selected_path, path)
                    )
                    if definition_paths:
                        path = definition_paths[0]
                        add(
                            peer_sha, "function", func,
                            f"call to {func}(...)",
                            f"definition of {func}(...) in {path}",
                            selected_path=selected_path, provider_path=path,
                        )

                for func in sorted(defs):
                    declaration_paths = sorted(
                        path for path, names in peer_function_decls_by_path.items()
                        if func in names
                        and self._advisor_evidence_paths_compatible(selected_path, path)
                    )
                    if not declaration_paths:
                        continue
                    path = declaration_paths[0]
                    add(
                        peer_sha, "function-declaration", func,
                        f"definition of {func}(...)",
                        f"declaration of {func}(...) in {path}",
                        selected_path=selected_path, provider_path=path,
                    )

            peer_include_aliases: dict[str, str] = {}
            peer_new_files = self._new_files_in_patch(peer_patch)
            for path in peer_new_files:
                if not self._advisor_path_product_relevant(path):
                    continue
                for alias in self._include_aliases_for_path(path):
                    peer_include_aliases.setdefault(alias, path)
            for selected_path, includes in selected_includes_by_path.items():
                if not self._advisor_path_product_relevant(selected_path):
                    continue
                for include in sorted(includes & set(peer_include_aliases)):
                    provider_path = peer_include_aliases[include]
                    if not self._advisor_evidence_paths_compatible(selected_path, provider_path):
                        continue
                    add(
                        peer_sha, "included-file", include,
                        f"#include <{include}>", provider_path,
                        selected_path=selected_path, provider_path=provider_path,
                    )

            binding_peer = any(
                path.startswith("Documentation/devicetree/bindings/") for path in peer_files
            )
            if binding_peer:
                peer_binding_compatibles_by_path = {
                    path: self._yaml_binding_compatible_candidates(text)
                    for path, text in peer_added_by_file.items()
                    if path.startswith("Documentation/devicetree/bindings/")
                }
                for compat in sorted(selected_compatibles):
                    provider_path = next(
                        (
                            path for path, compatibles in peer_binding_compatibles_by_path.items()
                            if compat in compatibles
                        ),
                        "",
                    )
                    if not provider_path:
                        continue
                    add(
                        peer_sha, "compatible-binding", compat,
                        f'compatible = "{compat}"',
                        f"binding schema adds compatible {compat}",
                        provider_path=provider_path,
                    )

                for binding_path, binding_text in peer_added_by_file.items():
                    if not binding_path.startswith("Documentation/devicetree/bindings/"):
                        continue
                    peer_properties = self._yaml_property_definitions(binding_text)
                    if not peer_properties:
                        continue
                    compatible_sources = binding_compatible_sources.get(binding_path, {})
                    for compat in sorted(compatible_sources):
                        compat_peer_sha = (
                            peer_sha
                            if compat in peer_binding_compatibles_by_path.get(binding_path, set())
                            else compatible_sources[compat]
                        )
                        for prop in sorted(selected_dt_properties & peer_properties):
                            obj = f"{compat}:{prop}"
                            if compat_peer_sha == peer_sha:
                                kind = "dt-property-binding"
                                provides = (
                                    f"binding property {prop}: for compatible {compat} "
                                    f"in {binding_path}"
                                )
                            else:
                                kind = "dt-property-binding-series"
                                provides = (
                                    f"binding property {prop}: in {binding_path}; compatible "
                                    f"{compat} is established for the same schema by earlier "
                                    f"peer {compat_peer_sha[:12]}"
                                )
                            add(
                                peer_sha, kind, obj,
                                f"DTS property {prop} on compatible {compat}", provides,
                                provider_path=binding_path,
                            )

            for selected_path, selected_types in selected_types_by_path.items():
                if not self._advisor_path_product_relevant(selected_path):
                    continue
                for provider_path, definitions in peer_type_defs_by_path.items():
                    if not self._advisor_evidence_paths_compatible(selected_path, provider_path):
                        continue
                    for type_kind, name in sorted(selected_types & definitions):
                        add(
                            peer_sha, "type-definition", f"{type_kind} {name}",
                            f"use of {type_kind} {name}",
                            f"definition of {type_kind} {name} in {provider_path}",
                            selected_path=selected_path, provider_path=provider_path,
                        )

            if len(evidence) >= 64:
                break

        return evidence[:64]

    def advisor_prerequisite_evidence(self, sha: str) -> list[dict[str, str]]:
        """Return deterministic evidence eligible to support prerequisite output."""
        return self.advisor_same_series_consumed_objects(sha)

    def advisor_inbound_take_recommendations(self, sha: str) -> list[dict[str, str]]:
        node = self.nodes.get(sha)
        if node is None:
            return []
        return [
            dict(item) for item in node.advisor_recommended_by
            if item.get("consumer_decision") == "TAKE"
        ]

    def advisor_related_commit_context(self, sha: str, *, depth: int, requires_sha: str) -> dict:
        node = self.nodes.get(sha)
        files = (node.files if node and node.files else self.changed_files(sha))
        data = {
            "depth": depth,
            "sha": sha,
            "subject": self.subject(sha),
            "provenance_child_sha": requires_sha,
            "relationship_status": "provenance_only",
            "changed_files": files,
            "scope": self.advisor_scope_context(files),
            "patch_excerpt": self.patch_excerpt(sha, self.args.advisor_max_related_diff_chars),
        }
        if node is not None:
            data.update({
                "direct": node.direct,
                "dependency_kind": self.dependency_kind(node),
                "evidence": sorted(node.reasons),
                "replay": node.replay,
                "conflict_files": node.conflict_files,
                "advisor_decision": node.advisor_decision,
                "advisor_error": node.advisor_error,
            })
        return data

    def advisor_required_by_context(self, sha: str) -> list[dict]:
        max_depth = max(0, self.args.advisor_required_by_depth)
        max_commits = max(0, self.args.advisor_max_related_commits)
        if max_depth == 0 or max_commits == 0:
            return []
        result: list[dict] = []
        queue = collections.deque((parent, 1, sha) for parent in sorted(self.nodes[sha].required_by))
        seen: set[str] = set()
        while queue and len(result) < max_commits:
            parent, depth, child = queue.popleft()
            if parent in seen or depth > max_depth:
                continue
            seen.add(parent)
            result.append(self.advisor_related_commit_context(parent, depth=depth, requires_sha=child))
            parent_node = self.nodes.get(parent)
            if parent_node is not None and depth < max_depth:
                queue.extend(
                    (grandparent, depth + 1, parent)
                    for grandparent in sorted(parent_node.required_by)
                )
        return result

    def advisor_packet(self, sha: str) -> dict:
        self._audit_dt_binding_candidates(sha)
        n = self.nodes[sha]
        fixes = [
            {"sha": fixed, "subject": self.subject(fixed)}
            for fixed in sorted(n.fixes)
        ]
        files = n.files or self.changed_files(sha)
        all_missing_earlier_peers = self.advisor_allowed_prerequisite_peers(sha)
        consumed_objects = self.advisor_prerequisite_evidence(sha)
        n.advisor_consumed_objects = consumed_objects
        evidence_backed_peers = list(dict.fromkeys(
            item["peer_sha"] for item in consumed_objects
        ))
        inbound_take = self.advisor_inbound_take_recommendations(sha)
        scope = self.advisor_scope_context(files)
        obsolescence = self.advisor_obsolescence_context(sha, files)
        reasons = sorted(n.reasons)
        symbol_only_dependency = bool(
            not n.direct
            and reasons
            and all(reason.startswith("symbol:") for reason in reasons)
        )
        dt_binding_header_only = bool(
            files and all(path.startswith("include/dt-bindings/") for path in files)
        )
        namespace_proofs = sorted(
            n.symbol_dependency_proofs,
            key=lambda item: (
                str(item.get("symbol", "")),
                str(item.get("provider_path", "")),
                str(item.get("consumer_sha", "")),
            ),
        )
        symbol_reason_names = {
            reason.split(":", 1)[1]
            for reason in reasons
            if reason.startswith("symbol:") and ":" in reason
        }
        namespace_verified_symbols = {
            str(item.get("symbol"))
            for item in namespace_proofs
            if item.get("verification") == "dt-include-closure" and item.get("symbol")
        }
        dt_binding_namespace_verified = bool(
            symbol_only_dependency
            and symbol_reason_names
            and symbol_reason_names <= namespace_verified_symbols
        )
        default_bias = "NEUTRAL"
        if scope["unsupported_architecture_only"]:
            default_bias = (
                "RECONCILE_UNSUPPORTED_ARCHITECTURE_INBOUND"
                if inbound_take else "SKIP_UNSUPPORTED_ARCHITECTURE_ONLY"
            )
        elif (
            not n.direct
            and obsolescence["all_changed_files_deleted_by_take_consumers"]
            and not inbound_take
        ):
            default_bias = "SKIP_OBSOLETED_BY_TAKE_CONSUMER"
        elif (
            symbol_only_dependency
            and dt_binding_namespace_verified
            and not inbound_take
        ):
            default_bias = "TRUST_DT_BINDING_NAMESPACE_PROOF"
        elif symbol_only_dependency and dt_binding_header_only and not inbound_take:
            default_bias = "REQUIRE_SEMANTIC_PROOF_FOR_DT_BINDING_SYMBOL"
        elif n.direct and scope["touches_focus_paths"]:
            default_bias = "TAKE_UNLESS_CONCRETE_EXCLUSION"
        return {
            "planning_context": {
                "base": self.base,
                "target": self.target,
                "downstream": self.downstream,
                "downstream_ref": self.downstream_ref,
                "focus_paths": self.paths,
                "product": self.advisor_product_context(),
                "policy": (
                    "Prefer upstream alignment and low downstream divergence. For direct commits in "
                    "the requested focus paths that are not excluded by configured product architecture "
                    "policy, lack of affirmative evidence that a particular device, platform, SoC, or "
                    "peripheral is an officially supported product target is not an exclusion reason; "
                    "prefer TAKE when there is no concrete exclusion reason. Do not carry architecture-"
                    "only code for an unsupported product architecture merely because provenance or a "
                    "shared symbol name caused the deterministic planner to connect it to a selected commit."
                ),
            },
            "commit": {
                "sha": sha,
                "subject": n.subject,
                "message": self._truncate_text(self.body(sha), self.args.advisor_max_message_chars),
                "changed_files": files,
                "scope": scope,
                "default_policy_bias": default_bias,
                "patch_excerpt": self.patch_excerpt(sha, self.args.advisor_max_diff_chars),
                "direct": n.direct,
                "dependency_kind": self.dependency_kind(n),
                "evidence": reasons,
                "dependency_policy": {
                    "symbol_only_dependency": symbol_only_dependency,
                    "dt_binding_header_only": dt_binding_header_only,
                    "dt_binding_namespace_verified": dt_binding_namespace_verified,
                    "dt_binding_namespace_proofs": namespace_proofs,
                    "note": (
                        "The DT-binding namespace is deterministically verified: the planner observed "
                        "the symbol use in the listed consumer file(s) and confirmed that the exact "
                        "provider header is reachable through the bounded DT include closure. This "
                        "proof remains valid even when a truncated advisor patch excerpt omits the "
                        "symbol-use line."
                        if dt_binding_namespace_verified else
                        "A symbol-only deterministic dependency is provenance, not semantic proof. "
                        "DT binding clock/reset/ID macro names can be namespace-local and reused by "
                        "unrelated hardware; require concrete same-API/schema/hardware evidence before TAKE."
                    ),
                },
                "obsolescence": obsolescence,
                "deterministic_consumer_context": {
                    "relationship_status": "provenance_only",
                    "note": (
                        "These commits are connected by deterministic discovery provenance. "
                        "They are not inbound advisor prerequisite recommendations."
                    ),
                    "consumers": self.advisor_required_by_context(sha),
                },
                "fixes": fixes,
                "replay": n.replay,
                "conflict_files": n.conflict_files,
                "merge_risk": n.merge_risk,
                "same_series": self.advisor_series_context(sha),
                "same_series_consumed_objects": consumed_objects,
                "eligible_prerequisite_evidence": consumed_objects,
                "binding_coverage_candidates": list(getattr(
                    self, "dt_binding_candidate_links", {}).get(sha, [])),
                "verified_missing_dt_include_requirements": (
                    self._advisor_hard_dt_include_facts(sha)),
                "deterministic_dt_include_requirements": [
                    {"include_path": reason[len("dt-include:"):],
                     "take_consumer_shas": sorted(
                         parent for parent in n.required_by
                         if parent in self.nodes and
                         self.nodes[parent].advisor_decision == "TAKE")}
                    for reason in sorted(n.reasons)
                    if reason.startswith("dt-include:")
                ],
                "eligible_prerequisite_peer_shas": evidence_backed_peers,
                "all_missing_earlier_peer_shas": all_missing_earlier_peers,
                "actual_inbound_take_prerequisites": inbound_take,
                "actual_inbound_take_prerequisite_count": len(inbound_take),
            },
        }

    def advisor_policy_override(self, sha: str, packet: dict) -> dict | None:
        """Return a deterministic advisor result for unambiguous exclusions.

        The model is useful for ambiguous semantic judgments, but two product-policy
        cases are sufficiently mechanical that making them temperature-sensitive only
        adds variance: code confined to an unsupported product architecture, and an
        older dependency whose complete changed-file set is deleted by an immediate
        already-TAKE consumer. If a TAKE consumer has made an explicit evidence-bound
        inbound prerequisite recommendation, leave the case to normal advisor
        reconciliation instead of overriding it.
        """
        commit = packet["commit"]
        if commit.get("actual_inbound_take_prerequisite_count", 0):
            return None
        scope = commit.get("scope") or {}
        if scope.get("unsupported_architecture_only"):
            archs = ", ".join(scope.get("architecture_dirs") or []) or "unknown"
            product = packet["planning_context"]["product"].get("product", "configured product")
            return {
                "decision": "SKIP",
                "rationale": (
                    f"Deterministic product-policy exclusion: this commit changes only "
                    f"architecture-owned paths for unsupported kernel architecture(s) {archs} "
                    f"under {product}, and no evidence-bound inbound TAKE prerequisite requires it."
                ),
                "prerequisite_peers": [],
                "inbound_prerequisite_assessments": [],
                "risks": [],
            }
        obsolescence = commit.get("obsolescence") or {}
        if (
            not commit.get("direct")
            and obsolescence.get("all_changed_files_deleted_by_take_consumers")
        ):
            consumers = ", ".join(
                item.get("sha", "")[:12]
                for item in obsolescence.get("take_consumers", [])
                if item.get("sha")
            ) or "an immediate TAKE consumer"
            return {
                "decision": "SKIP",
                "rationale": (
                    "Deterministic obsolescence exclusion: every file changed by this dependency "
                    f"is deleted by immediate already-TAKE consumer(s) {consumers}, and no "
                    "evidence-bound inbound TAKE prerequisite requires preserving the intermediate change."
                ),
                "prerequisite_peers": [],
                "inbound_prerequisite_assessments": [],
                "risks": [],
            }
        return None

    def advisor_system_prompt(self) -> str:
        return """You are the advisory layer of kernel-backport-planner, reviewing Linux
kernel commits for an enterprise downstream backport plan. The deterministic planner has
already gathered candidates and provenance. Your job is to recommend TAKE, SKIP, or REVIEW;
you do not execute Git operations and you must not invent evidence.

Evidence discipline:
- Treat repository/tool data in the packet as verified evidence. Clearly base your decision on it.
- Do not invent commits, symbols, functions, source paths, product support, command results, or tests.
- Use REVIEW only for a *specific* unresolved technical or dependency question
  that could change selection or make this commit unsafe. Name that question in
  the rationale, with the missing evidence. Ordinary lack of product relevance
  or affirmative hardware support is NOT material uncertainty here.

Maintenance policy:
- Upstream convergence is an explicit maintenance goal. Prefer TAKE for commits in the requested
  focus area, required common/supporting code, and clean upstream context when there is no concrete
  reason to exclude them. Immediate end-user feature relevance is not required.
- For a change in a supported architecture or a supporting dependency, start with TAKE.
  Ask whether the supplied evidence establishes a *concrete exclusion* or a
  specific unresolved semantic hazard. "Does this board have official RHEL
  support?" and "Is this feature beneficial for a product SKU?" are NOT
  questions that need answering for upstream convergence.
- When commit.default_policy_bias is TAKE_UNLESS_CONCRETE_EXCLUSION, TAKE is the default. Do NOT
  SKIP or REVIEW merely because the packet lacks evidence that a particular board, laptop, SoC,
  or peripheral is an officially supported product platform. Absence of such product-target evidence is not
  a technical uncertainty and is not an exclusion reason.
  Apply this uniformly to direct commits in any requested focus path; do not give
  ARM64, Device Tree, or any other subsystem a special policy merely because it appears in examples.
- When commit.default_policy_bias is SKIP_UNSUPPORTED_ARCHITECTURE_ONLY, the candidate changes only
  code owned by an architecture excluded by the configured product profile. Deterministic consumer
  provenance or a shared symbol name does not make that code part of a supported architecture build.
- When commit.default_policy_bias is RECONCILE_UNSUPPORTED_ARCHITECTURE_INBOUND, the same product
  exclusion applies but a TAKE consumer has made an explicit evidence-bound inbound recommendation.
  Assess that evidence under the inbound-prerequisite rules instead of skipping or taking blindly.
- When commit.default_policy_bias is SKIP_OBSOLETED_BY_TAKE_CONSUMER, an immediate already-TAKE
  consumer deletes every file changed by this older dependency. Do not TAKE the older change merely
  to preserve historical sequence; absent an explicit evidence-bound inbound requirement, it has no
  surviving final-state effect.
- When commit.default_policy_bias is TRUST_DT_BINDING_NAMESPACE_PROOF, deterministic discovery has
  already observed the symbol use in the listed consumer file(s), followed the bounded DT include
  graph, and confirmed that the exact provider header is reachable. Treat that namespace relationship
  as established evidence. Do NOT choose REVIEW or SKIP merely because the bounded consumer patch
  excerpt does not happen to contain the symbol-use line; the proof is computed from the full selected
  tree/diff context outside the excerpt. Prefer TAKE unless some other concrete exclusion applies.
- When commit.default_policy_bias is REQUIRE_SEMANTIC_PROOF_FOR_DT_BINDING_SYMBOL, the dependency is
  an unverified/legacy symbol-name relationship in DT binding headers. Clock, reset, interrupt, and
  other binding ID names can be namespace-local and reused by unrelated SoCs/controllers. TAKE only if
  the supplied paths/diffs demonstrate the same binding/API/hardware namespace; a matching macro name
  alone is not enough.
- Product architecture support is explicit in planning_context.product. Architecture-owned code
  for an unsupported product architecture should normally be SKIP unless concrete diff/graph
  evidence shows that code built for a supported product architecture actually depends on it.
  Architecture ownership can also appear outside arch/*, for example lib/crypto/arm/ versus
  lib/crypto/arm64/.
- A deterministic [DEPENDENCY] edge is evidence about textual/symbol/provenance relationships,
  not proof that an unsupported architecture's implementation belongs in the product. Identical
  symbol names can exist independently in different architecture trees.
- commit.deterministic_consumer_context is provenance-only context supplied consumer-first and can
  include multiple graph levels. It is NOT an inbound prerequisite recommendation. Use its changed
  files, scope, diff excerpts, and deterministic evidence only to understand why the deterministic
  planner connected commits. Another advisor decision is context, not verified evidence.
- commit.binding_coverage_candidates are exact compatible additions found by scanning
  upstream binding YAML patch additions, including candidates outside the same series.
  They are *not* automatically mandatory. For TAKE, classify each provided eligible
  compatible-binding evidence ID as REQUIRED or NOT_REQUIRED with a technical reason;
  check downstream schema state and avoid support-status conjecture.
- commit.deterministic_dt_include_requirements lists exact DTS/DTSI source paths
  that TAKE consumers need, based on full-file include resolution. An included
  source absent from downstream is a build dependency, not merely product policy.
  Prefer TAKE for a verified provider unless there is concrete incompatibility;
  never dismiss it solely because the device is not officially supported.
- commit.actual_inbound_take_prerequisites is the only field containing concrete prerequisite
  recommendations already made by TAKE consumers. If actual_inbound_take_prerequisite_count is 0,
  there are NO inbound TAKE prerequisite recommendations. Never infer one from deterministic
  consumer provenance, a DEPENDENCY edge, a shared symbol name, or prose in another field.
- SKIP only for a concrete exclusion reason supported by the packet: unsupported architecture-only
  code without a real cross-tree dependency, a known absent/inappropriate feature, obsolete/reverted
  code, or meaningful integration/risk cost that outweighs convergence. Do not invent product
  hardware-support policy that is not present in the evidence.
- REVIEW must identify a specific semantic, build, dependency, safety, or
  compatibility question that cannot be resolved from the supplied evidence.
  Generic phrases like "requires manual review", "potential integration risks",
  "not proven necessary", and "not officially supported" do NOT qualify.
- Example: A new arm64 board DTS with no proven product SKU support and no
  concrete technical exclusion is TAKE, not REVIEW.
- Example: A shared OF/FDT API adjustment affecting supported architectures
  is TAKE despite no product-specific benefit statement, unless the evidence
  shows a particular technical hazard.
- Example: A consumer uses a symbol whose provider's namespace is uncertain;
  that concrete unresolved relationship can justify REVIEW.
- Use REVIEW when evidence is materially ambiguous. Do not turn uncertainty into confident prose.
- replay: conflict is an integration-cost signal, not by itself a reason for REVIEW or SKIP. Judge
  whether the commit belongs in the desired backport independently from how hard it may be to apply.
  For a wanted commit, report an ordinary textual conflict as a risk while still choosing TAKE. Use
  REVIEW for a conflict only when the supplied conflict/diff evidence creates genuine semantic
  uncertainty about whether the upstream change belongs or can be reconciled safely.
- Replay cleanliness is not proof that a full kernel build will succeed.

Same-series prerequisite policy:
- prerequisite_evidence_ids is evidence-bound. Every recommendation MUST be one evidence_id from
  commit.eligible_prerequisite_evidence. Do not return peer SHAs or prerequisite prose; the planner
  deterministically maps each evidence ID back to its peer commit and evidence record.
- commit.eligible_prerequisite_evidence is deterministic lexical evidence
  produced by the planner. An optional same_series_consumed_objects field may
  duplicate it and can be omitted solely to conserve context. Records can include selected_path/provider_path and
  selected_architecture/provider_architecture so architecture-local name matches are not mistaken
  for shared prerequisites. Evidence kinds can include DTS labels, macros,
  function definitions/declarations, included headers, compatible strings matched to DT bindings,
  compatible-scoped DT properties matched to those bindings (including same-schema binding-series
  evidence where one earlier peer establishes the compatible and another adds the property), and
  struct/enum definitions. DTS-label evidence is limited to real .dts/.dtsi/.dtso sources; labels
  appearing only in binding YAML examples are documentation, not providers. Compatible-binding
  evidence follows the first, most-specific compatible in a DTS assignment and requires schema-like
  YAML additions rather than arbitrary mentions in examples or descriptions.
- If commit.binding_conflict_context is present, another TAKE commit assessed
  this exact binding relationship REQUIRED while this provider previously
  assessed it NOT_REQUIRED. Reexamine the explicit evidence and report a
  technically grounded inbound disposition. Do not assume an existing schema
  defines the same compatible merely because the SoC family is supported.
- A deterministic_dt_include_requirements source file is a hard source
  dependency when a TAKE consumer includes the file and that file is absent
  downstream. Do not conflate this with optional YAML schema completeness.
  A binding schema merely matching a compatible cannot supply a DTSI file.
- NOT_REQUIRED binding assessments claiming an exact compatible is already
  covered must identify the downstream YAML schema and basis for coverage.
  A compatible declared in a DTS is not itself binding-schema coverage.
- For every compatible-binding or dt-property-binding evidence record on a TAKE,
  return exactly one binding_evidence_assessments entry keyed by its evidence_id.
  REQUIRED means the schema patch must accompany this commit for the chosen
  integration scope, and its evidence_id MUST also be in prerequisite_evidence_ids.
  NOT_REQUIRED means the binding is not necessary for this backport; give an
  evidence-specific technical reason. "Not officially supported" and silence
  are NOT valid reasons. Binding-schema completeness can matter even when dtc
  itself does not require the binding. For SKIP/REVIEW, return an empty list.
- Recommend a peer only when one of these evidence records is a real semantic prerequisite for the
  selected patch. Choose one strongest evidence record per peer. Do not recommend a peer merely
  because it is in commit.all_missing_earlier_peer_shas.
- Mere adjacency, earlier patch number, same series, touching the same file/subsystem, documentation
  completeness, or vague statements such as 'may be required' are NOT sufficient.
- Return at most one evidence ID per peer, choosing the strongest record that demonstrates why the
  peer must accompany the selected patch. If your decision is SKIP, return no prerequisite evidence
  IDs; a skipped commit does not need its own prerequisite recommendation chain.

Inbound prerequisite consistency:
- commit.actual_inbound_take_prerequisites contains concrete prerequisite recommendations already
  made by TAKE consumers. For every such evidence_id, return exactly one inbound_prerequisite_assessment.
- disposition REQUIRED means this candidate patch is still needed as a commit unit to satisfy that
  TAKE consumer. A SKIP decision is invalid if any inbound assessment is REQUIRED.
- disposition NOT_REQUIRED is allowed only when the supplied evidence shows why the consumer's
  earlier prerequisite recommendation is unnecessary or satisfied elsewhere. State that concrete
  reason; do not dismiss it merely because this candidate is in an unsupported architecture tree.
- If the inbound recommendation cannot be confidently reconciled, use REVIEW rather than SKIP.

The response must match the supplied JSON schema. Keep rationale concise and technical.
"""

    @staticmethod
    def _match_peer_sha(value: str, allowed: set[str]) -> str | None:
        value = value.strip().lower()
        matches = [sha for sha in allowed if sha.startswith(value)]
        return matches[0] if len(matches) == 1 else None

    def _advisor_binding_claim_feedback(self, evidence: dict, reason: str) -> str | None:
        if evidence.get("kind") != "compatible-binding":
            return None
        path = evidence.get("provider_path", "")
        compatible = evidence.get("object", "")
        if not (path.startswith("Documentation/devicetree/bindings/")
                and path.endswith((".yaml", ".yml")) and compatible):
            return None
        downstream_text = self._tree_file_text(self.replay_start, path)
        exact = (self._yaml_binding_compatible_candidates(downstream_text)
                 if downstream_text is not None else set())
        return binding_claim_feedback(reason, compatible, downstream_text,
                                      path, exact)

    def _advisor_hard_dt_include_facts(self, sha: str) -> list[dict]:
        """Prove missing .dts/.dtsi source includes needed by TAKE consumers.

        No assumptions about optional YAML schemas or build success follow.
        """
        node = self.nodes[sha]
        facts: list[dict] = []
        for reason in sorted(node.reasons):
            if not hasattr(self, "replay_start"):
                break
            if not reason.startswith("dt-include:"):
                continue
            path = reason.split(":", 1)[1]
            if (not self._is_dt_source_path(path)
                    or self._tree_file_text(self.replay_start, path) is not None
                    or self._tree_file_text(sha, path) is None):
                continue
            consumers = sorted(parent for parent in node.required_by
                               if parent in self.nodes and
                               self.nodes[parent].advisor_decision == "TAKE")
            if consumers:
                facts.append({"include_path": path,
                              "take_consumer_shas": consumers,
                              "downstream_file": "absent",
                              "provider_file": "present"})
        return facts

    def validate_advisor_result(self, sha: str, result: dict) -> dict:
        if not isinstance(result, dict):
            raise AdvisorError(
                "advisor result is not an object", kind="invalid-response", retryable=True
            )
        decision = result.get("decision")
        if decision not in {"TAKE", "SKIP", "REVIEW"}:
            raise AdvisorError(
                f"invalid advisor decision: {decision!r}",
                kind="invalid-response",
                retryable=True,
            )
        rationale = result.get("rationale")
        if not isinstance(rationale, str) or not rationale.strip():
            raise AdvisorError(
                "advisor rationale is missing", kind="invalid-response", retryable=True
            )
        raw_prereq_ids = result.get("prerequisite_evidence_ids", [])
        raw_inbound = result.get("inbound_prerequisite_assessments", [])
        raw_risks = result.get("risks", [])
        if not isinstance(raw_prereq_ids, list) or not isinstance(raw_inbound, list) or not isinstance(raw_risks, list):
            raise AdvisorError(
                "advisor prerequisite_evidence_ids/inbound_prerequisite_assessments/risks must be arrays",
                kind="invalid-response",
                retryable=True,
            )

        evidence = self.advisor_prerequisite_evidence(sha)
        evidence_by_id = {item["evidence_id"]: item for item in evidence}
        prereqs: list[dict[str, str]] = []
        seen_ids: set[str] = set()
        seen_peers: set[str] = set()
        for evidence_id in ([] if decision == "SKIP" else raw_prereq_ids):
            if not isinstance(evidence_id, str):
                raise AdvisorError(
                    "advisor prerequisite evidence ID is not a string",
                    kind="invalid-response",
                    retryable=True,
                )
            if evidence_id in seen_ids:
                continue
            seen_ids.add(evidence_id)
            evidence_item = evidence_by_id.get(evidence_id)
            if evidence_item is None:
                raise AdvisorError(
                    f"advisor proposed prerequisite without eligible deterministic evidence: "
                    f"evidence_id={evidence_id!r}",
                    kind="invalid-prerequisite",
                    retryable=True,
                )
            peer_sha = evidence_item["peer_sha"]
            # Multiple evidence records can point to one peer. Keep the first model-
            # selected record rather than failing the whole response for redundancy.
            if peer_sha in seen_peers:
                continue
            seen_peers.add(peer_sha)
            reason = (
                f"{evidence_item['kind']}:{evidence_item['object']}: selected patch uses/provides "
                f"{evidence_item['selected_use']}; peer provides {evidence_item['peer_provides']}"
            )
            prereqs.append({
                "sha": peer_sha,
                "evidence_id": evidence_id,
                "evidence_kind": evidence_item["kind"],
                "evidence_object": evidence_item["object"],
                "reason": reason,
            })

        # All binding evidence on a TAKE must be explicitly disposed of.
        # A compatible binding is generally schema completeness rather than
        # a hard dtc requirement, so NOT_REQUIRED is permitted with a reason.
        binding_ids = {
            item["evidence_id"] for item in evidence
            if item["kind"] in ("compatible-binding", "dt-property-binding")
        }
        raw_binding = result.get("binding_evidence_assessments", [])
        if not isinstance(raw_binding, list):
            raise AdvisorError("binding evidence assessments must be an array",
                               kind="invalid-response", retryable=True)
        binding_assessments = []
        used_binding_ids = set()
        for item in raw_binding:
            if not isinstance(item, dict):
                raise AdvisorError("invalid binding evidence assessment",
                                   kind="invalid-response", retryable=True)
            evidence_id = item.get("evidence_id")
            disposition = item.get("disposition")
            reason = item.get("reason")
            if (evidence_id not in binding_ids or evidence_id in used_binding_ids
                    or disposition not in ("REQUIRED", "NOT_REQUIRED")
                    or not isinstance(reason, str) or not reason.strip()):
                raise AdvisorError("invalid/duplicate binding evidence disposition",
                                   kind="invalid-response", retryable=True)
            if (disposition == "NOT_REQUIRED"
                    and _PRODUCT_SUPPORT_OBJECTION.search(reason)
                    and _ABSENCE_OF_PRODUCT_EVIDENCE.search(reason)
                    and not _CONCRETE_TECHNICAL_OBJECTION.search(reason)):
                raise AdvisorError(
                    "binding NOT_REQUIRED disposition relies only on missing "
                    "official product support; give a technical reason",
                    kind="binding-unassessed", retryable=True)
            if disposition == "NOT_REQUIRED":
                feedback = self._advisor_binding_claim_feedback(
                    evidence_by_id[evidence_id], reason)
                if feedback:
                    raise AdvisorError(
                        "binding NOT_REQUIRED source claim unverified: " + feedback,
                        kind="binding-source-claim", retryable=True)
            used_binding_ids.add(evidence_id)
            binding_assessments.append({
                "evidence_id": evidence_id,
                "disposition": disposition,
                "reason": reason.strip(),
            })
        if decision == "TAKE" and used_binding_ids != binding_ids:
            raise AdvisorError(
                "TAKE omits explicit binding evidence dispositions: "
                + ", ".join(sorted(binding_ids - used_binding_ids)),
                kind="binding-unassessed", retryable=True)
        required_binding = {item["evidence_id"] for item in binding_assessments
                            if item["disposition"] == "REQUIRED"}
        if decision == "TAKE" and required_binding - set(seen_ids):
            raise AdvisorError(
                "binding evidence marked REQUIRED without prerequisite selection: "
                + ", ".join(sorted(required_binding - set(seen_ids))),
                kind="binding-unassessed", retryable=True)
        if decision == "TAKE" and (set(seen_ids) & binding_ids) - required_binding:
            raise AdvisorError(
                "binding prerequisite selected but not assessed REQUIRED",
                kind="binding-unassessed", retryable=True)

        inbound_recommendations = self.advisor_inbound_take_recommendations(sha)
        inbound_by_id = {
            item["evidence_id"]: item
            for item in inbound_recommendations
            if item.get("evidence_id")
        }
        inbound_assessments: list[dict[str, str]] = []
        seen_inbound_ids: set[str] = set()
        for item in raw_inbound:
            if not isinstance(item, dict):
                raise AdvisorError(
                    "advisor inbound prerequisite assessment is not an object",
                    kind="invalid-response",
                    retryable=True,
                )
            evidence_id = item.get("evidence_id")
            disposition = item.get("disposition")
            reason = item.get("reason")
            if (
                not isinstance(evidence_id, str)
                or disposition not in {"REQUIRED", "NOT_REQUIRED"}
                or not isinstance(reason, str)
                or not reason.strip()
            ):
                raise AdvisorError(
                    "advisor inbound assessment lacks evidence_id/disposition/reason",
                    kind="invalid-response",
                    retryable=True,
                )
            if evidence_id not in inbound_by_id or evidence_id in seen_inbound_ids:
                raise AdvisorError(
                    f"advisor returned invalid/duplicate inbound evidence_id {evidence_id!r}",
                    kind="invalid-response",
                    retryable=True,
                )
            seen_inbound_ids.add(evidence_id)
            inbound_assessments.append({
                "evidence_id": evidence_id,
                "disposition": disposition,
                "reason": reason.strip(),
            })

        expected_inbound_ids = set(inbound_by_id)
        if seen_inbound_ids != expected_inbound_ids:
            missing = sorted(expected_inbound_ids - seen_inbound_ids)
            extra = sorted(seen_inbound_ids - expected_inbound_ids)
            raise AdvisorError(
                f"advisor inbound assessments do not exactly cover TAKE-consumer recommendations "
                f"(missing={missing}, extra={extra})",
                kind="invalid-response",
                retryable=True,
            )
        if decision == "SKIP" and any(
            item["disposition"] == "REQUIRED" for item in inbound_assessments
        ):
            raise AdvisorError(
                "advisor returned SKIP while marking an inbound TAKE-consumer prerequisite REQUIRED",
                kind="invalid-response",
                retryable=True,
            )

        risks = [x.strip() for x in raw_risks if isinstance(x, str) and x.strip()]
        return {
            "decision": decision,
            "rationale": rationale.strip(),
            # Persist the original evidence IDs as well as resolved peer data,
            # so cached normalized results can be validated again on reuse.
            "prerequisite_evidence_ids": [x for x in raw_prereq_ids
                                           if isinstance(x, str)] if decision != "SKIP" else [],
            "prerequisite_peers": prereqs,
            "binding_evidence_assessments": binding_assessments,
            "inbound_prerequisite_assessments": inbound_assessments,
            "risks": risks,
        }

    def advisor_cache_key(self, sha: str, packet: dict) -> str:
        fingerprint = json.dumps(
            {
                "prompt_version": ADVISOR_PROMPT_VERSION,
                "model": getattr(self, "advisor_model", None),
                "base": self.base,
                "target": self.target,
                "downstream": self.downstream,
                "packet": packet,
            },
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
        return sha + ":" + hashlib.sha256(fingerprint).hexdigest()

    def save_advisor_cache(self) -> None:
        if not self.advisor_cache_path or self.args.no_advisor_cache:
            return
        self.advisor_cache_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.advisor_cache_path.with_name(self.advisor_cache_path.name + ".tmp")
        tmp.write_text(json.dumps(self.advisor_cache, indent=2, sort_keys=True) + "\n")
        os.replace(tmp, self.advisor_cache_path)

    def advisor_distance_to_direct(
        self, sha: str, memo: dict[str, int], visiting: set[str] | None = None
    ) -> int:
        if sha in memo:
            return memo[sha]
        node = self.nodes.get(sha)
        if node is None:
            return 10_000
        if node.direct:
            memo[sha] = 0
            return 0
        visiting = set() if visiting is None else visiting
        if sha in visiting:
            return 10_000
        visiting.add(sha)
        distances = [
            1 + self.advisor_distance_to_direct(parent, memo, visiting.copy())
            for parent in node.required_by
            if parent in self.nodes and self.is_actionable_node(self.nodes[parent])
        ]
        distance = min(distances) if distances else 10_000
        memo[sha] = distance
        return distance

    def advisor_order(self, ordered: Sequence[str]) -> list[str]:
        """Advise consumers before deeper prerequisites while preserving stable order."""
        index = {sha: pos for pos, sha in enumerate(ordered)}
        memo: dict[str, int] = {}
        return sorted(
            ordered,
            key=lambda sha: (self.advisor_distance_to_direct(sha, memo), index[sha]),
        )

    def _write_advisor_error_diagnostic(
        self,
        sha: str,
        attempt: int,
        exc: AdvisorError,
        raw_result: object | None = None,
    ) -> None:
        path = getattr(self, "advisor_error_log_path", None)
        if path is None:
            return
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
        except OSError as log_exc:
            self.info(f"Could not create advisor error-log directory {path.parent}: {log_exc}")
            return
        raw_response = exc.raw_response
        if raw_response is not None:
            raw_response = self._truncate_text(raw_response, 4096)
        raw_result_text = None
        if raw_result is not None:
            try:
                raw_result_text = json.dumps(raw_result, sort_keys=True, ensure_ascii=False)
            except (TypeError, ValueError):
                raw_result_text = repr(raw_result)
            raw_result_text = self._truncate_text(raw_result_text, 4096)
        entry = {
            "sha": sha,
            "subject": self.nodes[sha].subject,
            "attempt": attempt,
            "kind": exc.kind,
            "message": str(exc),
            "prompt_version": ADVISOR_PROMPT_VERSION,
            "raw_response": raw_response,
            "raw_result": raw_result_text,
        }
        try:
            with path.open("a", encoding="utf-8") as stream:
                stream.write(json.dumps(entry, sort_keys=True, ensure_ascii=False) + "\n")
        except OSError as log_exc:
            self.info(f"Could not write advisor error log {path}: {log_exc}")
            return
        self.advisor_error_log_entries = getattr(self, "advisor_error_log_entries", 0) + 1

    def _write_advisor_trace(self, entry: dict) -> None:
        """Save EXACT sent packets, schema, system prompt and raw model reply.

        Trace capture is opt-in, append-only, and deliberately never rewrites
        the evidence or records API credentials. Each write is flushed to disk.
        """
        path = getattr(self, "advisor_trace_path", None)
        if path is None:
            return
        with path.open("a", encoding="utf-8") as stream:
            stream.write(json.dumps(entry, sort_keys=True, ensure_ascii=True) + "\n")
            stream.flush()
            os.fsync(stream.fileno())

    def _advisor_call_with_retries(
        self, client: OllamaAdvisor, prompt: str, sha: str, packet: dict
    ) -> dict:
        retries = max(0, self.args.advisor_retries)
        schema = advisor_response_schema(
            self.advisor_prerequisite_evidence(sha),
            self.advisor_inbound_take_recommendations(sha),
        )
        last_error: AdvisorError | None = None
        policy_rechecks = 0
        for attempt in range(retries + 1):
            self.nodes[sha].advisor_attempts = attempt + 1
            self.advisor_calls += 1
            raw = None
            request_ok = False
            request_finished = None
            started = time.perf_counter()
            request_prompt = prompt
            try:
                # A mock or future client may not expose Ollama measurements.
                if hasattr(client, "last_telemetry"):
                    client.last_telemetry = None
                request_prompt = prompt
                if last_error is not None:
                    if last_error.kind == "policy-review":
                        request_prompt = policy_retry_prompt(prompt)
                    elif last_error.kind in ("binding-unassessed",
                                                   "binding-source-claim"):
                        # Include the validator's exact evidence IDs for both
                        # omitted dispositions and unsupported source claims.
                        # Generic retry wording repeatedly missed the same IDs
                        # during the run 27 Gemma fallback phase.
                        request_prompt = binding_retry_prompt(
                            prompt, str(last_error))
                    elif last_error.kind == "dt-include-recheck":
                        request_prompt = dt_include_retry_prompt(
                            prompt, self._advisor_hard_dt_include_facts(sha))
                raw = client.advise(request_prompt, packet, schema)
                validated = self.validate_advisor_result(sha, raw)
                # Guard against a recurring policy misread by small models.
                # Neither convert REVIEW to TAKE nor suppress concrete risks.
                if policy_only_review_objection(validated):
                    raise AdvisorError(
                        "REVIEW cites absent official platform/product benefit "
                        "without a specific technical uncertainty; recheck "
                        "upstream-convergence policy",
                        kind="policy-review", retryable=True)
                hard_dt = self._advisor_hard_dt_include_facts(sha)
                if (hard_dt and validated["decision"] != "TAKE"
                        and not _CONCRETE_TECHNICAL_OBJECTION.search(
                            " ".join([validated["rationale"],
                                      *validated.get("risks", [])]))
                        and last_error is None):
                    raise AdvisorError(
                        "REVIEW/SKIP of missing DT source-file provider lacks "
                        "a concrete technical objection; recheck verified "
                        "TAKE-consumer include requirements",
                        kind="dt-include-recheck", retryable=True)
                window = getattr(self.args, "advisor_context_tokens", 0)
                reserve = getattr(self.args, "advisor_output_reserve", 1024)
                used = (getattr(client, "last_telemetry", None) or {}).get(
                    "prompt_eval_count")
                if (window and isinstance(used, int)
                        and used >= window - reserve):
                    raise AdvisorError(
                        f"Ollama prompt_eval_count={used} approaches the "
                        f"configured {window}-token context; possible truncated "
                        "evidence, manual REVIEW required",
                        kind="context-limit", retryable=False)
                request_ok = True
                request_finished = time.perf_counter()
                return validated
            except AdvisorError as exc:
                request_finished = time.perf_counter()
                last_error = exc
                self._write_advisor_error_diagnostic(sha, attempt + 1, exc, raw)
                if exc.kind == "policy-review":
                    policy_rechecks += 1
                if (not exc.retryable or attempt >= retries or
                        (exc.kind == "policy-review" and policy_rechecks > 1)):
                    raise
                if exc.kind == "policy-review":
                    self.advisor_policy_rechecks = getattr(
                        self, "advisor_policy_rechecks", 0) + 1
                    performance = getattr(self, "performance", None)
                    if performance:
                        performance.event("advisor_policy_recheck", sha=sha[:12])
                self.advisor_retries_used += 1
                self.info(
                    f"    advisor {exc.kind}; retry {attempt + 1}/{retries}: {exc}"
                )
                delay = max(0.0, self.args.advisor_retry_delay) * (2 ** attempt)
                if delay:
                    time.sleep(min(delay, 10.0))
            finally:
                self._write_advisor_trace({
                    "trace_format": "exact-advisor-request-v1",
                    "sha": sha, "attempt": attempt + 1,
                    "model": getattr(self, "advisor_model", None),
                    "stage": getattr(self, "_advisor_stage", "primary"),
                    "prompt_version": ADVISOR_PROMPT_VERSION,
                    "system_prompt": request_prompt,
                    "packet": packet,
                    "response_schema": schema,
                    "response": raw,
                    "error_kind": None if request_ok else (
                        last_error.kind if last_error is not None else "unknown"),
                    "error_message": None if request_ok else (
                        str(last_error) if last_error is not None else "unknown"),
                    "ollama": getattr(client, "last_telemetry", None),
                })
                performance = getattr(self, "performance", None)
                if performance:
                    performance.advisor(
                        sha, attempt + 1, (request_finished or time.perf_counter()) - started,
                        input_bytes=len(json.dumps(packet, sort_keys=True).encode("utf-8")),
                        status="ok" if request_ok else "failed",
                        ollama=getattr(client, "last_telemetry", None),
                        model=getattr(self, "advisor_model", None),
                        stage=getattr(self, "_advisor_stage", "primary"),
                    )
        assert last_error is not None
        raise last_error

    def _clear_advisor_recommendations_from(self, consumer_sha: str) -> None:
        for node in self.nodes.values():
            node.advisor_recommended_by = [
                item for item in node.advisor_recommended_by
                if item.get("consumer_sha") != consumer_sha
            ]

    def _record_advisor_prerequisite_recommendations(self, consumer_sha: str) -> None:
        self._clear_advisor_recommendations_from(consumer_sha)
        consumer = self.nodes[consumer_sha]
        if consumer.advisor_decision != "TAKE":
            return
        evidence_by_id = {
            item["evidence_id"]: item
            for item in self.advisor_prerequisite_evidence(consumer_sha)
        }
        for prereq in consumer.advisor_prerequisites:
            peer = self.nodes.get(prereq["sha"])
            if peer is None or not self.is_actionable_node(peer):
                continue
            evidence = evidence_by_id.get(prereq.get("evidence_id", ""))
            if evidence is None:
                continue
            peer.advisor_recommended_by.append({
                "consumer_sha": consumer_sha,
                "consumer_subject": consumer.subject,
                "consumer_decision": consumer.advisor_decision,
                "evidence_id": evidence["evidence_id"],
                "evidence_kind": evidence["kind"],
                "evidence_object": evidence["object"],
                "consumer_use": evidence["selected_use"],
                "candidate_provides": evidence["peer_provides"],
                "reason": prereq["reason"],
            })

    def _advisor_note_failure(self, node: CommitNode, exc: AdvisorError) -> None:
        previous = node.advisor_error_kind
        if previous:
            self.advisor_failure_kinds[previous] -= 1
            if self.advisor_failure_kinds[previous] <= 0:
                del self.advisor_failure_kinds[previous]
        else:
            self.advisor_failures += 1
        self.advisor_failure_kinds[exc.kind] += 1
        self._clear_advisor_recommendations_from(node.sha)
        node.advisor_decision = "REVIEW"
        node.advisor_rationale = (
            f"Advisor failed ({exc.kind}); manual review required. {exc}"
        )
        node.advisor_prerequisites = []
        node.advisor_binding_assessments = []
        node.advisor_rejected_prerequisites = []
        node.advisor_inbound_assessments = []
        node.advisor_risks = []
        node.advisor_error = str(exc)
        node.advisor_error_kind = exc.kind
        node.advisor_decision_model = self.advisor_model

    @staticmethod
    def _namespace_only_objection(text: str, *, allow_conclusion_only: bool = False) -> bool:
        """Accept only explicit excerpt omissions of facts already proven by Git.

        Include closure establishes the consumer's symbol use and the exact
        header's reachability. It does NOT establish the hardware compatible
        string, downstream applicability, or build correctness. Fail closed on
        any wording outside this deliberately small vocabulary: a false TAKE
        is more costly than leaving an uncertain commit at REVIEW.
        """
        if not isinstance(text, str) or not text.strip():
            return False

        excerpt = (
            r"(?:the\s+)?(?:(?:bounded|truncated)\s+)?"
            r"(?:(?:consumer|related)\s+)?(?:patch|diff)\s+excerpt"
        )
        proven_fact = (
            r"(?:the\s+)?(?:(?:actual|exact|relevant)\s+)?"
            r"(?:symbol[- ]use(?:\s+line)?|macro[- ]use(?:\s+line)?|"
            r"symbol\s+reference(?:\s+line)?|"
            r"(?:provider[- ]header|header)[- ]include(?:\s+line)?|"
            r"(?:exact\s+)?provider\s+header\s+include(?:\s+line)?)"
        )
        omitted_fact = re.compile(
            rf"{excerpt}\s+(?:"
            rf"(?:does\s+not|doesn't)\s+(?:show|include|contain)\s+{proven_fact}|"
            rf"(?:omits|lacks)\s+{proven_fact}|"
            rf"(?:is\s+)?truncated\s+before\s+{proven_fact}"
            rf")",
            re.IGNORECASE,
        )
        namespace_conclusion = re.compile(
            r"(?:(?:therefore|consequently|thus|as a result)\s*,?\s+)?"
            r"(?:the\s+)?(?:DT[- ]binding\s+|binding\s+)?namespace\s+"
            r"(?:cannot|can't|could\s+not)\s+be\s+"
            r"(?:verified|established|confirmed)\s+"
            r"(?:from|using)\s+(?:the|this|that)\s+excerpt",
            re.IGNORECASE,
        )

        # Every sentence must be a known redundant objection. Do not use a
        # keyword blacklist: it misses novel or paraphrased integration risks.
        sentences = re.split(r"(?<=[.!?])\s+", " ".join(text.split()))
        saw_omission = False
        for sentence in sentences:
            sentence = sentence.rstrip(". ")
            if omitted_fact.fullmatch(sentence):
                saw_omission = True
            elif not namespace_conclusion.fullmatch(sentence):
                return False
        return saw_omission or allow_conclusion_only

    def _enforce_verified_dt_namespace(self, node: CommitNode, result: dict) -> dict:
        """Do not let an excerpt-only namespace objection veto proven edges.

        Never manufacture proof, and never override independent objections or
        an advisor error. Both fresh and cached model responses pass here.
        """
        if result["decision"] not in {"REVIEW", "SKIP"}:
            return result
        packet = self.advisor_packet(node.sha)
        if packet["commit"]["default_policy_bias"] != "TRUST_DT_BINDING_NAMESPACE_PROOF":
            return result
        if not self._namespace_only_objection(result["rationale"]):
            return result
        if any(not self._namespace_only_objection(risk, allow_conclusion_only=True)
               for risk in result["risks"]):
            return result
        revised = dict(result)
        revised["decision"] = "TAKE"
        revised["rationale"] = (
            "Verified DT-binding namespace via exact-header include closure; "
            "advisor's excerpt-based namespace objection is superseded. "
            "Original advisor rationale: " + result["rationale"]
        )
        revised["risks"] = []  # All stated risks were the same disproven objection.
        self.info(f"    verified DT namespace guardrail: TAKE {node.sha[:12]}")
        return revised

    def _advisor_note_success(self, node: CommitNode, result: dict) -> None:
        previous = node.advisor_error_kind
        if previous:
            self.advisor_failures = max(0, self.advisor_failures - 1)
            self.advisor_failure_kinds[previous] -= 1
            if self.advisor_failure_kinds[previous] <= 0:
                del self.advisor_failure_kinds[previous]
        result = self._enforce_verified_dt_namespace(node, result)
        node.advisor_decision = result["decision"]
        node.advisor_rationale = result["rationale"]
        node.advisor_prerequisites = result["prerequisite_peers"]
        node.advisor_binding_assessments = result.get("binding_evidence_assessments", [])
        node.advisor_rejected_prerequisites = []
        node.advisor_inbound_assessments = result["inbound_prerequisite_assessments"]
        node.advisor_risks = result["risks"]
        node.advisor_error = None
        node.advisor_error_kind = None
        node.advisor_decision_model = self.advisor_model
        self._record_advisor_prerequisite_recommendations(node.sha)

    def _advisor_evaluate_one(
        self, client: OllamaAdvisor, prompt: str, sha: str, *,
        reconsideration: bool = False,
        binding_conflict_context: list[dict] | None = None,
    ) -> None:
        node = self.nodes[sha]
        packet = self.advisor_packet(sha)
        if binding_conflict_context:
            # Included in the cache fingerprint. A corrective response must
            # never be reused as if it came from the ordinary prompt packet.
            packet["commit"]["binding_conflict_context"] = binding_conflict_context
            prompt += (
                "\nBinding conflict recheck: for each listed evidence_id, "
                "compare the consumer's REQUIRED reason with the provider's "
                "NOT_REQUIRED reason and the actual downstream schema state. "
                "Give a concrete source-level explanation for REQUIRED or "
                "NOT_REQUIRED. Product support status is irrelevant. "
                "Do not invent downstream files or change evidence IDs.\n"
            )
        policy_result = self.advisor_policy_override(sha, packet)
        if policy_result is not None:
            node.advisor_attempts = 0
            self._advisor_note_success(node, policy_result)
            node.advisor_decision_model = "deterministic-policy"
            self.info(
                f"    advisor policy override: {policy_result['decision']} - "
                f"{self._one_line(policy_result['rationale'])}"
            )
            return
        node.advisor_budget = None
        limit = getattr(self.args, "advisor_max_request_chars", 0)
        if limit:
            schema = advisor_response_schema(
                self.advisor_prerequisite_evidence(sha),
                self.advisor_inbound_take_recommendations(sha),
            )
            try:
                # Leave room for one explicit policy correction on retry.
                packet, budget = budget_advisor_packet(packet, prompt, schema,
                                                       max(1, limit - 600))
                budget["limit_chars"] = limit
                node.advisor_budget = budget
                if budget["omitted"]:
                    self.info(f"    advisor packet budget: {budget['initial_chars']} -> "
                              f"{budget['final_chars']} chars; "
                              f"{len(budget['omitted'])} optional excerpts omitted")
                if getattr(self, "performance", None):
                    self.performance.event(
                        "advisor_packet_budget", sha=sha[:12], **budget)
            except AdvisorError as exc:
                node.advisor_budget = {"limit_chars": limit, "overflow": True,
                                       "error": str(exc)}
                self._advisor_note_failure(node, exc)
                self.info(f"    advisor {exc.kind}: {exc}")
                return
        cache_key = self.advisor_cache_key(sha, packet)
        cached = None if self.args.no_advisor_cache else self.advisor_cache.get(cache_key)
        try:
            if cached is not None:
                result = self.validate_advisor_result(sha, cached)
                self.advisor_cache_hits += 1
                if getattr(self, "performance", None):
                    self.performance.cache_hit(sha)
                node.advisor_attempts = 0
            else:
                result = self._advisor_call_with_retries(client, prompt, sha, packet)
                if not self.args.no_advisor_cache:
                    self.advisor_cache[cache_key] = result
                    with self._phase("advisor.cache_write"):
                        self.save_advisor_cache()
            self._advisor_note_success(node, result)
        except AdvisorError as exc:
            self._advisor_note_failure(node, exc)
            label = "reconsideration error" if reconsideration else "advisor error"
            self.info(f"    {label} [{exc.kind}]: {exc}")

    def _advisor_unassessed_inbound_ids(self, sha: str) -> set[str]:
        inbound = {
            item["evidence_id"]
            for item in self.advisor_inbound_take_recommendations(sha)
            if item.get("evidence_id")
        }
        assessed = {
            item["evidence_id"]
            for item in self.nodes[sha].advisor_inbound_assessments
            if item.get("evidence_id")
        }
        return inbound - assessed

    def _advisor_reconciliation_pass(
        self, client: OllamaAdvisor, prompt: str, ordered: Sequence[str]
    ) -> None:
        """Re-evaluate nodes that gained TAKE-consumer prerequisites too late.

        Consumer-first graph depth cannot totally order same-depth series peers. A
        later model decision may therefore discover a concrete prerequisite for a
        candidate already judged SKIP/REVIEW. Reconsider only when new inbound
        evidence has not yet been assessed, and bound the pass to at most twice the
        advised population to prevent pathological feedback loops.
        """
        seen_contexts: set[tuple[str, tuple[str, ...]]] = set()
        max_reconsiderations = max(1, len(ordered) * 2)
        while self.advisor_reconsiderations < max_reconsiderations:
            candidate = None
            context_key = None
            for sha in ordered:
                node = self.nodes[sha]
                if node.advisor_decision not in {"SKIP", "REVIEW"}:
                    continue
                missing = self._advisor_unassessed_inbound_ids(sha)
                if not missing:
                    continue
                key = (sha, tuple(sorted(
                    item["evidence_id"]
                    for item in self.advisor_inbound_take_recommendations(sha)
                    if item.get("evidence_id")
                )))
                if key in seen_contexts:
                    continue
                candidate = sha
                context_key = key
                break
            if candidate is None or context_key is None:
                break
            seen_contexts.add(context_key)
            self.advisor_reconsiderations += 1
            node = self.nodes[candidate]
            self.info(
                f"  advisor reconsider {self.advisor_reconsiderations}: "
                f"{candidate[:12]} {node.subject} "
                f"[{len(context_key[1])} inbound TAKE prerequisite(s)]"
            )
            self._advisor_evaluate_one(
                client, prompt, candidate, reconsideration=True
            )

    def _advisor_binding_conflicts(self) -> dict[str, list[dict]]:
        """Find conflicting consumer/provider binding decisions by evidence ID.

        A consumer's REQUIRED assessment is not negated by an independent
        NOT_REQUIRED opinion. Neither opinion is silently discarded.
        """
        result: dict[str, list[dict]] = collections.defaultdict(list)
        for consumer in self.nodes.values():
            if consumer.advisor_decision != "TAKE":
                continue
            required = {x.get("evidence_id"): x for x in
                        consumer.advisor_binding_assessments
                        if x.get("disposition") == "REQUIRED"}
            for prereq in consumer.advisor_prerequisites:
                if prereq.get("evidence_kind") not in (
                        "compatible-binding", "dt-property-binding"):
                    continue
                evidence_id = prereq.get("evidence_id", "")
                consumer_assessment = required.get(evidence_id)
                peer = self.nodes.get(prereq.get("sha", ""))
                if not consumer_assessment or peer is None:
                    continue
                assessment = next((a for a in peer.advisor_inbound_assessments
                                   if a.get("evidence_id") == evidence_id and
                                   a.get("disposition") == "NOT_REQUIRED"), None)
                if assessment is None:
                    continue
                proof = next((e for e in self.advisor_prerequisite_evidence(
                    consumer.sha) if e.get("evidence_id") == evidence_id), {})
                binding_path = proof.get("provider_path", "")
                downstream_schema = (self._tree_file_text(
                    self.replay_start, binding_path) if binding_path else None)
                result[peer.sha].append({
                    "binding_path": binding_path,
                    "downstream_binding_path_exists": (
                        downstream_schema is not None),
                    "downstream_has_compatible": (
                        prereq.get("evidence_object", "") in
                        self._yaml_binding_compatible_candidates(
                            downstream_schema)
                        if downstream_schema is not None else False),
                    "consumer_sha": consumer.sha,
                    "evidence_id": evidence_id,
                    "evidence_kind": prereq["evidence_kind"],
                    "evidence_object": prereq.get("evidence_object", ""),
                    "consumer_disposition": "REQUIRED",
                    "consumer_reason": consumer_assessment.get("reason", ""),
                    "provider_disposition": "NOT_REQUIRED",
                    "provider_reason": assessment.get("reason", ""),
                })
        return dict(result)

    def _advisor_reconcile_binding_conflicts(
        self, client: OllamaAdvisor, prompt: str,
    ) -> None:
        """Give each conflicting TAKE provider one evidence-specific recheck.

        Remaining conflicts are left for the consistency audit and block
        execution readiness. Rechecks are bounded to one per provider per run.
        """
        conflicts = self._advisor_binding_conflicts()
        self.advisor_binding_rechecks = 0
        for peer_sha, context in sorted(conflicts.items()):
            peer = self.nodes[peer_sha]
            if peer.advisor_decision != "TAKE" or peer.match.status == "present":
                continue
            self.advisor_binding_rechecks += 1
            self.info(f"  advisor binding disagreement recheck "
                      f"{self.advisor_binding_rechecks}: {peer_sha[:12]} "
                      f"({len(context)} disputed evidence ID(s))")
            if getattr(self, "performance", None):
                self.performance.event("advisor_binding_disagreement_recheck",
                                       sha=peer_sha[:12], count=len(context))
            self._advisor_evaluate_one(
                client, prompt, peer_sha, reconsideration=True,
                binding_conflict_context=context,
            )

    def _advisor_resolve_rejected_prerequisites(self) -> None:
        """Record unopposed NOT_REQUIRED decisions without hiding disagreements.

        A non-binding peer may reject an inbound recommendation. A binding
        provider cannot cancel a consumer's explicit REQUIRED evidence with a
        conflicting NOT_REQUIRED opinion: preserve the active dependency and
        let the consistency audit reject the unresolved disagreement.
        """
        for consumer in self.nodes.values():
            consumer.advisor_rejected_prerequisites = []
            if consumer.advisor_decision != "TAKE" or not consumer.advisor_prerequisites:
                continue
            active: list[dict[str, str]] = []
            required = {x.get("evidence_id") for x in
                        consumer.advisor_binding_assessments
                        if x.get("disposition") == "REQUIRED"}
            for prereq in consumer.advisor_prerequisites:
                peer = self.nodes.get(prereq.get("sha", ""))
                evidence_id = prereq.get("evidence_id", "")
                assessment = None
                if peer is not None and evidence_id:
                    assessment = next(
                        (item for item in peer.advisor_inbound_assessments
                         if item.get("evidence_id") == evidence_id
                         and item.get("disposition") == "NOT_REQUIRED"),
                        None,
                    )
                if assessment is None:
                    active.append(prereq)
                    continue
                if (prereq.get("evidence_kind") in
                        ("compatible-binding", "dt-property-binding")
                        and evidence_id in required):
                    active.append(prereq)
                    continue
                rejected = dict(prereq)
                rejected["candidate_decision"] = peer.advisor_decision or ""
                rejected["assessment_disposition"] = "NOT_REQUIRED"
                rejected["assessment_reason"] = assessment.get("reason", "")
                consumer.advisor_rejected_prerequisites.append(rejected)
            consumer.advisor_prerequisites = active

    def _advisor_promote_prerequisites(self) -> int:
        """Select evidence-backed earlier peers, without deciding TAKE for them.

        Advisor prerequisites are semantic claims, not automatically approved
        backports. Promotion makes the candidate visible to advisor evaluation;
        its eventual disposition must still pass consistency checking.
        """
        promoted = 0
        for consumer in list(self.nodes.values()):
            if (consumer.advisor_decision != "TAKE" or
                    not self.is_actionable_node(consumer) or
                    not consumer.advisor_prerequisites):
                continue
            evidence = {
                item["evidence_id"]: item
                for item in self.advisor_prerequisite_evidence(consumer.sha)
            }
            for prereq in consumer.advisor_prerequisites:
                peer_sha = prereq["sha"]
                proof = evidence.get(prereq.get("evidence_id", ""))
                if proof is None or proof.get("peer_sha") != peer_sha:
                    continue
                if peer_sha not in self.advisor_allowed_prerequisite_peers(consumer.sha):
                    continue
                existing = self.nodes.get(peer_sha)
                if existing is not None and (self.is_actionable_node(existing)
                                             or existing.match.status == "present"):
                    continue
                peer = self.ensure_node(
                    peer_sha, reason="advisor-prerequisite:" + proof["kind"],
                    required_by=consumer.sha,
                )
                if not self.is_actionable_node(peer):
                    continue
                promoted += 1
                self.info(f"  advisor promoted prerequisite candidate {peer_sha[:12]} "
                          f"for {consumer.sha[:12]} (pending independent evaluation)")
            # The peer was not previously actionable, so its inbound evidence
            # was deliberately omitted during the original recording pass.
            self._record_advisor_prerequisite_recommendations(consumer.sha)
        return promoted

    def _advisor_check_consistency(self) -> None:
        """Validate every TAKE edge against the actual executable JSON order.

        Missing/unselected/unadvised peers must never be silently considered
        satisfied. A planner report with outstanding issues is still useful,
        but it must not claim the dependency closure is executable.
        """
        self.advisor_consistency_issues = []
        for node in self.nodes.values():
            node.advisor_consistency_warnings = []
        ordered = self.ordered_missing()
        position = {sha: i for i, sha in enumerate(ordered)}

        for consumer_sha, consumer in list(self.nodes.items()):
            if (consumer.advisor_decision != "TAKE" or
                    not self.is_actionable_node(consumer) or
                    consumer.match.status != "missing"):
                continue
            for prereq in consumer.advisor_prerequisites:
                peer_sha = prereq["sha"]
                peer = self.nodes.get(peer_sha)
                evidence_id = prereq.get("evidence_id", "")
                assessment = next((item for item in peer.advisor_inbound_assessments
                                   if item.get("evidence_id") == evidence_id), None) if peer else None
                consumer_assessment = next((item for item in
                    consumer.advisor_binding_assessments
                    if item.get("evidence_id") == evidence_id), None)
                conflict = bool(
                    prereq.get("evidence_kind") in
                    ("compatible-binding", "dt-property-binding")
                    and consumer_assessment is not None
                    and consumer_assessment.get("disposition") == "REQUIRED"
                    and assessment is not None
                    and assessment.get("disposition") == "NOT_REQUIRED"
                    and peer is not None and peer.match.status != "present"
                )
                if conflict:
                    kind = "DT_BINDING->DISAGREEMENT"
                elif assessment and assessment.get("disposition") == "NOT_REQUIRED":
                    continue
                elif peer is None:
                    kind = "TAKE->ABSENT"
                elif peer.match.status == "present":
                    continue
                elif not self.is_actionable_node(peer):
                    kind = "TAKE->UNSELECTED"
                elif peer.advisor_decision is None:
                    kind = "TAKE->UNEVALUATED"
                elif peer.advisor_decision != "TAKE":
                    kind = f"TAKE->{peer.advisor_decision}"
                elif peer_sha not in position:
                    kind = "TAKE->UNORDERED"
                elif consumer_sha not in position or position[peer_sha] >= position[consumer_sha]:
                    kind = "TAKE->OUT_OF_ORDER"
                else:
                    continue
                issue = {
                    "kind": kind,
                    "consumer_sha": consumer_sha,
                    "consumer_subject": consumer.subject,
                    "prerequisite_sha": peer_sha,
                    "prerequisite_subject": peer.subject if peer else "(not in plan graph)",
                    "prerequisite_decision": peer.advisor_decision if peer else None,
                    "evidence_id": evidence_id,
                    "evidence_kind": prereq.get("evidence_kind", ""),
                    "evidence_object": prereq.get("evidence_object", ""),
                    "reason": prereq.get("reason", ""),
                    "assessment_disposition": assessment.get("disposition", "") if assessment else "",
                    "assessment_reason": assessment.get("reason", "") if assessment else "",
                    "consumer_assessment_reason": (
                        consumer_assessment.get("reason", "")
                        if consumer_assessment else ""),
                }
                self.advisor_consistency_issues.append(issue)
                consumer.advisor_consistency_warnings.append({"role": "consumer", **issue})
                if peer:
                    peer.advisor_consistency_warnings.append({"role": "prerequisite", **issue})

        # Independent audit: every known binding edge on a TAKE needs an
        # evidence-specific REQUIRED or NOT_REQUIRED disposition, even when
        # the model never nominated the peer. This catches silent omissions.
        for consumer in list(self.nodes.values()):
            if (consumer.advisor_decision != "TAKE"
                    or not self.is_actionable_node(consumer)
                    or consumer.match.status != "missing"):
                continue
            assessments = {item.get("evidence_id"): item
                           for item in consumer.advisor_binding_assessments}
            for proof in self.advisor_prerequisite_evidence(consumer.sha):
                if proof.get("kind") not in ("compatible-binding", "dt-property-binding"):
                    continue
                evidence_id = proof["evidence_id"]
                item = assessments.get(evidence_id)
                if item and item.get("disposition") == "NOT_REQUIRED":
                    continue
                if item and item.get("disposition") == "REQUIRED":
                    # The ordinary TAKE-edge check above validates this edge.
                    # One peer may be supported by several evidence IDs;
                    # normalized prerequisite_peers keeps one edge per peer.
                    if any(edge.get("sha") == proof["peer_sha"]
                           for edge in consumer.advisor_prerequisites):
                        continue
                issue = {
                    "kind": "DT_BINDING->UNASSESSED",
                    "consumer_sha": consumer.sha,
                    "consumer_subject": consumer.subject,
                    "prerequisite_sha": proof["peer_sha"],
                    "prerequisite_subject": proof.get("peer_subject", ""),
                    "evidence_id": evidence_id,
                    "evidence_kind": proof["kind"],
                    "evidence_object": proof["object"],
                    "reason": "binding relationship lacks a recorded disposition",
                }
                self.advisor_consistency_issues.append(issue)
                consumer.advisor_consistency_warnings.append({"role": "consumer", **issue})

        # Candidate enumeration must not silently disappear behind the
        # 64-evidence cap, even when all returned model assessments were valid.
        for consumer_sha, count in sorted(getattr(
                self, "dt_binding_coverage_overflow", {}).items()):
            consumer = self.nodes.get(consumer_sha)
            if consumer is None or consumer.advisor_decision != "TAKE":
                continue
            issue = {
                "kind": "DT_BINDING->COVERAGE_OVERFLOW",
                "consumer_sha": consumer_sha,
                "consumer_subject": consumer.subject,
                "reason": (f"{count} candidate bindings exceed 64 evidence "
                           "records; manual review required"),
            }
            self.advisor_consistency_issues.append(issue)
            consumer.advisor_consistency_warnings.append(
                {"role": "consumer", **issue})

        # DT source includes are stricter than binding-schema suggestions:
        # these are verified file dependencies needed for DT compilation.
        for provider in list(self.nodes.values()):
            dt_paths = sorted(reason[len("dt-include:"):]
                              for reason in provider.reasons
                              if reason.startswith("dt-include:"))
            if not dt_paths:
                continue
            for consumer_sha in sorted(provider.required_by):
                consumer = self.nodes.get(consumer_sha)
                if not consumer or consumer.advisor_decision != "TAKE":
                    continue
                if provider.match.status == "present":
                    continue
                if not self.is_actionable_node(provider):
                    kind = "DT_INCLUDE->UNSELECTED"
                elif provider.advisor_decision is None:
                    kind = "DT_INCLUDE->UNEVALUATED"
                elif provider.advisor_decision != "TAKE":
                    kind = f"DT_INCLUDE->{provider.advisor_decision}"
                elif provider.sha not in position or consumer_sha not in position:
                    kind = "DT_INCLUDE->UNORDERED"
                elif position[provider.sha] >= position[consumer_sha]:
                    kind = "DT_INCLUDE->OUT_OF_ORDER"
                else:
                    continue
                issue = {
                    "kind": kind, "consumer_sha": consumer_sha,
                    "consumer_subject": consumer.subject,
                    "prerequisite_sha": provider.sha,
                    "prerequisite_subject": provider.subject,
                    "prerequisite_decision": provider.advisor_decision,
                    "reason": "DT source include(s): " + ", ".join(dt_paths),
                }
                self.advisor_consistency_issues.append(issue)
                consumer.advisor_consistency_warnings.append({"role": "consumer", **issue})
                provider.advisor_consistency_warnings.append({"role": "prerequisite", **issue})

        # A DT include whose provider could not be identified is also not a
        # proven-safe execution dependency, even without an LLM recommendation.
        for missing in getattr(self, "dt_include_unresolved", []):
            issue = {"kind": "TAKE->MISSING_DT_INCLUDE", **missing}
            consumer = self.nodes.get(missing["consumer_sha"])
            if not consumer or consumer.advisor_decision != "TAKE":
                continue
            self.advisor_consistency_issues.append(issue)
            consumer.advisor_consistency_warnings.append({"role": "consumer", **issue})

    def _advisor_fallback_candidates(self) -> list[tuple[str, list[str]]]:
        """Prioritize graph blockers, then all outstanding REVIEW decisions.

        A full dual-model run covers every outstanding REVIEW unless the user
        explicitly limits escalations. This is NOT a forced TAKE conversion.
        """
        reasons: dict[str, set[str]] = collections.defaultdict(set)
        blockers: collections.Counter[str] = collections.Counter()
        for issue in self.advisor_consistency_issues:
            kind = issue.get("kind", "")
            provider = issue.get("prerequisite_sha")
            consumer = issue.get("consumer_sha")
            if provider in self.nodes:
                reasons[provider].add("dependency:" + kind)
                blockers[provider] += 1
            if kind == "DT_BINDING->DISAGREEMENT" and consumer in self.nodes:
                reasons[consumer].add("binding-disagreement")
        for sha, node in self.nodes.items():
            if not self.is_actionable_node(node) or node.match.status != "missing":
                continue
            if node.advisor_decision == "REVIEW":
                reasons[sha].add("review")
            if node.advisor_error_kind:
                reasons[sha].add("advisor-error:" + node.advisor_error_kind)
        chosen = [(sha, sorted(why)) for sha, why in reasons.items()
                  if sha in self.nodes and self.is_actionable_node(self.nodes[sha])
                  and self.nodes[sha].match.status == "missing"]
        return sorted(chosen, key=lambda item: (
            -blockers[item[0]],
            0 if self.nodes[item[0]].advisor_decision == "REVIEW" else 1,
            item[0],
        ))

    @staticmethod
    def _advisor_snapshot(node: CommitNode) -> dict:
        """Capture the primary decision before evaluating a different model."""
        fields = (
            "advisor_decision", "advisor_rationale", "advisor_prerequisites",
            "advisor_binding_assessments", "advisor_rejected_prerequisites",
            "advisor_inbound_assessments", "advisor_risks", "advisor_error",
            "advisor_error_kind", "advisor_attempts", "advisor_budget",
            "advisor_decision_model",
        )
        return {name: json.loads(json.dumps(getattr(node, name, None)))
                for name in fields}

    def _advisor_restore_snapshot(self, node: CommitNode, original: dict) -> None:
        """Restore a Qwen result if Gemma could not return valid evidence.

        Counters track unresolved final failures, not failed secondary attempts.
        The secondary failure is separately reported as fallback metadata.
        """
        current = node.advisor_error_kind
        old = original.get("advisor_error_kind")
        if current and current != old:
            self.advisor_failures = max(0, self.advisor_failures - 1)
            self.advisor_failure_kinds[current] -= 1
            if self.advisor_failure_kinds[current] <= 0:
                self.advisor_failure_kinds.pop(current, None)
        if old and old != current:
            self.advisor_failures += 1
            self.advisor_failure_kinds[old] += 1
        for name, value in original.items():
            setattr(node, name, value)
        self._record_advisor_prerequisite_recommendations(node.sha)

    def _advisor_fallback_one(
        self, client: OllamaAdvisor, prompt: str, sha: str,
        reasons: list[str],
        binding_conflict_context: list[dict] | None = None,
    ) -> None:
        """Validate an independent second opinion, retaining the audit trail."""
        node = self.nodes[sha]
        previous = self._advisor_snapshot(node)
        if node.advisor_primary_result is None:
            node.advisor_primary_result = previous
        node.advisor_escalation_reasons = reasons
        self.advisor_fallback_evaluated += 1
        self.info(f"  fallback {self.advisor_fallback_evaluated}: "
                  f"{sha[:12]} {node.subject} ({', '.join(reasons)})")
        self._advisor_evaluate_one(
            client, prompt, sha, reconsideration=True,
            binding_conflict_context=binding_conflict_context)
        secondary = self._advisor_snapshot(node)
        node.advisor_fallback_result = secondary
        node.advisor_fallback_history.append({
            "result": secondary,
            "reasons": list(reasons),
            "attempt": len(node.advisor_fallback_history) + 1,
        })
        if node.advisor_error_kind:
            self.advisor_fallback_failures += 1
            self._advisor_restore_snapshot(node, previous)
            return
        # Do not let a fallback SKIP quietly discard a previously known TAKE
        # or unvalidated REVIEW. Retain REVIEW for further human assessment.
        if secondary["advisor_decision"] == "SKIP":
            self._advisor_restore_snapshot(node, previous)
            return
        self.advisor_fallback_accepted += 1
        if previous.get("advisor_decision") != secondary["advisor_decision"]:
            self.advisor_fallback_changed += 1
        if (previous.get("advisor_decision") != "TAKE"
                and secondary["advisor_decision"] == "TAKE"):
            self.advisor_fallback_take += 1
        if getattr(self, "performance", None):
            self.performance.event("advisor_fallback_decision", sha=sha[:12],
                primary=previous.get("advisor_decision"),
                fallback=secondary.get("advisor_decision"))

    def _advisor_fallback_pass(self, primary_client: OllamaAdvisor) -> None:
        """Finish Qwen work, unload it, then batch Gemma escalations.

        All secondary calls use the same source validators, with independent
        model-specific cache keys and a separate context/request budget.
        """
        model = getattr(self, "advisor_fallback_model", None)
        if not model:
            return
        candidates = self._advisor_fallback_candidates()
        limit = getattr(self.args, "advisor_fallback_limit", 0)
        if limit:
            self.advisor_fallback_unprocessed = max(0, len(candidates) - limit)
            candidates = candidates[:limit]
        self.info(f"Dual-model escalation: {len(candidates)} candidates for "
                  f"{model} (unprocessed={self.advisor_fallback_unprocessed})")
        if not candidates:
            return
        try:
            primary_client.unload()
        except (OSError, urllib.error.URLError, AdvisorError) as exc:
            self.info(f"  Ollama primary unload warning: {exc}; "
                      "server may unload automatically")
        fallback_client = OllamaAdvisor(
            model=model, base_url=self.args.advisor_base_url,
            timeout=getattr(self.args, "advisor_fallback_timeout", 900.0),
            temperature=self.args.advisor_temperature,
            keep_alive=self.args.advisor_keep_alive, debug=self.args.debug,
        )
        original_model = self.advisor_model
        original_limit = self.args.advisor_max_request_chars
        original_context = self.args.advisor_context_tokens
        self._advisor_stage = "fallback"
        self.advisor_model = model
        self.args.advisor_max_request_chars = getattr(
            self.args, "advisor_fallback_max_request_chars", 120000)
        self.args.advisor_context_tokens = getattr(
            self.args, "advisor_fallback_context_tokens", 131072)
        try:
            prompt = self.advisor_system_prompt()
            # Pre-allocate the chosen 64K/128K context before selecting any
            # decisions. On limited-VRAM hosts the first load may fail while
            # Ollama releases Qwen; a warmup failure is diagnostic, not a
            # reason to abandon otherwise recoverable secondary requests.
            if hasattr(fallback_client, "warmup"):
                try:
                    fallback_client.warmup(context_tokens)
                    self.info("  fallback model warmup succeeded")
                except (AdvisorError, OSError) as exc:
                    self.advisor_fallback_warmup_error = str(exc)
                    self.info(f"  fallback warmup warning: {exc}")
                    if getattr(self, "performance", None):
                        self.performance.event(
                            "advisor_fallback_warmup_failure", error=str(exc))
            deferred: list[tuple[str, list[str]]] = []
            # Do not immediately repeat the same cold-start HTTP/OOM failure
            # after the normal per-request retries have already been spent.
            # Instead return to failed providers only after subsequent Gemma
            # requests have shown the server is operational.
            for sha, reasons in candidates:
                self._advisor_fallback_one(
                    fallback_client, prompt, sha, reasons)
                result = self.nodes[sha].advisor_fallback_result or {}
                if result.get("advisor_error_kind") in {
                        "http", "timeout", "transport"}:
                    deferred.append((sha, reasons))
            if deferred and self.advisor_fallback_accepted:
                self.info(f"  fallback delayed recovery: "
                          f"{len(deferred)} transient failure(s)")
                for sha, reasons in deferred:
                    # A single second evaluation per provider after the batch
                    # (not unbounded repeated inference or model swapping).
                    self.advisor_fallback_deferred_retries += 1
                    self.advisor_fallback_failures -= 1
                    self._advisor_fallback_one(
                        fallback_client, prompt, sha,
                        [*reasons, "deferred-transport-retry"])
                    recovered = not bool(
                        self.nodes[sha].advisor_fallback_result.get(
                            "advisor_error_kind"))
                    if recovered:
                        self.advisor_fallback_recovered += 1
                    if getattr(self, "performance", None):
                        self.performance.event(
                            "advisor_fallback_deferred_retry", sha=sha[:12],
                            recovered=recovered)
            # A new TAKE may expose a previously unseen provider. Continue
            # within the Gemma batch rather than swapping models again.
            fallback_promoted = False
            for round_no in range(1, 9):
                promoted = self._advisor_promote_prerequisites()
                if not promoted:
                    break
                fallback_promoted = True
                self.dependency_closure()
                self.build_series_index()
                pending = [sha for sha in self.advisor_order(self.ordered_missing())
                           if self.nodes[sha].advisor_decision is None]
                if not pending:
                    break
                self.info(f"  fallback prerequisite round {round_no}: "
                          f"{len(pending)} candidates")
                for sha in pending:
                    self._advisor_fallback_one(
                        fallback_client, prompt, sha, ["promoted-prerequisite"])
            if fallback_promoted and self.args.simulate:
                self.reset_replay_annotations()
                self.replay_final_verification = True
                _, conflicts = self.replay_once()
                self.info(f"  fallback final expanded-plan replay: "
                          f"{len(conflicts)} conflict(s)")
            self._advisor_resolve_rejected_prerequisites()
            self._advisor_check_consistency()
            # Re-evaluate conflicting binding assessments with the secondary
            # model only. Do not call Qwen once Gemma is resident.
            conflicts = self._advisor_binding_conflicts()
            for peer_sha, context in sorted(conflicts.items()):
                self._advisor_fallback_one(fallback_client, prompt, peer_sha,
                    ["binding-conflict-correction"],
                    binding_conflict_context=context)
            self._advisor_resolve_rejected_prerequisites()
            self._advisor_check_consistency()
            if self.advisor_fallback_unprocessed:
                self.advisor_consistency_issues.append({
                    "kind": "ADVISOR_FALLBACK->INCOMPLETE",
                    "reason": (f"{self.advisor_fallback_unprocessed} cases not "
                               "escalated due to --advisor-fallback-limit"),
                })
        finally:
            self.advisor_model = original_model
            self.args.advisor_max_request_chars = original_limit
            self.args.advisor_context_tokens = original_context
            self._advisor_stage = "primary"

    def run_advisor(self) -> None:
        if not self.advisor_model:
            return

        requested: set[str] | None = None
        if self.args.advisor_commit:
            requested = set()
            for value in self.args.advisor_commit:
                resolved = self.git.rev_parse(value)
                if resolved not in self.nodes or not self.is_actionable_node(self.nodes[resolved]):
                    raise SystemExit(f"--advisor-commit {value} is not an actionable planner commit")
                requested.add(resolved)

        if self.args.advisor_limit is not None and self.args.advisor_limit < 1:
            raise SystemExit("--advisor-limit must be >= 1")

        plan_order = [sha for sha in self.ordered_missing() if requested is None or sha in requested]
        ordered = self.advisor_order(plan_order)
        if self.args.advisor_limit is not None:
            ordered = ordered[:self.args.advisor_limit]

        # Clear transient advisor graph state in case a Planner instance is reused.
        for node in self.nodes.values():
            node.advisor_recommended_by = []
            node.advisor_inbound_assessments = []
            node.advisor_rejected_prerequisites = []
            node.advisor_consistency_warnings = []
        self.advisor_consistency_issues = []
        self.advisor_reconsiderations = 0

        self.info(
            f"Running advisor model {self.advisor_model} for {len(ordered)} commit(s) "
            "(consumer-first graph order)..."
        )
        client = OllamaAdvisor(
            model=self.advisor_model,
            base_url=self.args.advisor_base_url,
            timeout=self.args.advisor_timeout,
            temperature=self.args.advisor_temperature,
            keep_alive=self.args.advisor_keep_alive,
            debug=self.args.debug,
        )
        prompt = self.advisor_system_prompt()
        for pos, sha in enumerate(ordered, 1):
            n = self.nodes[sha]
            distance = self.advisor_distance_to_direct(sha, {})
            distance_text = "direct" if distance == 0 else f"dependency-depth={distance}"
            self.info(
                f"  advisor {pos}/{len(ordered)}: {sha[:12]} {n.subject} [{distance_text}]"
            )
            self._advisor_evaluate_one(client, prompt, sha)

        # A reconciliation decision can create fresh TAKE prerequisite edges.
        # Process these before and during closure, not only at the very end.
        self._advisor_reconciliation_pass(client, prompt, ordered)
        # Evaluate newly selected prerequisites rather than merely listing
        # them in the consumer's JSON record. Bound graph growth and leave
        # unresolved edges visible if closure cannot finish.
        promoted_any = False
        advised_after_initial = 0
        for round_no in range(1, 9):
            promoted = self._advisor_promote_prerequisites()
            if not promoted:
                break
            promoted_any = True
            self.dependency_closure()
            self.build_series_index()
            pending = [sha for sha in self.ordered_missing()
                       if self.nodes[sha].advisor_decision is None]
            if self.args.advisor_limit is not None:
                # --advisor-limit is a total evaluation bound, including
                # peers discovered after the first advisor pass.
                pending = pending[:max(0, self.args.advisor_limit - len(ordered) - advised_after_initial)]
            if not pending:
                break
            self.info(f"  advisor prerequisite round {round_no}: "
                      f"{len(pending)} new candidate(s)")
            for sha in self.advisor_order(pending):
                self._advisor_evaluate_one(client, prompt, sha)
                advised_after_initial += 1
            self._advisor_reconciliation_pass(client, prompt,
                list(dict.fromkeys([*ordered, *self.ordered_missing()])))
        else:
            self.info("  advisor prerequisite closure limit reached; unresolved "
                      "recommendations will be reported")

        # Newly selected peers change replay coverage. Do not present stale
        # pre-advisor replay results as if they covered the expanded plan.
        if promoted_any and self.args.simulate:
            self.reset_replay_annotations()
            self.replay_final_verification = True
            _, conflicts = self.replay_once()
            self.info(f"  final expanded-plan replay: {len(conflicts)} conflict(s)")
        self._advisor_reconciliation_pass(client, prompt, list(dict.fromkeys(
            [*ordered, *self.ordered_missing()])))
        self._advisor_reconcile_binding_conflicts(client, prompt)
        self._advisor_resolve_rejected_prerequisites()
        self._advisor_check_consistency()
        self._advisor_fallback_pass(client)

    def aliases_for(self, sha: str) -> set[str]:
        aliases = {sha}
        body = self.body(sha)
        # Linux-stable style commits point at their mainline source.
        for regex in (UPSTREAM_COMMIT_RE, STABLE_UPSTREAM_RE):
            aliases.update(x.lower() for x in regex.findall(body))
        return aliases

    def patch_id(self, sha: str) -> str | None:
        if sha in self._patch_id_cache:
            return self._patch_id_cache[sha]
        if len(self.git.parents(sha)) != 1:
            self._patch_id_cache[sha] = None
            return None
        patch = self.git.run(["show", "--pretty=format:", "--binary", sha])
        if not patch.strip():
            self._patch_id_cache[sha] = None
            return None
        cp = subprocess.run(
            ["git", "patch-id", "--stable"], cwd=str(self.repo), input=patch,
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        pid = cp.stdout.split()[0] if cp.returncode == 0 and cp.stdout.split() else None
        self._patch_id_cache[sha] = pid
        return pid

    def _downstream_ranges(self) -> list[str]:
        ranges = [f"{self.base}..{self.downstream_ref}"]
        if self.args.include_local:
            ranges.append(f"{self.downstream_ref}..HEAD")
        return ranges

    @staticmethod
    def _parse_nul_records(text: str, width: int) -> Iterator[tuple[str, ...]]:
        parts = text.split("\0")
        while parts and not parts[-1].strip():
            parts.pop()
        for i in range(0, len(parts) - width + 1, width):
            yield tuple(parts[i:i + width])

    def build_downstream_index(self) -> None:
        self.info("Indexing downstream identities and patch-ids...")
        seen: set[str] = set()
        for rng in self._downstream_ranges():
            raw = self.git.run([
                "log", "--no-merges", "--format=%H%x00%s%x00%B%x00", rng
            ])
            for sha, subj, body in self._parse_nul_records(raw, 3):
                sha = sha.strip()
                if not sha or sha in seen:
                    continue
                seen.add(sha)
                subj = subj.strip()
                self._subject_cache[sha] = subj
                self._body_cache[sha] = body
                self.downstream_index.exact[sha] = sha
                self.downstream_index.subjects[subj].append(sha)

                for regex, label in (
                    (CHERRY_PICK_RE, "cherry-picked-from"),
                    (UPSTREAM_COMMIT_RE, "upstream-commit"),
                    (STABLE_UPSTREAM_RE, "stable-upstream"),
                ):
                    for upstream_sha in regex.findall(body):
                        self.downstream_index.references.setdefault(
                            upstream_sha.lower(), (sha, label)
                        )

                for upstream_sha in EMBEDDED_COMMIT_RE.findall(body):
                    self.downstream_index.references.setdefault(
                        upstream_sha.lower(), (sha, "embedded-commit")
                    )

        if self.args.patch_id:
            for rng in self._downstream_ranges():
                log_cp = subprocess.Popen(
                    ["git", "log", "--no-merges", "-p", "--binary",
                     "--pretty=format:commit %H", rng],
                    cwd=str(self.repo), stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE, text=True,
                )
                assert log_cp.stdout is not None
                pid_cp = subprocess.run(
                    ["git", "patch-id", "--stable"], cwd=str(self.repo),
                    stdin=log_cp.stdout, stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE, text=True,
                )
                log_cp.stdout.close()
                log_stderr = log_cp.stderr.read() if log_cp.stderr else ""
                log_rc = log_cp.wait()
                if log_rc:
                    raise GitError(f"git log for patch-id failed: {log_stderr.strip()}")
                if pid_cp.returncode:
                    raise GitError(f"git patch-id failed: {pid_cp.stderr.strip()}")
                for line in pid_cp.stdout.splitlines():
                    fields = line.split()
                    if len(fields) >= 2:
                        pid, sha = fields[0], fields[1]
                        self.downstream_index.patch_ids.setdefault(pid, sha)
        self.info(f"  indexed {len(seen)} downstream commits")

    def match(self, sha: str, *, check_ancestry: bool = False) -> Match:
        cached = self._match_cache.get(sha)
        if cached is not None and (cached.status == "present" or not check_ancestry):
            return cached
        aliases = self.aliases_for(sha)

        for alias in aliases:
            if alias in self.downstream_index.exact:
                m = Match("present", "exact-sha", alias, alias, "high")
                self._match_cache[sha] = m
                return m
            if alias in self.downstream_index.references:
                ds, method = self.downstream_index.references[alias]
                confidence = "high" if method != "embedded-commit" else "medium-high"
                m = Match("present", method, ds, alias, confidence)
                self._match_cache[sha] = m
                return m

        # The downstream index is intentionally bounded to downstream commits
        # not already reachable from --base.  For discovered prerequisites or
        # provenance candidates that may predate --base, explicitly recognize
        # an exact shared ancestor so
        # old common history is not misreported as a missing prerequisite.
        # Direct focus candidates skip these extra Git ancestry probes.
        if check_ancestry:
            for alias in aliases:
                if self.git.is_ancestor(alias, self.replay_start):
                    m = Match("present", "downstream-ancestor", alias, alias, "high")
                    self._match_cache[sha] = m
                    return m

        if self.args.patch_id:
            pid = self.patch_id(sha)
            if pid and pid in self.downstream_index.patch_ids:
                ds = self.downstream_index.patch_ids[pid]
                m = Match("present", "patch-id", ds, pid, "high")
                self._match_cache[sha] = m
                return m

        m = Match()
        self._match_cache[sha] = m
        return m

    def ensure_node(self, sha: str, *, direct: bool = False, reason: str | None = None,
                    required_by: str | None = None) -> CommitNode:
        sha = self.git.rev_parse(sha)
        node = self.nodes.get(sha)
        if node is None:
            node = CommitNode(
                sha=sha,
                subject=self.subject(sha),
                match=self.match(sha, check_ancestry=not direct),
                aliases=self.aliases_for(sha),
                files=self.changed_files(sha),
            )
            node.subject_hints = self.downstream_index.subjects.get(node.subject, [])
            node.fixes = self.fixes_targets(sha)
            self.nodes[sha] = node
        node.direct = node.direct or direct
        if reason:
            node.add_reason(
                reason, required_by, tentative=self.is_tentative_dependency_reason(reason)
            )
        return node

    def is_tentative_dependency_reason(self, reason: str) -> bool:
        """Return true for context-only provenance evidence.

        Nearby blame context can explain why a textual conflict exists, but it
        does not by itself establish prerequisite semantics.  A larger context
        score makes the lead more interesting; it never upgrades context-only
        evidence into a selected dependency.
        """
        return bool(re.fullmatch(r"(?:conflict-)?hunk-context:\d+", reason)
                    or reason.startswith("dt-binding-candidate:"))

    @classmethod
    def is_actionable_node(cls, node: CommitNode) -> bool:
        """Return true when a node belongs to the proposed backport plan."""
        return node.direct or cls.dependency_kind(node) == "dependency"

    @staticmethod
    def dependency_kind(node: CommitNode) -> str:
        if node.direct:
            return "direct"
        if node.required_by:
            return "dependency"
        if node.triggered_by:
            return "dependency-candidate"
        return "dependency"

    def direct_candidates(self) -> list[str]:
        if not self.paths:
            raise SystemExit("at least one --path or --file-list entry is required")
        cmd = ["log", "--no-merges", "--format=%H", f"{self.base}..{self.target}", "--", *self.paths]
        return [x for x in self.git.run(cmd).splitlines() if x]

    def fixes_targets(self, sha: str) -> set[str]:
        result: set[str] = set()
        for short in FIXES_RE.findall(self.body(sha)):
            try:
                full = self.git.run(["rev-parse", "--verify", f"{short}^{{commit}}"]).strip()
            except GitError:
                continue
            result.add(full)
        return result

    def build_fixes_children(self) -> dict[str, set[str]]:
        if self._fixes_children is not None:
            return self._fixes_children
        self.info("Indexing Fixes: relationships in the upstream range...")
        result: dict[str, set[str]] = collections.defaultdict(set)
        raw = self.git.run([
            "log", "--no-merges", "--format=%H%x00%B%x00", f"{self.base}..{self.target}"
        ])
        records: list[tuple[str, str]] = []
        range_shas: list[str] = []
        for sha, body in self._parse_nul_records(raw, 2):
            sha = sha.strip()
            if not sha:
                continue
            records.append((sha, body))
            range_shas.append(sha)
            self._body_cache.setdefault(sha, body)

        shorts_by_record = [(sha, FIXES_RE.findall(body)) for sha, body in records]
        lengths = {len(short) for _, shorts in shorts_by_record for short in shorts}
        prefix_maps: dict[int, dict[str, list[str]]] = {}
        for length in lengths:
            m: dict[str, list[str]] = collections.defaultdict(list)
            for candidate in range_shas:
                m[candidate[:length]].append(candidate)
            prefix_maps[length] = m
        for sha, shorts in shorts_by_record:
            for short in shorts:
                matches = prefix_maps[len(short)].get(short, [])
                if len(matches) == 1:
                    result[matches[0]].add(sha)
        self._fixes_children = result
        return result

    def upstream_before(self, sha: str, child: str) -> bool:
        """Return true when sha is an upstream ancestor of child.

        Dependency discovery is intentionally allowed to cross the planning
        base.  --base limits the initial focus-candidate set; it must not hide
        an older upstream prerequisite that is still missing downstream.
        """
        return sha != child and self.git.is_ancestor(sha, child)

    def is_pre_base_dependency(self, node: CommitNode) -> bool:
        """Return true for a non-focus dependency at or before --base.

        Pre-base dependencies are deliberately terminal during static closure.
        They may be discovered as prerequisites of an in-range commit, but we
        do not recursively mine their own hunk/symbol/Fixes history.  If one of
        them actually conflicts during replay, conflict-driven provenance can
        still discover an older prerequisite in a bounded, evidence-backed way.
        """
        if node.direct:
            return False
        cached = self._pre_base_cache.get(node.sha)
        if cached is None:
            cached = node.sha == self.base or self.git.is_ancestor(node.sha, self.base)
            self._pre_base_cache[node.sha] = cached
        return cached

    def add_explicit_fixes_closure(self, snapshot: Sequence[CommitNode] | None = None) -> int:
        if not self.args.fixes_closure:
            return 0
        added = 0
        children = self.build_fixes_children()
        snapshot = list(snapshot) if snapshot is not None else list(self.nodes.values())
        for node in snapshot:
            if self.is_pre_base_dependency(node):
                continue
            # If a selected commit fixes an earlier upstream commit, that
            # change is part of the semantic context unless it is already
            # downstream.  The target may predate --base; --base limits focus
            # candidates, not proven prerequisites.
            for fixed in node.fixes:
                if self.upstream_before(fixed, node.sha) and self.match(fixed, check_ancestry=True).status == "missing":
                    before_kind = (
                        self.dependency_kind(self.nodes[fixed])
                        if fixed in self.nodes else None
                    )
                    dep_node = self.ensure_node(
                        fixed, reason="Fixes-target", required_by=node.sha
                    )
                    if before_kind != "dependency" and self.dependency_kind(dep_node) == "dependency":
                        added += 1

            # Also include later fixes to a commit we intend to introduce.
            for child in children.get(node.sha, set()):
                if self.git.is_ancestor(child, self.target) and self.match(child).status == "missing":
                    before_kind = (
                        self.dependency_kind(self.nodes[child])
                        if child in self.nodes else None
                    )
                    dep_node = self.ensure_node(
                        child, reason="fixed-by", required_by=node.sha
                    )
                    if before_kind != "dependency" and self.dependency_kind(dep_node) == "dependency":
                        added += 1
        return added

    def parse_hunks(self, sha: str) -> list[DiffHunk]:
        parents = self.git.parents(sha)
        if len(parents) != 1:
            return []
        diff = self.git.run(["diff", "--unified=0", parents[0], sha, "--"])
        path: str | None = None
        hunk: DiffHunk | None = None
        hunks: list[DiffHunk] = []
        for line in diff.splitlines():
            m = DIFF_FILE_RE.match(line)
            if m:
                path = m.group(2)
                hunk = None
                continue
            hm = HUNK_RE.match(line)
            if hm and path:
                hunk = DiffHunk(
                    path=path,
                    old_start=int(hm.group(1)), old_count=int(hm.group(2) or "1"),
                    new_start=int(hm.group(3)), new_count=int(hm.group(4) or "1"),
                    added_lines=[],
                )
                hunks.append(hunk)
                continue
            if hunk and line.startswith("+") and not line.startswith("+++"):
                hunk.added_lines.append(line[1:])
        return hunks

    def blame_commits(self, revision: str, path: str, start: int, end: int) -> collections.Counter[str]:
        if end < start or start < 1:
            return collections.Counter()
        out = self.git.run([
            "blame", "--line-porcelain", revision, "-L", f"{start},{end}", "--", path
        ], check=False)
        counts: collections.Counter[str] = collections.Counter()
        for line in out.splitlines():
            if re.fullmatch(r"[0-9a-f]{40} \d+ \d+(?: \d+)?", line):
                counts[line.split()[0]] += 1
        return counts

    def context_dependencies(self, sha: str, *, only_paths: set[str] | None = None) -> list[tuple[str, str, int]]:
        parents = self.git.parents(sha)
        if len(parents) != 1:
            return []
        parent = parents[0]
        scored: collections.Counter[tuple[str, str]] = collections.Counter()
        for h in self.parse_hunks(sha):
            if only_paths is not None and h.path not in only_paths:
                continue
            # Direct preimage lines are strong provenance. For pure insertions,
            # nearby lines are the only available context, so use a small window.
            if h.old_count > 0:
                direct = self.blame_commits(parent, h.path, h.old_start, h.old_start + h.old_count - 1)
                for dep, n in direct.items():
                    scored[(dep, "hunk-preimage")] += n * 4
            lo = max(1, h.old_start - self.args.context_lines)
            hi = h.old_start + max(h.old_count, 1) - 1 + self.args.context_lines
            nearby = self.blame_commits(parent, h.path, lo, hi)
            for dep, n in nearby.items():
                scored[(dep, "hunk-context")] += n

        by_dep: dict[str, tuple[str, int]] = {}
        for (dep, reason), score in scored.items():
            if dep == sha or dep.startswith("0" * 8):
                continue
            if not self.upstream_before(dep, sha):
                continue
            if self.match(dep, check_ancestry=True).status == "present":
                continue
            prev = by_dep.get(dep)
            if prev is None or score > prev[1]:
                by_dep[dep] = (reason, score)
        return sorted(((dep, reason, score) for dep, (reason, score) in by_dep.items()), key=lambda x: -x[2])

    def extract_symbol_uses(self, sha: str) -> dict[str, set[str]]:
        uses: dict[str, set[str]] = collections.defaultdict(set)
        for h in self.parse_hunks(sha):
            for line in h.added_lines:
                stripped = line.strip()
                if not stripped or stripped.startswith(("/*", "*", "//")):
                    continue
                for sym in FUNC_CALL_RE.findall(line):
                    if sym not in C_KEYWORDS and sym not in IGNORE_SYMBOLS:
                        uses[sym].add(h.path)
                for sym in MACRO_RE.findall(line):
                    if sym not in IGNORE_SYMBOLS and not sym.startswith("CONFIG_"):
                        uses[sym].add(h.path)
        # Avoid turning a large mechanical patch into a symbol-search apocalypse.
        selected = sorted(uses)[: self.args.max_symbols]
        return {symbol: uses[symbol] for symbol in selected}

    def extract_symbols(self, sha: str) -> set[str]:
        return set(self.extract_symbol_uses(sha))

    def definition_dependency_details(
        self,
        sha: str,
        symbols: set[str],
        symbol_use_paths: dict[str, set[str]] | None = None,
    ) -> dict[str, dict[str, object]]:
        parents = self.git.parents(sha)
        if len(parents) != 1 or not symbols:
            return {}
        parent = parents[0]
        ordered = sorted(symbols, key=len, reverse=True)
        pattern = "(" + "|".join(re.escape(sym) for sym in ordered) + ")"
        out = self.git.run([
            "grep", "-n", "-E", pattern, parent, "--", "*.c", "*.h"
        ], check=False)
        definition_lines: dict[str, list[tuple[str, int]]] = collections.defaultdict(list)
        for raw in out.splitlines()[:1000]:
            m = re.match(r"^[^:]+:(.+?):(\d+):(.*)$", raw)
            if not m:
                continue
            path, lineno_s, text = m.groups()
            text_s = text.strip()
            for symbol in ordered:
                if not re.search(rf"\b{re.escape(symbol)}\b", text_s):
                    continue
                definitionish = (
                    re.search(rf"^#\s*define\s+{re.escape(symbol)}\b", text_s)
                    or re.search(rf"\b{re.escape(symbol)}\s*\([^;]*\)\s*(?:\{{|$)", text_s)
                    or re.search(rf"\b(?:enum|struct|union|typedef)\b.*\b{re.escape(symbol)}\b", text_s)
                )
                if definitionish:
                    definition_lines[symbol].append((path, int(lineno_s)))

        result: dict[str, dict[str, object]] = {}
        for symbol, locations in definition_lines.items():
            for path, lineno in locations[:10]:
                use_paths = None if symbol_use_paths is None else symbol_use_paths.get(symbol, set())
                if not self._dt_binding_provider_reachable(
                    sha,
                    path,
                    use_paths,
                ):
                    continue
                blame = self.blame_commits(parent, path, lineno, lineno)
                if not blame:
                    continue
                dep = blame.most_common(1)[0][0]
                if dep != sha and self.upstream_before(dep, sha) and self.match(dep, check_ancestry=True).status == "missing":
                    result[symbol] = {
                        "dependency_sha": dep,
                        "provider_path": path,
                        "namespace_proof": self._dt_binding_namespace_proof(
                            sha, symbol, path, use_paths
                        ),
                    }
                    break
        return result

    def definition_dependencies(
        self,
        sha: str,
        symbols: set[str],
        symbol_use_paths: dict[str, set[str]] | None = None,
    ) -> dict[str, str]:
        """Compatibility wrapper returning only symbol -> dependency SHA."""
        return {
            symbol: str(detail["dependency_sha"])
            for symbol, detail in self.definition_dependency_details(
                sha, symbols, symbol_use_paths
            ).items()
        }

    def add_static_dependencies(self, snapshot: Sequence[CommitNode] | None = None) -> int:
        added = 0
        snapshot = list(snapshot) if snapshot is not None else list(self.nodes.values())
        for node in snapshot:
            if node.match.status == "present" or self.is_pre_base_dependency(node):
                continue
            if self.args.context_deps:
                deps = self.context_dependencies(node.sha)
                for dep, reason, score in deps:
                    # Hunk provenance is useful inside the planning range, but
                    # across --base it becomes far too broad: every touched
                    # line can point at some older upstream authoring commit.
                    # Do not promote that historical provenance to a pre-base
                    # prerequisite unless replay actually conflicts;
                    # add_conflict_dependencies() handles that bounded case.
                    if dep == self.base or self.git.is_ancestor(dep, self.base):
                        continue

                    # Direct hunk preimage is strong prerequisite evidence.
                    # Nearby context, regardless of score, is only an
                    # investigation lead.  Keep high-scoring static context as
                    # a candidate for audit/debugging, but do not select it for
                    # replay or recursively expand it.
                    if reason == "hunk-context" and score < self.args.context_score:
                        continue
                    before_kind = (
                        self.dependency_kind(self.nodes[dep])
                        if dep in self.nodes else None
                    )
                    candidate = self.ensure_node(
                        dep, reason=f"{reason}:{score}", required_by=node.sha
                    )
                    if before_kind != "dependency" and self.dependency_kind(candidate) == "dependency":
                        added += 1
            if self.args.symbol_deps:
                symbol_uses = self.extract_symbol_uses(node.sha)
                for sym, detail in self.definition_dependency_details(
                    node.sha, set(symbol_uses), symbol_uses
                ).items():
                    dep = str(detail["dependency_sha"])
                    before_kind = (
                        self.dependency_kind(self.nodes[dep])
                        if dep in self.nodes else None
                    )
                    dep_node = self.ensure_node(
                        dep, reason=f"symbol:{sym}", required_by=node.sha
                    )
                    proof = detail.get("namespace_proof")
                    if isinstance(proof, dict):
                        dep_node.add_symbol_dependency_proof({
                            **proof,
                            "consumer_sha": node.sha,
                        })
                    if before_kind != "dependency" and self.dependency_kind(dep_node) == "dependency":
                        added += 1
        return added

    def add_dt_include_dependencies(self, snapshot: Sequence[CommitNode]) -> int:
        """Resolve missing DT source includes to their exact introducing commits.

        Inspect the full selected upstream DT file, not an abbreviated advisor
        excerpt. Only promote an exact path provider already in the upstream
        ancestry and absent from the frozen downstream baseline. Do not infer
        providers from a similarly named board or binding.
        """
        if not hasattr(self, "dt_include_unresolved"):
            self.dt_include_unresolved = []
        added = 0
        seen = {(item["consumer_sha"], item["include_path"])
                for item in self.dt_include_unresolved}
        for node in snapshot:
            if node.match.status != "missing":
                continue
            for use_path in node.files:
                if not self._is_dt_source_path(use_path):
                    continue
                source = self._tree_file_text(node.sha, use_path)
                if source is None:
                    continue
                for include in sorted(self._include_paths(source)):
                    resolved = next((candidate
                        for candidate in self._include_candidate_paths(use_path, include)
                        if self._is_dt_source_path(candidate)
                        and self._tree_file_text(node.sha, candidate) is not None), None)
                    if not resolved or resolved == use_path:
                        continue
                    if self._tree_file_text(self.replay_start, resolved) is not None:
                        continue
                    # The consumer may add the included file in the same patch.
                    # That file is available during its cherry-pick, not a
                    # prerequisite from an earlier commit. A file that was
                    # merely modified here still needs its original provider.
                    if (resolved in node.files and
                            self._tree_file_text(f"{node.sha}^", resolved) is None):
                        continue
                    # Find the commit that originally added the exact file.
                    history = self.git.run([
                        "log", "-1", "--format=%H", "--diff-filter=A",
                        f"{node.sha}^", "--", resolved,
                    ]).strip().splitlines()
                    provider_sha = history[0] if history else None
                    if provider_sha and len(self.git.parents(provider_sha)) == 1:
                        existing = self.nodes.get(provider_sha)
                        before = bool(existing and self.is_actionable_node(existing))
                        provider = self.ensure_node(
                            provider_sha, reason=f"dt-include:{resolved}",
                            required_by=node.sha,
                        )
                        if not before and self.is_actionable_node(provider):
                            added += 1
                        if provider.match.status == "present" and (node.sha, resolved) not in seen:
                            # Content matching can mark a provider commit present
                            # even though this precise DTS file is still absent.
                            seen.add((node.sha, resolved))
                            self.dt_include_unresolved.append({
                                "consumer_sha": node.sha,
                                "consumer_subject": node.subject,
                                "include_path": resolved,
                                "reason": f"DT include {resolved} absent despite provider identity match",
                            })
                    elif (node.sha, resolved) not in seen:
                        seen.add((node.sha, resolved))
                        self.dt_include_unresolved.append({
                            "consumer_sha": node.sha,
                            "consumer_subject": node.subject,
                            "include_path": resolved,
                            "reason": f"no verifiable introducing commit for DT include {resolved}",
                        })
        return added

    def dependency_closure(self) -> None:
        self.info("Expanding dependency closure...")
        for round_no in range(1, self.args.max_dependency_rounds + 1):
            # Expand each commit only once.  Re-running blame/grep/Fixes analysis
            # over the entire accumulated set every round is both redundant and
            # extremely expensive once pre-base prerequisites are allowed.
            frontier = [
                node for sha, node in self.nodes.items()
                if sha not in self._dependency_expanded
                and self.is_actionable_node(node)
            ]
            if not frontier:
                break

            before = sum(1 for n in self.nodes.values() if self.is_actionable_node(n))
            added = self.add_explicit_fixes_closure(frontier)
            added += self.add_dt_include_dependencies(frontier)
            added += self.add_static_dependencies(frontier)
            self._dependency_expanded.update(node.sha for node in frontier)

            if not added:
                break
            after = sum(1 for n in self.nodes.values() if self.is_actionable_node(n))
            self.info(f"  dependency round {round_no}: {before} -> {after} selected commits")

    def ordered_missing(self) -> list[str]:
        selected = {
            sha for sha, n in self.nodes.items()
            if self.is_actionable_node(n)
            and n.match.status == "missing"
            and len(self.git.parents(sha)) == 1
        }
        if not selected:
            return []

        # Keep the normal fast path for the common case.  If dependency
        # discovery found prerequisites at/before --base, order those first
        # using the upstream history between the downstream/upstream merge-base
        # and the planning base, then append the usual base..target order.
        pre_base = {
            sha for sha in selected
            if not self.nodes[sha].direct
            and (sha == self.base or self.git.is_ancestor(sha, self.base))
        }
        ordered: list[str] = []
        if pre_base:
            shared = self.git.run(["merge-base", self.base, self.replay_start]).strip()
            pre_order = self.git.run([
                "rev-list", "--reverse", "--topo-order", f"{shared}..{self.base}"
            ]).splitlines()
            ordered.extend(sha for sha in pre_order if sha in pre_base)

        range_order = self.git.run([
            "rev-list", "--reverse", "--topo-order", f"{self.base}..{self.target}"
        ]).splitlines()
        ordered.extend(sha for sha in range_order if sha in selected)
        return self._dependency_order(ordered)

    def _dependency_order(self, upstream_order: list[str]) -> list[str]:
        """Honor active TAKE dependencies without violating Git ancestry.

        The base Git topological order is safe for source history, but an
        independently merged binding can have a later upstream commit date
        than a DTS consumer. Move the binding and any selected ancestors in
        front of the consumer. Never move a Git descendant ahead of its
        ancestor. Cyclic or otherwise unsatisfiable edges stay visible to the
        consistency checker rather than being silently discarded.
        """
        ordered = list(upstream_order)
        positions = {sha: i for i, sha in enumerate(ordered)}
        if not positions:
            return ordered
        edges: set[tuple[str, str]] = set()
        for consumer_sha in ordered:
            consumer = self.nodes[consumer_sha]
            if consumer.advisor_decision != "TAKE":
                continue
            for item in consumer.advisor_prerequisites:
                peer_sha = item["sha"]
                peer = self.nodes.get(peer_sha)
                if (peer_sha in positions and peer and
                        peer.advisor_decision == "TAKE"):
                    edges.add((peer_sha, consumer_sha))
        for provider in self.nodes.values():
            if (provider.sha not in positions or
                    provider.advisor_decision != "TAKE" or
                    not any(reason.startswith("dt-include:")
                            for reason in provider.reasons)):
                continue
            for consumer_sha in provider.required_by:
                if (consumer_sha in positions and
                        self.nodes[consumer_sha].advisor_decision == "TAKE"):
                    edges.add((provider.sha, consumer_sha))
        if not edges:
            return ordered
        cache_key = (tuple(ordered), tuple(sorted(edges)))
        cached = getattr(self, "_dependency_order_cache", None)
        if cached is not None and cached[0] == cache_key:
            return list(cached[1])

        ancestors_cache: dict[str, set[str]] = {}
        # Keep the result deterministic across runs and hash seeds. Previously
        # satisfied edges can become inverted if a consumer must move forward
        # for another dependency; examine until no further legal moves exist.
        seen_orders: set[tuple[str, ...]] = set()
        for _round in range(max(2, 2 * len(edges) + 1)):
            key = tuple(ordered)
            if key in seen_orders:
                break
            seen_orders.add(key)
            changed = False
            for provider_sha, consumer_sha in sorted(edges,
                    key=lambda pair: (positions[pair[1]], positions[pair[0]])):
                if positions[provider_sha] < positions[consumer_sha]:
                    continue
                if provider_sha == consumer_sha:
                    continue
                if provider_sha not in ancestors_cache:
                    # Git rev-list includes the provider itself. Cache the
                    # selected subset, so movement preserves upstream ancestry
                    # even when some intervening commits were not selected.
                    ancestors_cache[provider_sha] = (
                        set(self.git.run(["rev-list", provider_sha]).splitlines())
                        & set(positions)
                    )
                ancestors = ancestors_cache[provider_sha]
                if consumer_sha in ancestors:
                    # A genuine upstream ancestry constraint conflicts with
                    # the advisor recommendation; keep an unresolved warning.
                    continue
                consumer_position = positions[consumer_sha]
                moving = [sha for sha in ordered[consumer_position + 1:]
                          if sha in ancestors]
                if not moving:
                    continue
                move_set = set(moving)
                ordered = [sha for sha in ordered if sha not in move_set]
                new_consumer_position = ordered.index(consumer_sha)
                ordered[new_consumer_position:new_consumer_position] = moving
                positions = {sha: i for i, sha in enumerate(ordered)}
                changed = True
            if not changed:
                break
        self._dependency_order_cache = (cache_key, tuple(ordered))
        return ordered

    def merge_resolution_risks(self) -> None:
        if not self.args.merge_risk:
            return
        self.info("Checking for later merge-resolution risk...")
        for node in self.nodes.values():
            if not self.is_actionable_node(node):
                continue
            if node.match.status == "present" or not node.files:
                continue
            # Path-limited merge history is only a coarse first filter. Confirm
            # that the merge itself has a combined diff for at least one file.
            merges = self.git.run([
                "log", "--format=%H", "--merges", "--ancestry-path",
                f"{node.sha}..{self.target}", "--", *node.files
            ], check=False).splitlines()
            for merge in merges[: self.args.max_merge_risks]:
                combined = self.git.run([
                    "diff-tree", "-c", "--cc", "--name-only", "-r", merge, "--", *node.files
                ], check=False)
                touched = {x for x in combined.splitlines() if "/" in x or x in node.files}
                if touched:
                    node.merge_risk.append(merge)

    def _create_worktree(self) -> tuple[Path, Path]:
        root = Path(tempfile.mkdtemp(prefix="backport-plan-"))
        wt = root / "wt"
        self.git.run(["worktree", "add", "--detach", str(wt), self.replay_start])
        return root, wt

    def _remove_worktree(self, root: Path, wt: Path) -> None:
        self.git.run(["worktree", "remove", "--force", str(wt)], check=False)
        shutil.rmtree(root, ignore_errors=True)

    def replay_once(self) -> tuple[bool, list[tuple[str, list[str]]]]:
        order = self.ordered_missing()
        if not order:
            return True, []
        root, wt = self._create_worktree()
        conflicts: list[tuple[str, list[str]]] = []
        try:
            wg = Git(wt, self.args.debug, getattr(self, "performance", None))
            for sha in order:
                node = self.nodes[sha]
                cp = subprocess.run(
                    ["git", "cherry-pick", "--no-commit", sha], cwd=str(wt),
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                )
                if cp.returncode:
                    files = [x for x in wg.run([
                        "diff", "--name-only", "--diff-filter=U"
                    ], check=False).splitlines() if x]
                    node.replay = "conflict"
                    node.conflict_files = files
                    conflicts.append((sha, files))
                    wg.run(["cherry-pick", "--abort"], check=False)
                    wg.run(["reset", "--hard", "HEAD"], check=False)
                    # Continue so we can report independent conflicts; later
                    # commits may of course fail because this one was skipped.
                    continue

                tree = wg.run(["write-tree"]).strip()
                msg = self.body(sha)
                cp2 = subprocess.run(
                    ["git", "commit-tree", tree, "-p", "HEAD"], cwd=str(wt),
                    input=msg, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    env={**os.environ, "GIT_AUTHOR_NAME": "backport-plan",
                         "GIT_AUTHOR_EMAIL": "backport-plan@example.invalid",
                         "GIT_COMMITTER_NAME": "backport-plan",
                         "GIT_COMMITTER_EMAIL": "backport-plan@example.invalid"},
                )
                if cp2.returncode:
                    raise GitError(cp2.stderr)
                new_commit = cp2.stdout.strip()
                wg.run(["reset", "--hard", new_commit])
                node.replay = "clean"
            return not conflicts, conflicts
        finally:
            self._remove_worktree(root, wt)

    def add_conflict_dependencies(
        self, conflicts: list[tuple[str, list[str]]]
    ) -> tuple[int, int]:
        strong_added = 0
        candidates_added = 0
        for sha, files in conflicts:
            deps = self.context_dependencies(sha, only_paths=set(files))
            # Inspect only the strongest few provenance commits per conflicted
            # commit. Hunk preimage can select/promote a real dependency. Pure
            # nearby context remains informational regardless of score.
            considered = 0
            for dep, reason, score in deps:
                if considered >= self.args.max_conflict_deps:
                    break
                considered += 1
                existed = dep in self.nodes
                before_kind = (self.dependency_kind(self.nodes[dep]) if existed else None)
                node = self.ensure_node(
                    dep, reason=f"conflict-{reason}:{score}", required_by=sha
                )
                after_kind = self.dependency_kind(node)
                if before_kind != "dependency" and after_kind == "dependency":
                    strong_added += 1
                elif not existed and after_kind == "dependency-candidate":
                    candidates_added += 1
        return strong_added, candidates_added

    def reset_replay_annotations(self) -> None:
        for n in self.nodes.values():
            n.replay = "not-run"
            n.conflict_files = []

    def replay_with_discovery(self) -> None:
        if not self.args.simulate:
            return
        self.info("Dry-running the backport plan in a temporary worktree...")
        needs_final_verification = False
        for round_no in range(1, self.args.max_replay_rounds + 1):
            self.replay_rounds_run = round_no
            self.reset_replay_annotations()
            ok, conflicts = self.replay_once()
            if ok:
                self.info(f"  replay round {round_no}: clean")
                return
            self.info(f"  replay round {round_no}: {len(conflicts)} conflicting commits")
            strong_added, candidates_added = self.add_conflict_dependencies(conflicts)
            if candidates_added:
                self.info(
                    f"  recorded {candidates_added} context-only dependency candidate(s)"
                )
            if not strong_added:
                return
            self.info(
                f"  added/promoted {strong_added} strong prerequisite(s) from conflict provenance"
            )
            self.dependency_closure()
            needs_final_verification = round_no == self.args.max_replay_rounds

        # If the final discovery round added commits, the replay annotations above
        # describe the pre-discovery set. Run once more without discovering any
        # further dependencies so the report reflects the complete printed set.
        if needs_final_verification:
            self.replay_final_verification = True
            self.reset_replay_annotations()
            ok, conflicts = self.replay_once()
            if ok:
                self.info("  final replay verification: clean")
            else:
                self.info(
                    f"  final replay verification: {len(conflicts)} conflicting commits"
                )

    def run_check_command(self) -> tuple[int, str] | None:
        if not self.args.check_command:
            return None
        # Recreate a fully-applied worktree. If replay still conflicts, don't
        # pretend a build check is meaningful.
        if any(
            n.replay == "conflict"
            for n in self.nodes.values()
            if self.is_actionable_node(n) and n.match.status == "missing"
        ):
            return (125, "not run because replay still has conflicts")
        root, wt = self._create_worktree()
        try:
            wg = Git(wt, self.args.debug)
            for sha in self.ordered_missing():
                cp = subprocess.run(["git", "cherry-pick", "--no-commit", sha], cwd=str(wt),
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                if cp.returncode:
                    return (125, f"replay conflict at {sha}")
                tree = wg.run(["write-tree"]).strip()
                cp2 = subprocess.run(
                    ["git", "commit-tree", tree, "-p", "HEAD"], cwd=str(wt),
                    input=self.body(sha), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    env={**os.environ, "GIT_AUTHOR_NAME": "backport-plan",
                         "GIT_AUTHOR_EMAIL": "backport-plan@example.invalid",
                         "GIT_COMMITTER_NAME": "backport-plan",
                         "GIT_COMMITTER_EMAIL": "backport-plan@example.invalid"},
                )
                if cp2.returncode:
                    return (125, cp2.stderr)
                wg.run(["reset", "--hard", cp2.stdout.strip()])
            cp = subprocess.run(self.args.check_command, cwd=str(wt), shell=True, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            return cp.returncode, cp.stdout
        finally:
            self._remove_worktree(root, wt)

    @staticmethod
    def _series_identity(body: str) -> list[tuple[str, int]]:
        """Return conservative (series-key, patch-number) identities from Link: trailers.

        Kernel commits normally carry a lore Link: for the posted patch.  git
        send-email/b4 message IDs commonly encode the patch number as the last
        numeric hyphen-delimited component before the sender suffix.  We only
        group commits when at least two commits reachable from the upstream
        target normalize to the same key; ambiguous one-offs are ignored.
        """
        identities: list[tuple[str, int]] = []
        for msgid in LINK_MSGID_RE.findall(body):
            m = SERIES_MSGID_RE.match(msgid)
            if not m:
                continue
            prefix, patch_no_s, suffix = m.groups()
            identities.append((f"{prefix}-N-{suffix}".lower(), int(patch_no_s)))
        return identities

    @staticmethod
    def _series_search_term(key: str) -> str | None:
        """Return a fixed-string grep term that narrows history to one series.

        _series_identity() replaces the numeric patch component with ``-n-``.
        The prefix before that marker is shared by all messages in a normal
        git-send-email series and is specific enough to make git-log's message
        grep cheap.  Exact identity matching is still done after the grep, so a
        prefix collision cannot merge unrelated series.
        """
        prefix, marker, _suffix = key.partition("-n-")
        if not marker or not prefix:
            return None
        return prefix + "-"

    def build_series_index(self) -> None:
        self.info("Indexing patch-series relationships...")

        # Series discovery is selected-commit driven.  Dependency discovery can
        # legitimately pull a prerequisite from at/before --base into
        # self.nodes, so restricting this index to base..target would hide that
        # commit's posted series.  Start with the Lore identities of selected
        # commits, then use one grep-filtered walk of all history reachable from
        # --target to find their peers.  This gets cross-base series context
        # without scanning every commit message in the repository.
        selected = {
            sha for sha, node in self.nodes.items()
            if self.is_actionable_node(node)
        }
        selected_keys: dict[str, dict[str, int]] = collections.defaultdict(dict)
        for sha in selected:
            for key, patch_no in self._series_identity(self.body(sha)):
                selected_keys[key][sha] = patch_no

        self.series_groups.clear()
        for node in self.nodes.values():
            node.series_ids.clear()

        if not selected_keys:
            self.info("  found 0 patch series touching selected commits")
            return

        search_terms = sorted({
            term
            for key in selected_keys
            if (term := self._series_search_term(key)) is not None
        })
        if not search_terms:
            self.info("  found 0 patch series touching selected commits")
            return

        cmd = [
            "log", "--reverse", "--no-merges", "--format=%H%x00%B%x00",
            "--fixed-strings", "--regexp-ignore-case",
        ]
        cmd.extend(f"--grep={term}" for term in search_terms)
        cmd.append(self.target)
        raw = self.git.run(cmd)

        grouped: dict[str, dict[str, int]] = collections.defaultdict(dict)
        upstream_order: dict[str, int] = {}
        for pos, (sha, body) in enumerate(self._parse_nul_records(raw, 2)):
            sha = sha.strip()
            if not sha:
                continue
            upstream_order[sha] = pos
            self._body_cache.setdefault(sha, body)
            for key, patch_no in self._series_identity(body):
                if key in selected_keys:
                    grouped[key][sha] = patch_no

        # Selected commits should have been returned by the target-history grep
        # when they are reachable from --target.  Keep them explicitly anyway:
        # this makes the index robust to unusual Link formatting/search quirks
        # while still requiring at least one peer before reporting a series.
        for key, members in selected_keys.items():
            grouped[key].update(members)

        relevant: list[tuple[int, str, list[tuple[int, str]]]] = []
        for key, members_by_sha in grouped.items():
            if len(members_by_sha) < 2:
                continue
            selected_members = selected.intersection(members_by_sha)
            if not selected_members:
                continue
            members = sorted(
                ((patch_no, sha) for sha, patch_no in members_by_sha.items()),
                key=lambda item: (item[0], upstream_order.get(item[1], 10**12)),
            )
            first_selected_pos = min(upstream_order.get(sha, 10**12) for sha in selected_members)
            relevant.append((first_selected_pos, key, members))

        relevant.sort(key=lambda item: (item[0], item[1]))
        for idx, (_pos, _key, members) in enumerate(relevant, 1):
            label = f"S{idx:03d}"
            self.series_groups[label] = members
            for _patch_no, sha in members:
                if sha in selected:
                    self.nodes[sha].series_ids.add(label)

        self.info(f"  found {len(self.series_groups)} patch series touching selected commits")

    def collect(self) -> None:
        with self._phase("collect.downstream_index"):
            self.build_downstream_index()
        with self._phase("collect.direct_candidates"):
            direct = self.direct_candidates()
            self.info(f"Found {len(direct)} direct path candidates")
            for sha in direct:
                self.ensure_node(sha, direct=True, reason="focus-path")
        with self._phase("collect.dependency_closure"):
            self.dependency_closure()
        with self._phase("collect.merge_resolution"):
            self.merge_resolution_risks()
        with self._phase("collect.replay"):
            self.replay_with_discovery()
        with self._phase("collect.series_index"):
            self.build_series_index()

    def report_text(self, check_result: tuple[int, str] | None = None) -> str:
        lines: list[str] = []
        actionable = [n for n in self.nodes.values() if self.is_actionable_node(n)]
        direct = sum(1 for n in actionable if n.direct)
        present = sum(1 for n in actionable if n.match.status == "present")
        missing = sum(1 for n in actionable if n.match.status == "missing")
        deps = sum(
            1 for n in actionable
            if not n.direct and self.dependency_kind(n) == "dependency"
        )
        tentative = sum(
            1 for n in self.nodes.values()
            if not n.direct and self.dependency_kind(n) == "dependency-candidate"
        )
        lines.append(f"base:         {self.base[:12]}")
        lines.append(f"target:       {self.target[:12]}")
        lines.append(f"downstream:   {self.downstream[:12]}")
        lines.append(
            f"replay-start: {self.replay_start[:12]} ({self.replay_start_source})"
        )
        lines.append(f"paths:        {', '.join(self.paths)}")
        lines.append(
            f"plan:         {len(actionable)} "
            f"({direct} direct, {deps} dependency)"
        )
        if getattr(self, "advisor_model", None):
            advised_nodes = [n for n in actionable if n.advisor_decision]
            successful = [n for n in advised_nodes if not n.advisor_error]
            counts = collections.Counter(n.advisor_decision for n in successful)
            failures = sum(1 for n in advised_nodes if n.advisor_error)
            lines.append(f"advisor-model: {self.advisor_model}")
            if getattr(self, "advisor_fallback_model", None):
                lines.append(
                    f"advisor-fallback: {self.advisor_fallback_model}; "
                    f"{self.advisor_fallback_evaluated} evaluated, "
                    f"{self.advisor_fallback_accepted} valid, "
                    f"{self.advisor_fallback_changed} changed decisions, "
                    f"{self.advisor_fallback_take} new TAKE, "
                    f"{self.advisor_fallback_failures} failed, "
                    f"{self.advisor_fallback_deferred_retries} delayed retries, "
                    f"{self.advisor_fallback_recovered} recovered, "
                    f"{self.advisor_fallback_unprocessed} unprocessed")
            lines.append(
                f"advisor:      {len(successful)} recommendation(s) "
                f"({counts.get('TAKE', 0)} TAKE, {counts.get('SKIP', 0)} SKIP, "
                f"{counts.get('REVIEW', 0)} REVIEW), {failures} advisor failure(s) -> REVIEW"
            )
            lines.append(
                f"advisor-run:  {getattr(self, 'advisor_calls', 0)} model call(s), "
                f"{getattr(self, 'advisor_retries_used', 0)} retry/retries "
                f"({getattr(self, 'advisor_policy_rechecks', 0)} policy rechecks), "
                f"{getattr(self, 'advisor_cache_hits', 0)} cache hit(s), "
                f"{getattr(self, 'advisor_reconsiderations', 0)} reconsideration(s), "
                f"{getattr(self, 'advisor_binding_rechecks', 0)} binding disagreement recheck(s), "
                f"{getattr(self, 'advisor_error_log_entries', 0)} diagnostic error record(s)"
            )
            if getattr(self, "advisor_error_log_entries", 0) and self.advisor_error_log_path:
                lines.append(f"advisor-error-log: {self.advisor_error_log_path}")
            coverage = getattr(self, "dt_binding_candidate_links", {})
            lines.append(
                f"binding-coverage: {sum(map(len, coverage.values()))} "
                f"candidate relationship(s) across {len(coverage)} consumer(s)"
            )
            consistency = getattr(self, "advisor_consistency_issues", [])
            if consistency:
                consistency_counts = collections.Counter(x["kind"] for x in consistency)
                lines.append(
                    "advisor-consistency: "
                    + f"{len(consistency)} unresolved issue(s) ("
                    + ", ".join(
                        f"{kind}={count}" for kind, count in sorted(consistency_counts.items())
                    )
                    + ")"
                )
            else:
                lines.append("advisor-consistency: 0 unresolved TAKE->prerequisite issue(s)")
            if getattr(self, "advisor_failure_kinds", None):
                lines.append(
                    "advisor-failures: "
                    + ", ".join(
                        f"{kind}={count}"
                        for kind, count in sorted(self.advisor_failure_kinds.items())
                    )
                )
        if self.args.show_dependency_candidates:
            lines.append(f"dependency-candidates: {tentative} informational")
        lines.append(f"status:       {missing} missing, {present} already downstream")
        lines.append("")

        lines.append("BACKPORT PLAN (oldest first)")
        lines.append("=" * 80)
        for sha in self.ordered_missing():
            n = self.nodes[sha]
            if not self.is_actionable_node(n):
                continue
            kind = self.dependency_kind(n)
            label = ""
            if kind == "dependency":
                label = " [DEPENDENCY]"
            advisor_comment = ""
            if n.advisor_decision:
                advisor_comment = " // " + n.advisor_decision.title()
            lines.append(f'{sha[:12]}{label} ("{n.subject}"){advisor_comment}')

            # Focus-path selection is the default and is therefore left
            # unmarked; only exceptional dependency commits are labeled.
            if n.reasons and n.reasons != {"focus-path"}:
                lines.append(f"      evidence: {', '.join(sorted(n.reasons))}")
            for proof in sorted(
                n.symbol_dependency_proofs,
                key=lambda item: (
                    str(item.get("symbol", "")),
                    str(item.get("consumer_sha", "")),
                    str(item.get("provider_path", "")),
                ),
            ):
                use_paths = ",".join(str(x) for x in proof.get("consumer_use_paths", []))
                lines.append(
                    "      symbol-namespace-proof: "
                    f'{proof.get("symbol", "?")} '
                    f'provider={proof.get("provider_path", "?")} '
                    f'consumer={str(proof.get("consumer_sha", ""))[:12]} '
                    f'use={use_paths or "?"} '
                    f'verification={proof.get("verification", "?")}'
                )
            if n.series_ids:
                lines.append(
                    "      same-series: "
                    + ", ".join(sorted(n.series_ids))
                    + " (see SAME PATCH SERIES section)"
                )

            # A Fixes: target at/before the planning base is important semantic
            # context.  Show it explicitly whether it is already downstream or
            # has now been pulled into the plan as a pre-base dependency.
            # In-range Fixes relationships are already represented by the
            # dependency/required-by machinery.
            for fixed in sorted(n.fixes):
                if fixed == self.base or self.git.is_ancestor(fixed, self.base):
                    lines.append(
                        f'      Fixes: {fixed[:12]} ("{self.subject(fixed)}") '
                        f'[Predates {self.args.base}]'
                    )

            if n.required_by:
                lines.append(
                    "      required-by: " + ", ".join(x[:12] for x in sorted(n.required_by))
                )
            if n.replay != "not-run":
                extra = f" ({', '.join(n.conflict_files)})" if n.conflict_files else ""
                lines.append(f"      replay: {n.replay}{extra}")
            if n.merge_risk:
                lines.append("      later merge-resolution risk: " + ", ".join(x[:12] for x in n.merge_risk))
            if n.subject_hints:
                lines.append("      same-subject downstream hint (NOT proof): " +
                             ", ".join(x[:12] for x in n.subject_hints[:5]))
            if n.advisor_decision:
                lines.append(f"      advisor: {n.advisor_decision}")
                if n.advisor_rationale:
                    lines.append(
                        f"      advisor-rationale: {self._one_line(n.advisor_rationale)}"
                    )
                for item in n.advisor_prerequisites:
                    peer_sha = item["sha"]
                    evidence = ""
                    if item.get("evidence_id"):
                        detail = ":".join(
                            x for x in (
                                item.get("evidence_kind", ""),
                                item.get("evidence_object", ""),
                            ) if x
                        )
                        evidence = f' [evidence {item["evidence_id"]}' + (f" {detail}" if detail else "") + "]"
                    lines.append(
                        f'      advisor-prerequisite: {peer_sha[:12]} '
                        f'("{self.subject(peer_sha)}"){evidence} - {self._one_line(item["reason"])}'
                    )
                for item in n.advisor_binding_assessments:
                    lines.append(
                        f'      advisor-binding-assessment: {item["evidence_id"]} '
                        f'{item["disposition"]} - {self._one_line(item["reason"])}'
                    )
                for item in n.advisor_rejected_prerequisites:
                    peer_sha = item["sha"]
                    lines.append(
                        f'      advisor-rejected-prerequisite: {peer_sha[:12]} '
                        f'("{self.subject(peer_sha)}") evidence={item.get("evidence_id", "?")} '
                        f'NOT_REQUIRED - {self._one_line(item.get("assessment_reason", ""))}'
                    )
                for item in n.advisor_recommended_by:
                    lines.append(
                        f'      advisor-recommended-by: {item["consumer_sha"][:12]} '
                        f'("{item["consumer_subject"]}") [{item.get("consumer_decision", "?")}] '
                        f'evidence={item.get("evidence_id", "?")} '
                        f'{item.get("evidence_kind", "?")}:{item.get("evidence_object", "?")}'
                    )
                for item in n.advisor_inbound_assessments:
                    lines.append(
                        f'      advisor-inbound-assessment: {item["evidence_id"]} '
                        f'{item["disposition"]} - {self._one_line(item["reason"])}'
                    )
                for item in n.advisor_consistency_warnings:
                    if item.get("kind") == "TAKE->MISSING_DT_INCLUDE":
                        text = f'missing DT source include {item["include_path"]}: {item["reason"]}'
                    elif item.get("role") == "consumer":
                        text = (
                            f'prerequisite {item["prerequisite_sha"][:12]} '
                            f'{item["kind"]} ({item.get("reason", "")})'
                        )
                    else:
                        text = (
                            f'recommended by TAKE consumer {item["consumer_sha"][:12]} '
                            f'but relationship is {item["kind"]}'
                        )
                    lines.append(f"      advisor-consistency-warning: {text}")
                for risk in n.advisor_risks:
                    lines.append(f"      advisor-risk: {self._one_line(risk)}")
                if n.advisor_error:
                    lines.append(
                        f"      advisor-error: {n.advisor_error_kind or 'unknown'}: "
                        f"{self._one_line(n.advisor_error)}"
                    )

        if self.args.show_dependency_candidates:
            candidates = sorted(
                (n for n in self.nodes.values()
                 if self.dependency_kind(n) == "dependency-candidate"),
                key=lambda n: n.sha,
            )
            if candidates:
                lines.append("")
                lines.append("DEPENDENCY CANDIDATES (informational; not selected or replayed)")
                lines.append("=" * 80)
                for n in candidates:
                    lines.append(f'{n.sha[:12]} [DEPENDENCY-CANDIDATE] ("{n.subject}")')
                    if n.reasons:
                        lines.append(f"      evidence: {', '.join(sorted(n.reasons))}")
                    if n.triggered_by:
                        lines.append(
                            "      triggered-by: "
                            + ", ".join(x[:12] for x in sorted(n.triggered_by))
                        )

        if self.series_groups:
            lines.append("")
            lines.append(
                "SAME PATCH SERIES (Link/Message-ID derived; peers are informational, not dependencies)"
            )
            lines.append("=" * 80)
            for label, members in self.series_groups.items():
                selected_count = sum(
                    1 for _patch_no, sha in members
                    if sha in self.nodes and self.is_actionable_node(self.nodes[sha])
                )
                lines.append(
                    f"{label}: {len(members)} commits found through upstream target; "
                    f"{selected_count} selected by planner"
                )
                missing_peers = 0
                for patch_no, sha in members:
                    selected_member = (
                        sha in self.nodes and self.is_actionable_node(self.nodes[sha])
                    )
                    role = "SELECTED" if selected_member else "PEER"
                    m = self.match(sha)
                    status = m.status.upper()
                    if not selected_member and m.status == "missing":
                        missing_peers += 1
                    lines.append(
                        f"      patch {patch_no:2d}: [{role:<8} {status:<7}] "
                        f'{sha[:12]} ("{self.subject(sha)}")'
                    )
                    if m.status == "present":
                        downstream = m.downstream_sha[:12] if m.downstream_sha else "unknown"
                        lines.append(
                            f"                via {m.method}: {downstream}"
                        )
                if missing_peers:
                    lines.append(
                        f"      warning: {missing_peers} same-series peer(s) are missing downstream"
                    )

        lines.append("")
        lines.append("ALREADY DOWNSTREAM")
        lines.append("=" * 80)
        for n in sorted(
            (x for x in self.nodes.values()
             if self.is_actionable_node(x) and x.match.status == "present"),
            key=lambda x: x.sha,
        ):
            lines.append(f'{n.sha[:12]} ("{n.subject}")')
            downstream = n.match.downstream_sha[:12] if n.match.downstream_sha else "unknown"
            lines.append(
                f"      via {n.match.method}: {downstream}"
                f"  confidence={n.match.confidence}"
            )

        unresolved = [
            n for n in self.nodes.values()
            if self.is_actionable_node(n) and n.replay == "conflict"
        ]
        if unresolved:
            lines.append("")
            lines.append("UNRESOLVED REPLAY CONFLICTS")
            lines.append("=" * 80)
            for n in unresolved:
                lines.append(f'{n.sha[:12]} ("{n.subject}")')
                lines.append("      " + ", ".join(n.conflict_files))

        if check_result is not None:
            rc, output = check_result
            lines.append("")
            lines.append(f"CHECK COMMAND: rc={rc}")
            lines.append("=" * 80)
            if output:
                lines.append(output.rstrip())
        return "\n".join(lines) + "\n"

