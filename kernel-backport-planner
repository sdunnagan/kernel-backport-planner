def advisor_response_schema(
    prerequisite_evidence: Sequence[dict[str, str]],
    inbound_recommendations: Sequence[dict[str, str]] = (),
) -> dict:
    """Build the per-commit structured-output schema.

    Prerequisite recommendations must point at deterministic evidence records,
    not merely at any earlier missing same-series SHA.  Inbound prerequisite
    assessments are likewise constrained to recommendations already made by
    TAKE consumers.
    """
    evidence = list(prerequisite_evidence)
    schema = json.loads(json.dumps(ADVISOR_RESPONSE_SCHEMA))
    prereqs = schema["properties"]["prerequisite_evidence_ids"]
    evidence_ids = list(dict.fromkeys(x["evidence_id"] for x in evidence))
    if evidence_ids:
        prereqs["items"] = {"type": "string", "enum": evidence_ids}
        prereqs["maxItems"] = len(evidence_ids)
    else:
        prereqs["maxItems"] = 0

    bindings = schema["properties"]["binding_evidence_assessments"]
    binding_ids = list(dict.fromkeys(
        x["evidence_id"] for x in evidence
        if x.get("kind") in ("compatible-binding", "dt-property-binding")
    ))
    if binding_ids:
        bindings["items"]["properties"]["evidence_id"] = {
            "type": "string", "enum": binding_ids
        }
        # SKIP/REVIEW decisions need no binding assessment; TAKE does.
        bindings["maxItems"] = len(binding_ids)
    else:
        bindings["maxItems"] = 0

    inbound = schema["properties"]["inbound_prerequisite_assessments"]
    inbound_ids = list(dict.fromkeys(
        x["evidence_id"] for x in inbound_recommendations if x.get("evidence_id")
    ))
    if inbound_ids:
        inbound["items"]["properties"]["evidence_id"] = {
            "type": "string", "enum": inbound_ids
        }
        inbound["minItems"] = len(inbound_ids)
        inbound["maxItems"] = len(inbound_ids)
    else:
        inbound["maxItems"] = 0
    return schema



