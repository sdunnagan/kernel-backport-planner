    advisor_consistency_warnings: list[dict[str, str]] = dataclasses.field(default_factory=list)
    advisor_risks: list[str] = dataclasses.field(default_factory=list)
    advisor_error: str | None = None
    advisor_error_kind: str | None = None
    advisor_attempts: int = 0
    advisor_decision_model: str | None = None
    advisor_primary_result: dict | None = None
    advisor_fallback_result: dict | None = None
    advisor_fallback_history: list[dict] = dataclasses.field(default_factory=list)
    advisor_escalation_reasons: list[str] = dataclasses.field(default_factory=list)
    symbol_dependency_proofs: list[dict[str, object]] = dataclasses.field(default_factory=list)

    def add_reason(
        self, reason: str, parent: str | None = None, *, tentative: bool = False
    ) -> None:
        self.reasons.add(reason)
        if not parent:
            return
        if tentative:
            if parent not in self.required_by:
                self.triggered_by.add(parent)
            return
        self.required_by.add(parent)
        self.triggered_by.discard(parent)

    def add_symbol_dependency_proof(self, proof: dict[str, object]) -> None:
        if proof not in self.symbol_dependency_proofs:
            self.symbol_dependency_proofs.append(proof)


