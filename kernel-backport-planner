class PerformanceRecorder:
    """Lightweight phase, Git and advisor timings, durable during long runs.

    JSONL events never contain code, prompts, patches, or model responses.
    The final summary also omits that material.
    """

    def __init__(self, path: Path | None = None):
        self.started = time.perf_counter()
        self.events_path = path
        self.events = path.open("x", encoding="utf-8", buffering=1) if path else None
        self.phases: dict[str, dict[str, float | int]] = {}
        self.git_commands: dict[str, dict[str, float | int]] = {}
        self.advisor_requests = 0
        self.advisor_seconds = 0.0
        self.advisor_failures = 0
        self.advisor_cache_hits = 0
        self.advisor_input_bytes = 0
        self.advisor_metrics: dict[str, int] = collections.defaultdict(int)
        self.advisor_models: dict[str, dict[str, float | int]] = {}
        self._pending_events = 0
        self.event("run_start", version=VERSION)

    def event(self, kind: str, **fields) -> None:
        if not self.events:
            return
        self.events.write(json.dumps({"event": kind, "elapsed_s": round(
            time.perf_counter() - self.started, 3), **fields},
            sort_keys=True) + "\n")
        self._pending_events += 1
        # Flush/fsync occasionally: retain data after a hard interruption
        # without a synchronous disk write on every model request.
        if self._pending_events >= 10 or kind == "phase_end":
            self.events.flush()
            os.fsync(self.events.fileno())
            self._pending_events = 0

    @contextlib.contextmanager
    def phase(self, name: str):
        started = time.perf_counter()
        self.event("phase_start", name=name)
        try:
            yield
        finally:
            seconds = time.perf_counter() - started
            entry = self.phases.setdefault(name, {"count": 0, "seconds": 0.0})
            entry["count"] += 1
            entry["seconds"] += seconds
            self.event("phase_end", name=name, seconds=round(seconds, 3))

    def git(self, operation: str, seconds: float) -> None:
        entry = self.git_commands.setdefault(operation,
                                             {"count": 0, "seconds": 0.0, "max_seconds": 0.0})
        entry["count"] += 1
        entry["seconds"] += seconds
        entry["max_seconds"] = max(entry["max_seconds"], seconds)

    def advisor(self, sha: str, attempt: int, seconds: float, *,
                input_bytes: int = 0, status: str = "ok",
                ollama: dict | None = None, model: str | None = None,
                stage: str = "primary") -> None:
        self.advisor_requests += 1
        self.advisor_seconds += seconds
        self.advisor_input_bytes += input_bytes
        if model:
            entry = self.advisor_models.setdefault(model, {"requests": 0,
                "seconds": 0.0, "failed_attempts": 0})
            entry["requests"] += 1
            entry["seconds"] += seconds
            if status != "ok":
                entry["failed_attempts"] += 1
        if status != "ok":
            self.advisor_failures += 1
        measurements = {}
        for key in ("total_duration", "load_duration", "prompt_eval_duration",
                    "eval_duration", "prompt_eval_count", "eval_count"):
            value = (ollama or {}).get(key)
            if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
                measurements[key] = value
                self.advisor_metrics[key] += value
        self.event("advisor_request", sha=sha[:12], attempt=attempt,
                   model=model, stage=stage,
                   seconds=round(seconds, 3), status=status,
                   input_bytes=input_bytes, ollama=measurements)

    def cache_hit(self, sha: str) -> None:
        self.advisor_cache_hits += 1
        self.event("advisor_cache_hit", sha=sha[:12])

    def summary(self) -> dict:
        return {
            "version": VERSION,
            "elapsed_seconds": round(time.perf_counter() - self.started, 3),
            "phases": {k: {"count": v["count"], "seconds": round(v["seconds"], 3)}
                       for k, v in sorted(self.phases.items())},
            "git_commands": {k: {"count": v["count"],
                                 "seconds": round(v["seconds"], 3),
                                 "max_seconds": round(v["max_seconds"], 3)}
                             for k, v in sorted(self.git_commands.items())},
            "advisor": {"requests": self.advisor_requests,
                        "request_seconds": round(self.advisor_seconds, 3),
                        "failed_attempts": self.advisor_failures,
                        "cache_hits": self.advisor_cache_hits,
                        "packet_input_bytes": self.advisor_input_bytes,
                        "ollama": dict(self.advisor_metrics),
                        "per_model": {k: {**v,
                            "seconds": round(v["seconds"], 3)}
                            for k, v in sorted(self.advisor_models.items())}},
            "events_path": str(self.events_path) if self.events_path else None,
        }

    def finish(self, summary_path: Path | None = None) -> dict:
        snapshot = self.summary()
        self.event("run_end", seconds=snapshot["elapsed_seconds"])
        if summary_path:
            with summary_path.open("x", encoding="utf-8") as output:
                json.dump(snapshot, output, indent=2, sort_keys=True)
                output.write("\n")
        if self.events:
            self.events.flush()
            os.fsync(self.events.fileno())
            self.events.close()
        return snapshot

    def abort(self) -> None:
        if self.events and not self.events.closed:
            self.events.flush()
            self.events.close()


class GitError(RuntimeError):
    pass


class Git:
    def __init__(self, cwd: Path, debug: bool = False,
                 performance: PerformanceRecorder | None = None):
        self.cwd = cwd
        self.debug = debug
        self.performance = performance

    def run(
        self,
        args: Sequence[str],
        *,
        check: bool = True,
        input_text: str | None = None,
        cwd: Path | None = None,
    ) -> str:
        cmd = ["git", *args]
        if self.debug:
            print("+", shlex.join(cmd), file=sys.stderr)
        started = time.perf_counter()
        try:
            cp = subprocess.run(
                cmd, cwd=str(cwd or self.cwd), input=input_text,
                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            )
        finally:
            if self.performance is not None:
                self.performance.git(args[0] if args else "unknown",
                                     time.perf_counter() - started)
        if check and cp.returncode:
            raise GitError(
                f"command failed ({cp.returncode}): {shlex.join(cmd)}\n{cp.stderr.strip()}"
            )
        return cp.stdout

    def ok(self, args: Sequence[str], *, cwd: Path | None = None) -> bool:
        started = time.perf_counter()
        try:
            cp = subprocess.run(
                ["git", *args], cwd=str(cwd or self.cwd),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        finally:
            if self.performance is not None:
                self.performance.git(args[0] if args else "unknown",
                                     time.perf_counter() - started)
        return cp.returncode == 0

    def rev_parse(self, obj: str) -> str:
        return self.run(["rev-parse", "--verify", f"{obj}^{{commit}}"]).strip()

    def subject(self, sha: str) -> str:
        return self.run(["show", "-s", "--format=%s", sha]).strip()

    def body(self, sha: str) -> str:
        return self.run(["show", "-s", "--format=%B", sha])

    def parents(self, sha: str) -> list[str]:
        fields = self.run(["show", "-s", "--format=%P", sha]).strip().split()
        return fields

    def changed_files(self, sha: str) -> list[str]:
        return [x for x in self.run([
            "diff-tree", "--no-commit-id", "--name-only", "-r", sha
        ]).splitlines() if x]

    def is_ancestor(self, older: str, newer: str) -> bool:
        return self.ok(["merge-base", "--is-ancestor", older, newer])


