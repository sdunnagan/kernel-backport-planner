    p.add_argument(
        "--advisor-timeout", type=float, default=300.0,
        help="per-commit advisor request timeout in seconds (default: 300)",
    )
    p.add_argument(
        "--advisor-retries", type=int, default=2,
        help="retry transient/invalid advisor responses this many times (default: 2)",
    )
    p.add_argument(
        "--advisor-retry-delay", type=float, default=1.0,
        help="initial seconds between advisor retries; exponential backoff, capped at 10s (default: 1)",
    )
    p.add_argument(
        "--advisor-product", choices=("auto", "rhel10", "generic"), default="auto",
        help="product policy context for advisor (default: auto; cs10 selects rhel10)",
    )
    p.add_argument(
        "--advisor-temperature", type=float, default=0.1,
        help="Ollama advisor temperature (default: 0.1)",
    )
    p.add_argument(
        "--advisor-keep-alive", default="10m",
        help="Ollama model keep-alive duration (default: 10m)",
    )
    p.add_argument(
        "--advisor-limit", type=int,
        help="advise only the first N matching missing planner commits (testing aid)",
    )
    p.add_argument(
        "--advisor-commit", action="append",
        help="advise only this actionable planner commit (repeatable; accepts Git revisions)",
    )
    p.add_argument(
        "--advisor-cache",
        help="advisor cache JSON path (default: <output>.advisor-cache.json)",
    )
    p.add_argument(
        "--advisor-error-log",
        help="advisor diagnostic JSONL path (default: <output>.advisor-errors.jsonl)",
    )
    p.add_argument(
        "--advisor-trace", metavar="FILE.jsonl",
        help="capture exact advisor prompts/packets/schemas/raw responses; "
             "requires a new filename and is packaged with run results",
    )
    p.add_argument(
        "--advisor-replay-trace", metavar="FILE.jsonl",
        help="replay exact saved Ollama requests without Git collection; "
             "requires --advisor-model and --benchmark-output",
    )
    p.add_argument(
        "--no-advisor-cache", action="store_true",
        help="disable persistent advisor response caching",
    )
    p.add_argument(
        "--advisor-context-tokens", type=int, default=0,
        help="optional expected Ollama context size; reject responses with prompt "
             "token counts too near this limit (0=disabled)",
    )
    p.add_argument(
        "--advisor-output-reserve", type=int, default=1024,
        help="context token allowance for JSON output (default: 1024)",
    )
    p.add_argument(
        "--advisor-max-request-chars", type=int, default=0,
        help="optional complete advisor request character cap (0=disabled); "
             "48000 is a conservative starting point for a 32K model, NOT a token limit",
    )
    p.add_argument(
        "--advisor-benchmark-plan", metavar="PLAN.json",
        help="benchmark selected commits from a completed JSON plan without full collection",
    )
    p.add_argument(
        "--benchmark-reference-plan", metavar="PLAN.json",
        help="optional second plan; prioritize decisions that disagree with "
             "--advisor-benchmark-plan without repeating full collection",
    )
    p.add_argument(
        "--benchmark-output", metavar="FILE.jsonl",
        help="new JSONL output path for --advisor-benchmark-plan (will not overwrite)",
    )
    p.add_argument("--advisor-max-message-chars", type=int, default=6000)
    p.add_argument("--advisor-max-diff-chars", type=int, default=12000)
    p.add_argument("--advisor-max-peer-diff-chars", type=int, default=6000)
    p.add_argument(
        "--advisor-max-peer-diffs", type=int, default=6,
        help="max missing earlier same-series peer diffs included per candidate (default: 6)",
    )
    p.add_argument(
        "--advisor-required-by-depth", type=int, default=3,
        help="dependency-consumer graph depth included in advisor evidence (default: 3)",
    )
    p.add_argument(
        "--advisor-max-related-commits", type=int, default=8,
        help="max required-by consumer commits included in advisor evidence (default: 8)",
    )
    p.add_argument(
        "--advisor-max-related-diff-chars", type=int, default=5000,
        help="max diff characters per required-by consumer in advisor evidence (default: 5000)",
    )
    p.add_argument("--format", choices=("text", "json"), default="text")
    p.add_argument("--output", help="write primary report to this file instead of stdout")
    p.add_argument(
        "--json-output",
        help="also write a JSON report from the same analysis (independent of --format)",
    )
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--debug", action="store_true")
    args = p.parse_args(argv)
    if args.advisor_fallback_model and not args.advisor_model:
        p.error("--advisor-fallback-model requires --advisor-model")
    if args.advisor_fallback_model == args.advisor_model and args.advisor_model:
        p.error("fallback model must differ from primary advisor model")
    if args.advisor_fallback_limit < 0:
        p.error("--advisor-fallback-limit must be >= 0")
    if args.advisor_fallback_timeout <= 0:
        p.error("--advisor-fallback-timeout must be > 0")
    if args.advisor_fallback_max_request_chars < 0:
        p.error("--advisor-fallback-max-request-chars must be >= 0")
    if args.advisor_fallback_context_tokens <= args.advisor_output_reserve:
        p.error("fallback context must exceed reserved output tokens")
    if args.advisor_max_request_chars < 0:
        p.error("--advisor-max-request-chars must be >= 0")
    if args.advisor_context_tokens < 0 or args.advisor_output_reserve < 0:
        p.error("--advisor-context-tokens and --advisor-output-reserve must be >= 0")
    if args.advisor_context_tokens and (args.advisor_context_tokens <= args.advisor_output_reserve):
        p.error("advisor context must exceed the reserved output tokens")
    if args.advisor_limit is not None and args.advisor_limit < 1:
        p.error("--advisor-limit must be >= 1")
    if args.advisor_replay_trace:
        if not args.advisor_model or not args.benchmark_output:
            p.error("exact replay requires --advisor-model and --benchmark-output")
        if (args.advisor_benchmark_plan or args.benchmark_reference_plan or
                args.advisor_trace or args.update or args.output or args.json_output or
                args.package_results):
            p.error("exact trace replay cannot run with planning or benchmark mode")
        return args
    if args.advisor_benchmark_plan:
        if not args.advisor_model or not args.benchmark_output:
            p.error("benchmark mode requires --advisor-model and --benchmark-output")
        if args.update or args.output or args.json_output or args.package_results:
            p.error("benchmark mode cannot update remotes or generate normal reports")
        return args
    if args.benchmark_output:
        p.error("--benchmark-output requires --advisor-benchmark-plan or --advisor-replay-trace")
    if args.benchmark_reference_plan:
        p.error("--benchmark-reference-plan requires --advisor-benchmark-plan")
    if args.package_results:
        if args.base or args.target or args.output or args.json_output:
            p.error("--package-results is a separate post-run operation")
        return args
    if not args.base or not args.target:
        p.error("--base and --target are required for planning")
    if args.output and args.json_output and Path(args.output).expanduser().resolve() == Path(args.json_output).expanduser().resolve():
        p.error("--json-output and --output must name different files")
    try:
        auto_package_prefix(args)
    except ValueError as exc:
        p.error(str(exc))
    return args


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.advisor_replay_trace:
        return run_exact_trace_replay(args)
    if args.advisor_benchmark_plan:
        return run_advisor_benchmark(args)
    if args.package_results:
        print(f"{Path(sys.argv[0]).name} {VERSION}", file=sys.stderr)
        try:
            directory, archive = package_results(args.package_results)
        except (ValueError, OSError, zipfile.BadZipFile) as exc:
            print(f"backport-plan: cannot package results: {exc}", file=sys.stderr)
            return 1
        print(f"Results directory: {directory}")
        print(f"Results archive: {archive}")
        return 0

    prefix = auto_package_prefix(args)
    if prefix is None:
        print(f"{Path(sys.argv[0]).name} {VERSION}", file=sys.stderr)
        return run_planner(args)

    # Package in the SAME invocation, but only after the internal log closes.
    # Shell-side `tee` cannot be captured safely until its process exits.
    try:
        ensure_package_destinations_available(prefix)
    except ValueError as exc:
        print(f"backport-plan: cannot automatically package results: {exc}",
              file=sys.stderr)
        return 1
    log_path = prefix.with_suffix(".log")
    with log_path.open("x", encoding="utf-8") as log:
        out = TeeOutput(sys.stdout, log)
        err = TeeOutput(sys.stderr, log)
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            started = time.monotonic()
            print(f"{Path(sys.argv[0]).name} {VERSION}", file=sys.stderr)
            rc = run_planner(args)
            print(f"Planner elapsed: {time.monotonic() - started:.1f}s",
                  file=sys.stderr)
            out.flush()
            err.flush()
        log.flush()
        os.fsync(log.fileno())

    try:
        directory, archive = package_results(str(prefix))
    except (ValueError, OSError, zipfile.BadZipFile) as exc:
        print(f"backport-plan: automatic packaging failed: {exc}", file=sys.stderr)
        return 1
    print(f"Results directory: {directory}")
    print(f"Results archive: {archive}")
    return rc


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except GitError as exc:
        print(f"backport-plan: {exc}", file=sys.stderr)
        raise SystemExit(1)
